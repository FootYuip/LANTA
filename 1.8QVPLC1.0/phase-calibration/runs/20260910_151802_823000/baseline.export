        <Single Name="Interface" Type="{a9ed5b7e-75c5-4651-af16-d2c27e98cb94}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">PROGRAM Modbus_Slave
VAR
	modTcpSlaveInit:gcan.FB_ModbusTCP_Slave_Init;	//gcan.FB_ModbusTCP_Slave_Init为Modbus TCP Slave初始化功能块
	modTcpSlaveCtrl:gcan.FB_ModbusTCP_Slave_Ctrl;	//gcan.FB_ModbusTCP_Slave_Init为Modbus TCP Slave执行功能块
	eout: BOOL;										//用于承接功能块中完成标志引脚数据的变量
	iSocket: INT;									//用于存放自身socket
	uiErr: UINT;									//用于承接功能块中报错引脚错误信息的变量
	isInit: BOOL:=FALSE;							//用于初始化执行一次的逻辑变量
	arClient:ARRAY[0..10] OF INT;					//用于存放Client即主站的socket
	
	arDo_data:ARRAY[0..654] OF BOOL;					//用于存放线圈的数据
	arDi_data:ARRAY[0..79] OF BOOL;					//用于存放离散型数据
	//arReg_data:ARRAY[0..10] OF INT;					//用于存放保持型寄存器的数据
	//arAi_data:ARRAY[0..10] OF INT;					//用于存放输入型寄存器的数据
	modbusData	    AT %MW0		: ARRAY[0..654] OF WORD;//用于存放保持型寄存器的数据，接收的数据
	modbusInputRegs	AT %MW660	: ARRAY[0..79] OF WORD;//用于存放输入型寄存器的数据，上报的数据
	
	enCtr:BOOL:=FALSE;								//Modbus TCP Slave执行功能块使能变量

	Remote_time 	 	:LWORD;
	dif:ULINT;//时延
	iCount				:WORD;
	TypeList1 			:DWORD;
	UTC_Union: float2bit;
	CtrlBool: WORD_AS_BIT;
	bCommReset:BOOL;		//错误复位标识符
	iWatchDogTime:INT;
	
	Pos1_Union:float2bit;//远控处理数据结构体
	Pos2_Union:float2bit;
	Pos3_Union:float2bit;
	//轴1远控指令，俯仰
	iMode_1 			:INT;  			//轴1模式远控
	rPosCmd_1 		 	:REAL; 			//轴1位置指令远控
	rVelcmd_1 			:REAL; 			//轴1速度指令远控
	rP_1 				:REAL;    	//轴1P远控
	rI_1 			 	:REAL;      	//轴1I远控
	rD_1				:REAL;     	//轴1D远控
	rThreshold_1 	 	:INT:=1;		//轴1积分阈值远控
	rAcceleration_1  	:REAL;			//最大加速度
	rDeceleration_1  	:REAL;			//最大减速度	
	rVelLim_1	  	 	:REAL;			//最大速度
	
	//轴2远控指令，方位
    iMode_2  		 	:INT; 			//轴2模式远控
	rPosCmd_2 			:REAL; 			//轴2位置指令远控
	rVelcmd_2 			:REAL; 			//轴2速度指令远控
	rP_2 				:REAL;  		//轴2P远控
	rI_2 			 	:REAL;  		//轴2I远控
	rD_2 			 	:REAL;  		//轴2D远控
	rThreshold_2 		:INT;			//轴2积分阈值远控
	rAcceleration_2 	:REAL;			//最大加速度
	rDeceleration_2  	:REAL;			//最大减速度	
	rVelLim_2	  		:REAL;			//最大速度
	//轴3远控指令，方位
    iMode_3  		 	:INT; 			//轴2模式远控
	rPosCmd_3 			:REAL; 			//轴2位置指令远控
	rVelcmd_3 			:REAL; 			//轴2速度指令远控
	rP_3 				:REAL;  		//轴2P远控
	rI_3 			 	:REAL;  		//轴2I远控
	rD_3 			 	:REAL;  		//轴2D远控
	rThreshold_3 		:INT;			//轴2积分阈值远控
	rAcceleration_3 	:REAL;			//最大加速度
	rDeceleration_3  	:REAL;			//最大减速度	
	rVelLim_3	  		:REAL;			//最大速度
	
	//轨道时间结构体
	UTC_Orbit_Union:float2bit;
	UTC_Orbit_New:ULINT;
	UTC_Orbit_Last:ULINT;
	//拉偏变量
	TimeBias_Union:float2bit;
	Bias1_Union:float2bit;
	Bias2_Union:float2bit;
	Bias3_Union:float2bit;
	AcuElOffset:float2bit;
	rTimeBias:LREAL;
	rBias_1:LREAL;
	rBias_2:LREAL;
	rBias_3:LREAL;
	lrElOffset:LREAL;
	UTC_New:ULINT;
	UTC_Last:ULINT;
	aUTC_TIME:ARRAY [1..10] OF ULINT;  //用于三次样条插值的数据
	aPosCmd_1 :ARRAY [1..10] OF LREAL;//用于三次样条插值的数据
	aPosCmd_2 :ARRAY [1..10] OF LREAL;//用于三次样条插值的数据
	isave:INT;
	iCheck:INT;
	bPass:BOOL;//通过大小检测
	iclear:INT;
	
	uPTPTime_Union:float2bit;
	DI1_Union:Util.BIT_AS_WORD;	//上报位置结构体
	DI2_Union:Util.BIT_AS_WORD;
	DO1_Union:Util.BIT_AS_WORD;
	DO2_Union:Util.BIT_AS_WORD;
	DI1_word:WORD;
	DI2_word:WORD;
	DO1_word:WORD;
	DO2_word:WORD;
// 	
	PosSub1_Union:float2bit;
	PosSub2_Union:float2bit;
	PosSub3_Union:float2bit;
	BiasSub1_Union:float2bit;
	BiasSub2_Union:float2bit;
	BiasSub3_Union:float2bit;

	Chan_Union:Util.BIT_AS_WORD;
	Chan_word:WORD;
	
	ptptime:ULINT;
	
	rAzTheory:LREAL;
	rEltheory:LREAL;
	rAzTheory_Union:float2bit;
	rEltheory_Union:float2bit;
	
	
	MillisecondsTime: ULINT;
	
	// for time test
	DeltaTimeBetPC : ULINT;

	AGC_Value: REAL;

	// 方位轨道多项式变量
	starttime : LREAL ;
	rNodeTime1_az : LREAL;
	rNodeTime2_az : LREAL;
	rNodeTime3_az : LREAL;
    rNodeTime4_az : LREAL;
    rNodeTime5_az : LREAL;
	rEndTime : LREAL;
	
	lrFun1_az : ARRAY[0..10] OF LREAL;
    lrFun2_az : ARRAY[0..10] OF LREAL;
    lrFun3_az : ARRAY[0..10] OF LREAL;
    lrFun4_az : ARRAY[0..10] OF LREAL;
	lrFun5_az : ARRAY[0..10] OF LREAL;
    lrFun6_az : ARRAY[0..10] OF LREAL;

    unionFun1_az : ARRAY[0..10] OF UnionLREAL_WORD;
    unionFun2_az : ARRAY[0..10] OF UnionLREAL_WORD;
    unionFun3_az : ARRAY[0..10] OF UnionLREAL_WORD;
    unionFun4_az : ARRAY[0..10] OF UnionLREAL_WORD;
    unionFun5_az : ARRAY[0..10] OF UnionLREAL_WORD;
    unionFun6_az : ARRAY[0..10] OF UnionLREAL_WORD;
	
	unionStartTime: UnionLREAL_WORD;
	
    unionNodeTime1_az : UnionLREAL_WORD;
    unionNodeTime2_az : UnionLREAL_WORD;
    unionNodeTime3_az : UnionLREAL_WORD;
    unionNodeTime4_az : UnionLREAL_WORD;
    unionNodeTime5_az : UnionLREAL_WORD;
    unionEndTime : UnionLREAL_WORD;
	
	// 俯仰轨道多项式变量
	rNodeTime1_el : REAL;
	rNodeTime2_el : REAL;
	rNodeTime3_el : REAL;
    rNodeTime4_el : REAL;
    rNodeTime5_el : REAL;
	lrFun1_el : ARRAY[0..10] OF LREAL;
    lrFun2_el : ARRAY[0..10] OF LREAL;
    lrFun3_el : ARRAY[0..10] OF LREAL;
    lrFun4_el : ARRAY[0..10] OF LREAL;
	lrFun5_el : ARRAY[0..10] OF LREAL;
    lrFun6_el : ARRAY[0..10] OF LREAL;
	unionFun1_el : ARRAY[0..10] OF UnionLREAL_WORD;
	unionFun2_el : ARRAY[0..10] OF UnionLREAL_WORD;
	unionFun3_el : ARRAY[0..10] OF UnionLREAL_WORD;
	unionFun4_el : ARRAY[0..10] OF UnionLREAL_WORD;
	unionFun5_el : ARRAY[0..10] OF UnionLREAL_WORD;
	unionFun6_el : ARRAY[0..10] OF UnionLREAL_WORD;
	unionNodeTime1_el : UnionLREAL_WORD;
	unionNodeTime2_el : UnionLREAL_WORD;
	unionNodeTime3_el : UnionLREAL_WORD;
	unionNodeTime4_el : UnionLREAL_WORD;
	unionNodeTime5_el : UnionLREAL_WORD;
	unionSum:UnionLREAL_WORD;
	lrSum:LREAL;
	lrSumlocal:LREAL;
	i : INT;
	bNotFirst : BOOL; //
	bCheck : BOOL;
	bIFPoly: BOOL;//开启多项式拟合模式的标识，由上位机下发
	iCountPolyGet:INT;//计时接收多项式数组的模块
	uChangeTest:Time2Word;//变量转换测试
	iCountSum:INT;
	bSearch: BOOL;
	bStartTrackAcu : BOOL;
	
	//接收上位机下发位置模式速度
	rAzPosVel : REAL := 8;
	rElPosVel : REAL := 6;
	rTlPosVel : REAL := 8;
END_VAR
</Single>
            <Single Name="LineInfoPersistence" Type="string">b8ad2f70-c1f4-4ca4-b34f-79f47417026d_Decl_LineIds</Single>
          </Single>
        </Single>
        <Single Name="UniqueIdGenerator" Type="string">1415</Single>
        <Single Name="POULevel" Type="{8e575c5b-1d37-49c6-941b-5c0ec7874787}">Standard</Single>
        <List Name="ChildObjectGuids" Type="System.Collections.ArrayList" />
        <Single Name="AddAttributeSubsequent" Type="bool">False</Single>
      </Single>
      <Single Name="ParentSVNodeGuid" Type="System.Guid">49085721-e2f3-443d-be92-6caf07f84b13</Single>
      <Array Name="Path" Type="string">
        <Single Type="string">Device</Single>
        <Single Type="string">PLC逻辑</Single>
        <Single Type="string">Application</Single>
      </Array>
      <Single Name="Index" Type="int">-1</Single>
    </Single>
    <Single Type="{6198ad31-4b98-445c-927f-3258a0e82fe3}" Method="IArchivable">
      <Single Name="IsRoot" Type="bool">False</Single>
      <Single Name="MetaObject" Type="{81297157-7ec9-45ce-845e-84cab2b88ade}" Method="IArchivable">
        <Single Name="Guid" Type="System.Guid">2724b75a-ca36-4465-9d9a-601104553947</Single>
        <Single Name="ParentGuid" Type="System.Guid">49085721-e2f3-443d-be92-6caf07f84b13</Single>
        <Single Name="Name" Type="string">Az_ctrl_1</Single>
        <Dictionary Type="{2c41fa04-1834-41c1-816e-303c7aa2c05b}" Name="Properties" />
        <Single Name="TypeGuid" Type="System.Guid">6f9dac99-8de1-4efc-8465-68ac443b7d08</Single>
        <Array Name="EmbeddedTypeGuids" Type="System.Guid">
          <Single Type="System.Guid">a9ed5b7e-75c5-4651-af16-d2c27e98cb94</Single>
          <Single Type="System.Guid">3b83b776-fb25-43b8-99f2-3c507c9143fc</Single>
        </Array>
        <Single Name="Timestamp" Type="long">639243862865964160</Single>
      </Single>
      <Single Name="Object" Type="{6f9dac99-8de1-4efc-8465-68ac443b7d08}" Method="IArchivable">
        <Single Name="SpecialFunc" Type="{0db3d7bb-cde0-4416-9a7b-ce49a0124323}">None</Single>
        <Single Name="Implementation" Type="{3b83b776-fb25-43b8-99f2-3c507c9143fc}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">a := 2;
IF GVL.Error_code &lt;&gt; 0 THEN
	bVisError := TRUE;
ELSE
	bVisError := FALSE;
END_IF
(*
//远控轴参量赋值
Axis2Remote.iMode:=Modbus_Slave.iMode_2;
Axis2Remote.rVelCmd:=Modbus_Slave.rVelcmd_2;
Axis2Remote.rPosCmd:=Modbus_Slave.rPosCmd_2;
Axis2Remote.rP:=Modbus_Slave.rP_2;
Axis2Remote.rI:=Modbus_Slave.rI_2;
Axis2Remote.rD:=Modbus_Slave.rD_2;
Axis2Remote.rPIDThre:=Modbus_Slave.rThreshold_2;
Axis2Remote.rAcceleration:=Modbus_Slave.rAcceleration_2;
Axis2Remote.rDeceleration:=Modbus_Slave.rDeceleration_2;
Axis2Remote.rVel_Limit:=Modbus_Slave.rVelLim_2;
*)
// 方位状态写入
Axis2Status.Error := GVL.bAzStsBit3;
Axis2Status.ErrorID := GVL.eAzErrorcode;
Axis2Status.bServo_Enable := GVL.bAzStsBit0 AND GVL.bAzStsBit1 AND GVL.bAzStsBit2;
Axis2Status.bBrake := NOT (GVL.bAzStsBit0 AND GVL.bAzStsBit1 AND GVL.bAzStsBit2);
Axis2Status.Disabled := NOT (GVL.bAzStsBit0 AND GVL.bAzStsBit1 AND GVL.bAzStsBit2);
Axis2Remote.rSoft_limit_Negative:=-275;Axis2Remote.rSoft_limit_Postive:=275;
Axis2Local.rSoft_limit_Negative:=-275;Axis2Local.rSoft_limit_Postive:=275;

//速度的写入
rFctVelReal_2:=DINT_TO_REAL(diAzActVel)/524288.0*360.0;
//位置的写入，方位0对应编码器0，所以实际方位是：-1*编码器值
rFctPosReal_2:=DINT_TO_REAL(diAzActPos)/524288.0*360.0;

//软限位控制
Axis2Limit_pos:=275;
Axis2Limit_Neg:=-275;
IF Axis2Remote.rPosCmd&gt;Axis2Limit_pos THEN
	Axis2Remote.rPosCmd:=275;
ELSIF Axis2Remote.rPosCmd&lt;Axis2Limit_Neg THEN
	 Axis2Remote.rPosCmd:=-275;  
END_IF

IF Axis2Local.rPosCmd&gt;Axis2Limit_pos THEN
	Axis2Local.rPosCmd:=275;
ELSIF Axis2Local.rPosCmd&lt;Axis2Limit_Neg THEN
	 Axis2Local.rPosCmd:=-275;  
END_IF

//停止标志符号判断
IF  ABS(rFctVelReal_2)&lt;0.035 THEN
	Stop2_Count:=Stop2_Count+1;
	IF Stop2_Count&gt;100 THEN
		Stop2_Count:=101;
		bStop_2:=TRUE;;
	END_IF
ELSE
	Stop2_Count:=0;
	bStop_2:=FALSE;
END_IF
Axis2Status.Moving := NOT bStop_2;
//PID使能赋值
IF Axis2Remote.iMode=2 OR Axis2Remote.iMode=4 THEN
	Axis2Remote.bPIDEnable:=TRUE;
ELSE
	Axis2Remote.bPIDEnable:=FALSE;
END_IF

//本远控逻辑保护
//远控切本控逻辑保护
bRTriger(CLK:=GVL.bLocalCtrl);
bFTriger(CLK:=GVL.bLocalCtrl);

IF Axis2Status.bServo_Enable AND (bRTriger.Q ) THEN//如果速度不为0且本控发生切换，则减速停止标识为True
	bRemote2LocalStop:=TRUE;
END_IF
IF bRemote2LocalStop  THEN //若减速停止标识符为True 
	
	IF  bStop_2=TRUE THEN//且电机速度不为0 开始减速 减速完成后下使能，下使能完成后复位标识符复位
		Axis2Local.iMode:=0;
		Axis2Remote.iMode:=0;
		IF Axis2Status.bServo_Enable=FALSE THEN
			bRemote2LocalStop:=FALSE;
		END_IF
	ELSE
		Axis2Local.iMode:=7;
		Axis2Remote.iMode:=7;
	END_IF
END_IF

//本控切远控
IF Axis2Status.bServo_Enable AND (bFTriger.Q ) THEN//如果速度不为0且本控发生切换，则减速停止标识为True
	bLocal2RemoteStop:=TRUE;
END_IF
IF bLocal2RemoteStop  THEN //若减速停止标识符为True 
	
	IF  bStop_2=TRUE THEN//且电机速度不为0 开始减速 减速完成后下使能，下使能完成后复位标识符复位
		Axis2Local.iMode:=0;
		Axis2Remote.iMode:=0;
		IF Axis2Status.bServo_Enable=FALSE THEN
			bLocal2RemoteStop:=FALSE;
		END_IF
	ELSE
		Axis2Remote.iMode:=7;
		Axis2Local.iMode:=7;
	END_IF
END_IF

IF Axis2Remote.iMode=2 THEN
			bstartagcmaxsearch:=Modbus_slave.bSearch;
			IF GVL.Chan1AGC&gt;=(GVL.Chanthreshold-0.1) THEN
					agcmaxsearch_tb(bstart:=bstartagcmaxsearch,rAGCNow:=GVL.Chan1AGC,btrig:=bstartSearchAz,
				rinterPos:=Axis2Remote.rPosCmd,rcurrentpos:=GVL.rFctPosReal_2,
				//rOutStepBias:=0,
				rStepBiasNow:=0,bAutoTracking:=GVL.bStartTrack,bStop:=FALSE,
				rStepBias=&gt;rSearchNextStepTarget_tb,rAGCMaxBias=&gt;rMaxPosTest,bSucess=&gt;);
			ELSE
				bstartagcmaxsearch:=FALSE;
				agcmaxsearch_tb(bstart:=bstartagcmaxsearch,rAGCNow:=GVL.Chan1AGC,btrig:=bstartSearchAz,
				rinterPos:=Axis2Remote.rPosCmd,rcurrentpos:=GVL.rFctPosReal_2,
				//rOutStepBias:=0,
				rStepBiasNow:=0,bAutoTracking:=GVL.bStartTrack,bStop:=FALSE,
				rStepBias=&gt;rSearchNextStepTarget_tb,rAGCMaxBias=&gt;rMaxPosTest,bSucess=&gt;);
			END_IF
			//把rSearchNextStepTarget附加到rPosCmd上
		ELSIF Axis2Remote.iMode=4 AND (GVL.rFctPosReal_1 - 90)&gt;rElthreshold  THEN
			bstartagcmaxsearch:=Modbus_slave.bSearch;
			IF GVL.Chan1AGC&gt;=(GVL.Chanthreshold-0.1) THEN
					agcmaxsearch_pb(bstart:=bstartagcmaxsearch,rAGCNow:=GVL.Chan1AGC,btrig:=bstartSearchAz,
				rinterPos:=RealTimeposcal.rInterAzPos,rcurrentpos:=GVL.rFctPosReal_2,
				//rOutStepBias:=rStepBias,
				rStepBiasNow:=rStepBias,bAutoTracking:=GVL.bStartTrack,bStop:=FALSE,
				rStepBias=&gt;rSearchNextStepTarget,rAGCMaxBias=&gt;rMaxPosTest,bSucess=&gt;);
			ELSE
				bstartagcmaxsearch:=FALSE;
				agcmaxsearch_pb(bstart:=bstartagcmaxsearch,rAGCNow:=GVL.Chan1AGC,btrig:=bstartSearchAz,
				rinterPos:=RealTimeposcal.rInterAzPos,rcurrentpos:=GVL.rFctPosReal_2,
				//rOutStepBias:=rStepBias,
				rStepBiasNow:=rStepBias,bAutoTracking:=GVL.bStartTrack,bStop:=FALSE,
				rStepBias=&gt;rSearchNextStepTarget,rAGCMaxBias=&gt;rMaxPosTest,bSucess=&gt;);
			END_IF
			//把rSearchNextStepTarget附加到Axis2Remote.rPIDCmdPos上
		ELSIF Axis2Remote.iMode =0  OR Axis2Remote.iMode =7 THEN
			bstartagcmaxsearch:=FALSE;
			iCountSearch:=0;
			//rSearchNextStepTarget:=0;
			agcmaxsearch_pb(bstart:=bstartagcmaxsearch,rAGCNow:=GVL.Chan1AGC,btrig:=bstartSearchAz,
			rinterPos:=RealTimeposcal.rInterAzPos,rcurrentpos:=GVL.rFctPosReal_2,
			//rOutStepBias:=rStepBias,
			rStepBiasNow:=rStepBias,bAutoTracking:=GVL.bStartTrack,bStop:=FALSE,
			rStepBias=&gt;rSearchNextStepTarget,rAGCMaxBias=&gt;rMaxPosTest,bSucess=&gt;);
		END_IF
		
(*
//自跟踪
IF GVL.bStartTrack THEN
	Axis2Remote.bStartAutoTrack := TRUE;
	Axis2Remote.rChanU := -AutoTrackingCal.rChanUa;
ELSE
	Axis2Remote.bStartAutoTrack := FALSE;	
	Axis2Remote.rChanU := 0;
END_IF
*)
// 程引模式下自跟踪拉偏
IF GVL.bStartTrack AND Axis2Remote.iMode=4 THEN
	Axis2Remote.bStartAutoTrack := TRUE;
	IF rAuToStepBias &gt; rAutoTrackingBiasMax THEN
		rAuToStepBias := rAutoTrackingBiasMax;
	ELSIF rAuToStepBias &lt; -rAutoTrackingBiasMax THEN
		rAuToStepBias := -rAutoTrackingBiasMax;
	ELSE
		rAuToStepBiasTemp:=(-0.04)*AutoTrackingCal.rDirSenFac*AutoTrackingCal.rChanUa;
		rAuToStepBias:=rAuToStepBias-AutoTrackingCal.rDirSenFac*rKAuToStepBias*AutoTrackingCal.rChanUa/1000.0;
	END_IF
ELSIF NOT GVL.bStartTrack AND Axis2Remote.iMode=4 THEN
	IF 	rAuToStepBias&gt;0 THEN//关闭自跟踪后自跟踪拉偏量逐渐归0
		rAuToStepBias:=rAuToStepBias-rAutoStep;
	ELSIF rAuToStepBias&lt;0 THEN
		rAuToStepBias:=rAuToStepBias+rAutoStep;
	ELSE
		rAuToStepBias:=0;
	END_IF
	
	IF Modbus_Slave.rBias_2&gt;rStepBias THEN
		rStepBias:=rStepBias+rStep;
		IF rStepBias&gt;=Modbus_Slave.rBias_2 THEN
			rStepBias:=Modbus_Slave.rBias_2;
		END_IF
	ELSIF Modbus_Slave.rBias_2&lt;rStepBias THEN
		rStepBias:=rStepBias-rStep;
		IF rStepBias&lt;=Modbus_Slave.rBias_2 THEN
			rStepBias:=Modbus_Slave.rBias_2;
		END_IF
	END_IF
	rAuToStepBiasTemp:=0;
ELSIF GVL.bStartTrack AND Axis2Remote.iMode=2 THEN
	Axis2Remote.bStartAutoTrack := TRUE;
	Axis2Remote.rChanU := -AutoTrackingCal.rChanUa;
ELSE
	Axis2Remote.bStartAutoTrack := FALSE;	
	rAuToStepBias:=0;
	rStepBias:=0;
	rAuToStepBiasTemp:=0;
END_IF

//本控自跟踪
IF GVL.bStartLocalAutoTrack AND Axis2Local.iMode = 4 THEN
	Axis2Local.bStartAutoTrack := TRUE;
	Axis2Local.rChanU := -AutoTrackingCal.rChanUaLocal;
ELSE
	Axis2Local.bStartAutoTrack := FALSE;
END_IF
//拉偏
Axis2Remote.rPIDCmdPos:=RealTimePosCal.rInterAzPos+rStepBias+rAuToStepBias+rSearchNextStepTarget-SECURITYCHECK.AZ_out+rAuToStepBiasTemp;

//限位
IF Axis2Remote.rPIDCmdPos&lt;-275 THEN
	Axis2Remote.rPIDCmdPos:=-275;
ELSIF Axis2Remote.rPIDCmdPos&gt;275 THEN
	Axis2Remote.rPIDCmdPos:=275;
END_IF

Axis2_Ctrl(sLocal:=Axis2Local, sCtrl:=Axis2Remote, sStatus:=Axis2Status, sVisible:=Axis2Visible, rRealPos:=rFctPosReal_2, rPosLimK:=0.34);
	
</Single>
            <Single Name="LineInfoPersistence" Type="string">2724b75a-ca36-4465-9d9a-601104553947_Impl_LineIds</Single>
          </Single>
        </Single>
        <Single Name="Interface" Type="{a9ed5b7e-75c5-4651-af16-d2c27e98cb94}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">PROGRAM Az_ctrl_1
VAR
    Axis2_Ctrl : Az_Ctrl_FB;
    bRemote2LocalStop : BOOL;
    bLocal2RemoteStop : BOOL;
    Error : INT;
    Axis2Limit_pos : REAL;
    Axis2Limit_Neg : REAL;
    bRTriger : Standard.R_TRIG;
    bFTriger : Standard.F_TRIG;
    Stop2_Count : INT;
    bStop_2 : BOOL;
    rPosModeStepBias : LREAL;
    rPosModeStep : LREAL := 0.005;
    rStepBiasMax : LREAL := 2;
    rStepBias : LREAL;
    rStep : LREAL := 0.002;
    rAuToStepBias : LREAL;
    rAuToStepBiasTemp : LREAL;
    rAutoStep : LREAL := 0.005;
    TbAutoTrigger : Standard.F_TRIG;
    RbAutoTrigger : Standard.R_TRIG;
    rAutoTrackingBiasMax : LREAL := 15;
    rLocalInitPosModeSpeed : REAL;
    rRemoteInitPosModeSpeed : REAL;
    iCountOffAuto : INT;
    iCasePBAutoTrack : INT := 2;
    rKAuToStepBias : LREAL := 0.6; // 对齐2.4
    bVisError : BOOL;
    a : INT;
    agcmaxsearch_tb : agcmaxsearch_pb_1;
    rSearchNextStepTarget_tb : REAL;
    agcmaxsearch_pb : agcmaxsearch_pb_1;
    rElthreshold : REAL := 4.2;
    toN1 : Standard.Ton;
    ttime1 : TIME := T#200mS;
    bstartagcmaxsearch : BOOL;
    rSearchNextStepTarget : REAL;
    rMaxPosTest : REAL;
    iCountSearch : UINT;
    iCountn : UINT;
    bstartSearchAz : BOOL;
    bstartSearchEl : BOOL;
    iCircly : INT := 400;
    rAZSearchThr : REAL := 0.3;
    rElSearchThr : REAL := 0.3;
END_VAR</Single>
            <Single Name="LineInfoPersistence" Type="string">2724b75a-ca36-4465-9d9a-601104553947_Decl_LineIds</Single>
          </Single>
        </Single>
        <Single Name="UniqueIdGenerator" Type="string">615</Single>
        <Single Name="POULevel" Type="{8e575c5b-1d37-49c6-941b-5c0ec7874787}">Standard</Single>
        <List Name="ChildObjectGuids" Type="System.Collections.ArrayList" />
        <Single Name="AddAttributeSubsequent" Type="bool">False</Single>
      </Single>
      <Single Name="ParentSVNodeGuid" Type="System.Guid">49085721-e2f3-443d-be92-6caf07f84b13</Single>
      <Array Name="Path" Type="string">
        <Single Type="string">Device</Single>
        <Single Type="string">PLC逻辑</Single>
        <Single Type="string">Application</Single>
      </Array>
      <Single Name="Index" Type="int">-1</Single>
    </Single>
    <Single Type="{6198ad31-4b98-445c-927f-3258a0e82fe3}" Method="IArchivable">
      <Single Name="IsRoot" Type="bool">False</Single>
      <Single Name="MetaObject" Type="{81297157-7ec9-45ce-845e-84cab2b88ade}" Method="IArchivable">
        <Single Name="Guid" Type="System.Guid">0cb0be60-638d-4066-bce3-f581bbf54550</Single>
        <Single Name="ParentGuid" Type="System.Guid">49085721-e2f3-443d-be92-6caf07f84b13</Single>
        <Single Name="Name" Type="string">Az_Ctrl_FB</Single>
        <Dictionary Type="{2c41fa04-1834-41c1-816e-303c7aa2c05b}" Name="Properties" />
        <Single Name="TypeGuid" Type="System.Guid">6f9dac99-8de1-4efc-8465-68ac443b7d08</Single>
        <Array Name="EmbeddedTypeGuids" Type="System.Guid">
          <Single Type="System.Guid">a9ed5b7e-75c5-4651-af16-d2c27e98cb94</Single>
          <Single Type="System.Guid">3b83b776-fb25-43b8-99f2-3c507c9143fc</Single>
        </Array>
        <Single Name="Timestamp" Type="long">639102996005732311</Single>
      </Single>
      <Single Name="Object" Type="{6f9dac99-8de1-4efc-8465-68ac443b7d08}" Method="IArchivable">
        <Single Name="SpecialFunc" Type="{0db3d7bb-cde0-4416-9a7b-ce49a0124323}">None</Single>
        <Single Name="Implementation" Type="{3b83b776-fb25-43b8-99f2-3c507c9143fc}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">// 下电时复位控制字bit8
IF sStatus.Disabled OR(NOT sStatus.Moving)THEN
	bAzCtrlBit8 := FALSE;
END_IF

//	错误复位功能
IF GVL.bError_Reset THEN
	sCtrl.iMode:=6;
	sLocal.iMode:=6;
	GVL.Error_code:=0;
END_IF
IF GVL.Error_code =0 THEN
	GVL.bError_Reset:=FALSE;
END_IF

/////////心跳报错清除/////////
IF GVL.eAzErrorcode = 16#8130 AND NOT tr THEN
	GVL.bAzCtrlBit7 := TRUE;
	tr:=TRUE;
	istate:=0;
	icount:=0;
	// 写入下电控制字
	GVL.bAzCtrlBit3 := FALSE;
	GVL.bAzCtrlBit0 := FALSE;
	GVL.bAzCtrlBit1 := FALSE;
	GVL.bAzCtrlBit2 := FALSE;
END_IF
IF tr THEN
	icount1 := icount1 + 1;
END_IF
IF icount1 &gt; 101 THEN
	icount1 := 0;
	tr := FALSE;
	GVL.bAzCtrlBit7 := FALSE;
	bfin1 := TRUE;
END_IF
IF bfin1 THEN
	icount2 := icount2 + 1;
END_IF
IF icount2 &gt; 101 THEN
	bfin1 := FALSE;
	icount2 := 0;
END_IF
/////////////////////////////

IF GVL.Error_code=0 AND GVL.eAzErrorcode = 0 AND NOT GVL.bAzCtrlBit7  AND NOT tr AND NOT bfin1 AND NOT bfin2 THEN
	IF GVL.bLocalCtrl=FALSE THEN //远控
		IF sCtrl.iMode &lt;&gt; 1 THEN
			istate:=0;
			icount:=0;
		END_IF
		CASE sCtrl.iMode OF
			MODES.powerOff: // 下电
				IF NOT sStatus.Disabled THEN
					IF sStatus.Moving THEN // 运动中，先停止运动
						GVL.diAzTargetVel := 0;
						bAzCtrlBit8 := TRUE;
					ELSE
						// 写入下电控制字
						GVL.bAzCtrlBit3 := FALSE;
						GVL.bAzCtrlBit0 := FALSE;
						GVL.bAzCtrlBit1 := FALSE;
						GVL.bAzCtrlBit2 := FALSE;
					END_IF
				END_IF
				
				vpid1(rKpbase:=1, rKibase:=0.01, rKpMax:=1, rKiMax:=0.01, rVelThreshold:=10,rTarget:=sCtrl.rPIDCmdPos,rFeedback:=rRealPos,rPosLimPositive:=sCtrl.rSoft_limit_Postive,
							rPosLimNegitive:=sCtrl.rSoft_limit_Negative,
								bPIDEnable:=sCtrl.bPIDEnable,rVelLim:=sCtrl.rVel_Limit,rKpScale:=0.02,rKiScale:=0.005,rElPos:=GVL.rFctPosReal_1-90,
								iThrehold:=sCtrl.rPIDThre,rPIDOutDir=&gt;sCtrl.rPIDCmdVel);
			MODES.powerOn:  // 上电
				IF sStatus.Disabled THEN
					// 目标速度清零
					GVL.diAzTargetVel := 0;
					IF GVL.siAzMode &lt;&gt; 3 THEN // 上电时模式默认为3，速度模式
						GVL.siAzMode := 3;
					END_IF
					IF siAzMode = 3 THEN
						CASE istate OF
							0:
								GVL.bAzCtrlBit1 := TRUE;
								GVL.bAzCtrlBit2 := TRUE;
								icount := icount + 1;
								IF icount = 20 THEN
									icount:=0;
									istate:=1;
								END_IF
							1:
								GVL.bAzCtrlBit0 := TRUE;
								icount := icount + 1;
								IF icount = 20 THEN
									icount:=0;
									istate:=2;
								END_IF
							2:
								GVL.bAzCtrlBit3 := TRUE;
						END_CASE
					END_IF
				ELSE
					IF sStatus.Moving THEN
						GVL.diAzTargetVel := 0;
						bAzCtrlBit8 := TRUE;
					ELSE
						bAzCtrlBit8 := FALSE;
					END_IF
				END_IF
			MODES.positionMode: // 远控指向模式
				IF NOT sStatus.Disabled THEN
					IF sCtrl.bStartAutoTrack THEN
						//自跟踪模式下，由误差电压直接驱动
						VelPID_1(rTarget:=sCtrl.rChanU + rRealPos,
								rFeedback:=rRealPos,
								rPosLimPositive:=sCtrl.rSoft_limit_Postive,
								rPosLimNegative:=sCtrl.rSoft_limit_Negative,
								rVelLim:=sCtrl.rVel_Limit,
								rKp:=1,//自跟踪PI系数3,0.02
								rKi:=0,
								rKd:=0,
								bPIDEnable:=sCtrl.bPIDEnable,
								iThreshold:= -1,
								rPIDOutput=&gt;sCtrl.rPIDCmdVel);							
					ELSE
						//PID计算速度指令
						VelPID_1(rTarget:=sCtrl.rPosCmd,
							rFeedback:=rRealPos,
							rVelLim:=sCtrl.Pos_Vel,
							rPosLimPositive:=sCtrl.rSoft_limit_Postive,
							rPosLimNegative:=sCtrl.rSoft_limit_Negative,
							rKp:=0.6,//程引PI系数低带：1,0.002  高带：3,0.02
							rKi:=0,
							rKd:=0,
							bPIDEnable:=sCtrl.bPIDEnable,
							iThreshold:=sCtrl.rPIDThre,
							rPIDOutput=&gt;sCtrl.rPIDCmdVel);
					END_IF
					GVL.diAzTargetVel := REAL_TO_DINT(sCtrl.rPIDCmdVel * 524288 / 360);
					GVL.diAzTargetAcc := REAL_TO_UDINT(12 * 524288 / 360);   //加速度
					GVL.diAzTargetDec := REAL_TO_UDINT(12 * 524288 / 360);   //减速度
				END_IF
			MODES.velocityMode://手控速度模式-远控模式
				IF NOT sStatus.Disabled THEN
					IF ABS(sCtrl.rVelCmd) &lt;= sCtrl.rVel_Limit THEN
						GVL.diAzTargetVel := REAL_TO_DINT(sCtrl.rVelCmd * 524288 / 360);
					ELSIF sCtrl.rVelCmd &gt; sCtrl.rVel_Limit THEN
						GVL.diAzTargetVel := REAL_TO_DINT(sCtrl.rVel_Limit * 524288 / 360);
					ELSE
						GVL.diAzTargetVel := REAL_TO_DINT(-sCtrl.rVel_Limit * 524288 / 360);
					END_IF
					GVL.diAzTargetAcc := REAL_TO_UDINT(sCtrl.rAcceleration * 524288 / 360);   //加速度
					GVL.diAzTargetDec := REAL_TO_UDINT(sCtrl.rDeceleration * 524288 / 360);   //减速度
				END_IF
			MODES.programBootMode://PID速度模式-正常模式 程引
				IF NOT sStatus.Disabled THEN
					IF sCtrl.bStartAutoTrack THEN
						(*
						//自跟踪模式下，由误差电压直接驱动
						VelPID_3(rTarget:=sCtrl.rChanU + rRealPos,
								rFeedback:=rRealPos,
								rPosLimPositive:=sCtrl.rSoft_limit_Postive,
								rPosLimNegative:=sCtrl.rSoft_limit_Negative,
								rVelLim:=sCtrl.rVel_Limit,
								rKp:=sCtrl.rP_AutoTrack,//自跟踪PI系数3,0.02
								rKi:=sCtrl.rI_AutoTrack,
								rKd:=sCtrl.rD,
								bPIDEnable:=sCtrl.bPIDEnable,
								iThreshold:= -1,
								rPIDOutput=&gt;sCtrl.rPIDCmdVel);
								*)
						vpid1(rKpbase:=Persistentvars.rAzKpBase, rKibase:=Persistentvars.rAzKiBase, rKpMax:=Persistentvars.rAzKpMax, rKiMax:=Persistentvars.rAzKiMax, rVelThreshold:=Persistentvars.rAzThre,rTarget:=sCtrl.rPIDCmdPos,rFeedback:=rRealPos,rPosLimPositive:=sCtrl.rSoft_limit_Postive,
							rPosLimNegitive:=sCtrl.rSoft_limit_Negative,
								bPIDEnable:=sCtrl.bPIDEnable,rVelLim:=sCtrl.rVel_Limit,rKpScale:=Persistentvars.rAzKpscale,rKiScale:=Persistentvars.rAzKiscale,rElPos:=GVL.rFctPosReal_1-90,
								iThrehold:=sCtrl.rPIDThre,rPIDOutDir=&gt;sCtrl.rPIDCmdVel);							
					ELSE
						//PID计算速度指令
						(*
						VelPID_3(rTarget:=sCtrl.rPIDCmdPos,
							rFeedback:=rRealPos,
							rVelLim:=sCtrl.rVel_Limit,
							rPosLimPositive:=sCtrl.rSoft_limit_Postive,
							rPosLimNegative:=sCtrl.rSoft_limit_Negative,
							rKp:=sCtrl.rP,//程引PI系数地带：1,0.002  高带：3,0.02
							rKi:=sCtrl.rI,
							rKd:=sCtrl.rD,
							bPIDEnable:=sCtrl.bPIDEnable,
							iThreshold:=sCtrl.rPIDThre,
							rPIDOutput=&gt;);
							*)
						vpid1(rKpbase:=Persistentvars.rAzKpBase, rKibase:=Persistentvars.rAzKiBase, rKpMax:=Persistentvars.rAzKpMax, rKiMax:=Persistentvars.rAzKiMax, rVelThreshold:=Persistentvars.rAzThre,rTarget:=sCtrl.rPIDCmdPos,rFeedback:=rRealPos,rPosLimPositive:=sCtrl.rSoft_limit_Postive,
							rPosLimNegitive:=sCtrl.rSoft_limit_Negative,
								bPIDEnable:=sCtrl.bPIDEnable,rVelLim:=sCtrl.rVel_Limit,rKpScale:=Persistentvars.rAzKpscale,rKiScale:=Persistentvars.rAzKiscale,rElPos:=GVL.rFctPosReal_1-90,
								iThrehold:=sCtrl.rPIDThre,rPIDOutDir=&gt;sCtrl.rPIDCmdVel);
						
					END_IF
					GVL.diAzTargetVel := REAL_TO_DINT(sCtrl.rPIDCmdVel * 524288 / 360);
					GVL.diAzTargetAcc := REAL_TO_UDINT(sCtrl.rAcceleration * 524288 / 360);   //加速度
					GVL.diAzTargetDec := REAL_TO_UDINT(sCtrl.rDeceleration * 524288 / 360);   //减速度
				END_IF
			MODES.reset://重置
				IF NOT sStatus.Disabled THEN
					IF sStatus.Moving THEN
						GVL.diAzTargetVel := 0;
						bAzCtrlBit8 := TRUE;
					ELSE
						bAzCtrlBit8 := FALSE;
					END_IF
				END_IF
			MODES.halt://待机
				IF NOT sStatus.Disabled THEN
					IF sStatus.Moving THEN
						GVL.diAzTargetVel := 0;
						bAzCtrlBit8 := TRUE;
					ELSE
						bAzCtrlBit8 := FALSE;
					END_IF
				END_IF
			
		END_CASE
	ELSE // 本控
		IF sLocal.iMode &lt;&gt; 1 THEN
			istate:=0;
			icount:=0;
		END_IF
		CASE sLocal.iMode OF
			MODES.powerOff: // 下电
				IF NOT sStatus.Disabled THEN
					IF sStatus.Moving THEN // 运动中，先停止运动
						GVL.diAzTargetVel := 0;
						bAzCtrlBit8 := TRUE;
					ELSE
						// 写入下电控制字
						GVL.bAzCtrlBit3 := FALSE;
						GVL.bAzCtrlBit0 := FALSE;
						GVL.bAzCtrlBit1 := FALSE;
						GVL.bAzCtrlBit2 := FALSE;
					END_IF
				END_IF
			MODES.powerOn:  // 上电
				IF sStatus.Disabled THEN
					// 目标速度清零
					GVL.diAzTargetVel := 0;
					IF GVL.siAzMode &lt;&gt; 3 THEN // 上电时模式默认为3，速度模式
						GVL.siAzMode := 3;
					END_IF
					IF siAzMode = 3 THEN
						CASE istate OF
							0:
								GVL.bAzCtrlBit1 := TRUE;
								GVL.bAzCtrlBit2 := TRUE;
								icount := icount + 1;
								IF icount = 20 THEN
									icount:=0;
									istate:=1;
								END_IF
							1:
								GVL.bAzCtrlBit0 := TRUE;
								icount := icount + 1;
								IF icount = 20 THEN
									icount:=0;
									istate:=2;
								END_IF
							2:
								GVL.bAzCtrlBit3 := TRUE;
						END_CASE
					END_IF
				ELSE
					IF sStatus.Moving THEN
						GVL.diAzTargetVel := 0;
						bAzCtrlBit8 := TRUE;
					ELSE
						bAzCtrlBit8 := FALSE;
					END_IF
				END_IF
			MODES.velocityMode://手控速度模式-本控模式
				IF NOT sStatus.Disabled THEN
					IF ABS(sLocal.rVelCmd) &lt;= sLocal.rVel_Limit THEN
						GVL.diAzTargetVel := REAL_TO_DINT(sLocal.rVelCmd * 524288 / 360);
					ELSIF sLocal.rVelCmd &gt; sLocal.rVel_Limit THEN
						GVL.diAzTargetVel := REAL_TO_DINT(sLocal.rVel_Limit * 524288 / 360);
					ELSE
						GVL.diAzTargetVel := REAL_TO_DINT(-sLocal.rVel_Limit * 524288 / 360);
					END_IF
					GVL.diAzTargetAcc := REAL_TO_UDINT(sLocal.rAcceleration * 524288 / 360);   //加速度
					GVL.diAzTargetDec := REAL_TO_UDINT(sLocal.rDeceleration * 524288 / 360);   //减速度
				END_IF
			MODES.programBootMode://本控位置模式
				IF NOT sStatus.Disabled THEN
					IF NOT sLocal.bPIDEnable THEN
						GVL.diAzTargetVel := 0;							
					ELSE
						IF NOT slocal.bStartAutoTrack THEN
							//PID计算速度指令
							 VelPID_2(rTarget:=sLocal.rPosCmd,
									 rFeedback:=rRealPos,
									 rPosLimPositive:=sLocal.rSoft_limit_Postive,//软限位
									 rPosLimNegative:=sLocal.rSoft_limit_Negative,
									 rKp:=0.6,
									 rKi:=0,
									 rKd:=0,
									 iThreshold:=sLocal.rPIDThre,
									 bPIDEnable:=sLocal.bPIDEnable,
									 rVelLim:=sLocal.Pos_Vel,
									 rPIDOutput=&gt;sLocal.rPIDCmdVel);//普通PID
						ELSE
							//PID计算速度指令
							 VelPID_2(rTarget:=sLocal.rChanU + rRealPos,
								rFeedback:=rRealPos,
								rPosLimPositive:=sLocal.rSoft_limit_Postive,
								rPosLimNegative:=sLocal.rSoft_limit_Negative,
								rVelLim:=sLocal.rVel_Limit,
								rKp:=1,//自跟踪PI系数3,0.02
								rKi:=0,
								rKd:=0,
								bPIDEnable:=sLocal.bPIDEnable,
								iThreshold:= -1,
								rPIDOutput=&gt;sLocal.rPIDCmdVel);//普通PID
						END_IF
						
					END_IF
					GVL.diAzTargetVel := REAL_TO_DINT(sLocal.rPIDCmdVel * 524288 / 360);
					GVL.diAzTargetAcc := REAL_TO_UDINT(12 * 524288 / 360);   //加速度
					GVL.diAzTargetDec := REAL_TO_UDINT(12 * 524288 / 360);   //减速度
				END_IF
			MODES.reset://重置
			// 是否需要
			MODES.halt://待机
				IF NOT sStatus.Disabled THEN
					IF sStatus.Moving THEN
						GVL.diAzTargetVel := 0;
						bAzCtrlBit8 := TRUE;
					ELSE
						bAzCtrlBit8 := FALSE;
					END_IF
				END_IF
			
		END_CASE
	END_IF
ELSIF GVL.Error_code&lt;&gt;0 AND GVL.eAzErrorcode = 0 AND NOT GVL.bAzCtrlBit7  AND NOT tr AND NOT bfin1 AND NOT bfin2 THEN
	// 出现错误，轴停止运动
	GVL.diAzTargetVel := 0;
	bAzCtrlBit8 := TRUE;
	TON_0(IN:=bAzCtrlBit8,PT:=T#1S,Q=&gt;,ET=&gt;);//判断stop0执行是否超时,若超时强制下电（手动复位）
	IF TON_0.Q THEN
		bTick:=TRUE;
	END_IF
	IF bTick AND sStatus.Moving THEN // 超时强制下电
		// 写入下电控制字
		GVL.bAzCtrlBit3 := FALSE;
		GVL.bAzCtrlBit0 := FALSE;
		GVL.bAzCtrlBit1 := FALSE;
		GVL.bAzCtrlBit2 := FALSE;
	END_IF
END_IF</Single>
            <Single Name="LineInfoPersistence" Type="string">0cb0be60-638d-4066-bce3-f581bbf54550_Impl_LineIds</Single>
          </Single>
        </Single>
        <Single Name="Interface" Type="{a9ed5b7e-75c5-4651-af16-d2c27e98cb94}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">FUNCTION_BLOCK Az_Ctrl_FB
VAR_INPUT
	sLocal:AxisCrtlStruct;
	sCtrl:AxisCrtlStruct;
	sStatus:AxisStatus;
	sVisible:AxisVisible;
	rRealPos:REAL;
	rPosLimK:REAL;
END_VAR
VAR_OUTPUT
	logicError:INT;
END_VAR
VAR
	VelPID_1:PID;
	VelPID_2:PID;
	VelPID_3:PID;
	vpid1:vpid;
	TON_0:TON;
	bTick:BOOL;
	tr:BOOL;
	icount1:INT := 0;
	icount2:INT := 0;
	icount3:INT := 0;
	bfin1:BOOL;
	bfin2:BOOL;
	istate:INT:=0;
	icount:INT:=0;
END_VAR
</Single>
            <Single Name="LineInfoPersistence" Type="string">0cb0be60-638d-4066-bce3-f581bbf54550_Decl_LineIds</Single>
          </Single>
