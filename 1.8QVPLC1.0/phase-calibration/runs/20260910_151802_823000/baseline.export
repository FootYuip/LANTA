          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">IF NOT enable THEN
    state := 0;
    azimuth := 0.0;
    elevation := 0.0;
    done := FALSE;
	lock_count := 0;
	icount0 := 0;
	segment_progress := 0.0;
	bInit := FALSE;
	best_agc := 0.0;
    best_az := 0.0;
    best_el := 0.0;
	icountInit := 0;
	iCountSearch := 0;
	bType := FALSE;
ELSE
    CASE state OF
        0:
			IF bTrackState THEN
				azimuth := 0.0;
				elevation := 0.0;
				done := TRUE;
				state := 3;
			ELSE
				state := 1;
				lock_count := 0;
			END_IF
        1:
            IF bTrackState THEN
				azimuth := 0.0;
				elevation := 0.0;
				done := TRUE;
				state := 3;
			ELSIF NOT bInit THEN
					x := 0.0; y := 0.0;
					dx := 1.0; dy := 0.0;
					step_len := 1.0;
					step_count := 0.0;
					move_count := 1.0;
					side_repeat := 0.0;
					az0 := 0.0; el0 := 0.0;
					az1 := delta * x;
					el1 := delta * y;
					segment_progress := 0.0;
					bInit := TRUE;
					iSearchMax := TO_INT(delta / n_steps);
					IF ABS(delta) &lt; 1E-5 THEN
						rTemp := 0;
					ELSE
						rTemp := delta1 / delta;
					END_IF
			ELSE
					iCountSearch := iCountSearch + 1;
					IF iCountSearch &lt;= iSearchMax THEN
						azimuth := n_steps * iCountSearch;
						elevation := n_steps * iCountSearch * rTemp;
					ELSIF iCountSearch &lt;= 2 * iSearchMax THEN
						azimuth := delta - n_steps * (iCountSearch - iSearchMax);
						elevation := (delta - n_steps * (iCountSearch - iSearchMax)) * rTemp;
					ELSIF iCountSearch &lt;= 3 * iSearchMax THEN
						azimuth := -1*n_steps * (iCountSearch - 2*iSearchMax);
						elevation := (-1*n_steps * (iCountSearch - 2*iSearchMax)) * rTemp;
					ELSIF iCountSearch &lt; 4 * iSearchMax THEN
						azimuth := n_steps * (iCountSearch - 3*iSearchMax) - delta;
						elevation := (n_steps * (iCountSearch - 3*iSearchMax) - delta) * rTemp;
					END_IF

					IF ABS(delta1) &lt; 1E-4 THEN
						elevation := 0;
					END_IF

					IF iCountSearch &gt;= 4 * iSearchMax THEN
						azimuth := 0.0;
						elevation := 0.0;
						done := TRUE;
						state := 3;
					ELSE
						IF locked THEN
						   lock_count := lock_count + 1;
						ELSE
						   lock_count := 0;
						END_IF
						IF lock_count &gt;= 10 THEN
						   azimuth := -Azerror;
						   elevation := -elError;
						   done := TRUE;
						   state := 2;
						END_IF
					END_IF
			END_IF
        2:
            done := TRUE;
        3:
            azimuth := 0.0;
            elevation := 0.0;
            done := TRUE;
    END_CASE

	IF state = 2 THEN
		bType := TRUE;
	ELSIF state = 3 THEN
		bType := FALSE;
	END_IF
END_IF;
</Single>
