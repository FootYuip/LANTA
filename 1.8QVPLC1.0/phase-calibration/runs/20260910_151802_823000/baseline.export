          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">//该功能块查找到轨道时间数组内最大最小值以及索引位置
//找出最大最小值
MaxVal := 0; // 初始化最大值
MinVal := 0; // 初始化最小值
MaxIndex := 0; // 初始化最大值的索引
MinIndex := 0; // 初始化最小值的索引

FOR i := 1 TO 5 DO
    IF Arr[i] &lt;&gt; 0 THEN
        IF MaxVal = 0 THEN
            MaxVal := Arr[i];
            MaxIndex := i;
        ELSIF Arr[i] &gt; MaxVal THEN
            MaxVal := Arr[i];
            MaxIndex := i;
        END_IF

        IF MinVal = 0 THEN
            MinVal := Arr[i];
            MinIndex := i;
        ELSIF Arr[i] &lt; MinVal THEN
            MinVal := Arr[i];
            MinIndex := i;
        END_IF
    END_IF
END_FOR

// MaxVal 和 MinVal 包含了最大值和最小值，不考虑值为0的元素
// MaxIndex 和 MinIndex 包含了最大值和最小值的索引


//当前时间和最大最小比较 
IF ulRealTime&lt;MinVal*1000000 THEN //小于插值范围 取最小时间
	//
	ulInterRealTime:=MinVal*1000000; //应该修改插值位置 而不是时间
ELSIF ulRealTime&gt;MaxVal*1000000THEN //大于插值范围 取最大时间
	//
	ulInterRealTime:=MaxVal*1000000;//应该修改插值位置 而不是时间
ELSE
	//如果内部有0 则不插值选取最新的数据
	FOR j:=1 TO 5 DO
		IF (Arr[i]=0) AND (j&lt;5) THEN
			ulInterRealTime:=Arr[5];//应该修改插值位置 而不是时间
			MaxIndex:=5;
			EXIT;
		ELSIF (Arr[i]=0) AND (j=5) THEN
			//没有输入数据 需要报错吗？
		END_IF
	END_FOR
	//
END_IF</Single>
            <Single Name="LineInfoPersistence" Type="string">eaa4dd33-a415-4c10-a261-8fdc73e2db65_Impl_LineIds</Single>
          </Single>
        </Single>
        <Single Name="Interface" Type="{a9ed5b7e-75c5-4651-af16-d2c27e98cb94}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">FUNCTION_BLOCK InterDataProcess
VAR_INPUT
	ulRealTime: ULINT;//实际时间 单位纳秒
	//aOrbitTime: ARRAY [1..5] OF ULINT;//轨道时间数组
	Arr: ARRAY [1..5] OF ULINT:=[9,0,1,5,4]; // 创建一个包含5个整数的数组 轨道时间数组  起点 1970-01-01 0:00:00 单位纳秒
    
END_VAR
VAR_OUTPUT
	MaxVal, MinVal: ULINT;   // 定义最大值、最小值和循环计数器变量
    MaxIndex, MinIndex: INT; // 定义最大值和最小值的索引
	ulInterRealTime : ULINT;//插值使用的时间
END_VAR
VAR
	i,j: INT;
END_VAR
</Single>
            <Single Name="LineInfoPersistence" Type="string">eaa4dd33-a415-4c10-a261-8fdc73e2db65_Decl_LineIds</Single>
          </Single>
