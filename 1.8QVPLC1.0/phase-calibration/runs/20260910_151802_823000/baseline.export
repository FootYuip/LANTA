      </Single>
      <Single Name="Object" Type="{6f9dac99-8de1-4efc-8465-68ac443b7d08}" Method="IArchivable">
        <Single Name="SpecialFunc" Type="{0db3d7bb-cde0-4416-9a7b-ce49a0124323}">None</Single>
        <Single Name="Implementation" Type="{3b83b776-fb25-43b8-99f2-3c507c9143fc}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">(*
IF iState=1 THEN
	rChanUa:=GVL.Chan1Ua;
	rChanUe:=GVL.Chan1Ue;
	rChanAGC:=GVL.Chan1AGC;
	bChanLock:=TRUE;
ELSIF iState=2 THEN
	rChanUa:=GVL.Chan2Ua;
	rChanUe:=GVL.Chan2Ue;
	rChanAGC:=GVL.Chan2AGC;
	bChanLock:=TRUE;
ELSE 
	bChanLock:=FALSE;
END_IF
*)

//iState:=modbusSlave.Trace_Num;//跟踪支路选择
iState:=1;

CASE iState OF 
	1://使用跟踪接收机1 且锁定标识为True
		//
		//bChanLock:=TRUE;
		//方位
		IF GVL.bStartTrack AND (GVL.Chan1Lock OR Securitycheck.bErrorLock) THEN
			//根据误差电压正负决定拉偏方向
			rChanUa:=GVL.Chan1Ua;
			//rChanUa:=rChanUa/UDINT_TO_REAL(modbusSlave.DirSenFac);
			rChanUa:=rChanUa/rDirSenFac;
			rCurentEl:=(rFctPosReal_1-90)*3.1415926535897/180.0;
			rChanUa:=rChanUa/COS(rCurentEl);
			
			//俯仰
			rChanUe:=GVL.Chan1Ue;
			//rChanUe:=rChanUe/UDINT_TO_REAL(modbusSlave.DirSenFac);;
			rChanUe:=rChanUe/rDirSenFac;
			rChanAGC:=GVL.Chan1AGC;
			
			//累积量
			rAzSum:=rAzSum+rk*rChanUa/1000.0;
			rElSum:=rElSum+rk*rChanUe/1000.0;
		ELSE
			rAzSum:=0;
			rElSum:=0;
			rChanUa:=0;
			rChanUe:=0;
		END_IF
		
	2://使用跟踪接收机2 且锁定标识为True
		//
		//bChanLock:=TRUE;
		rChanUa:=GVL.Chan2Ua;
		rChanUe:=GVL.Chan2Ue;
		rChanAGC:=GVL.Chan2AGC;
		//跟踪接收机拉偏量
		(*
		rChanUa:=GVL.Chan2Ua/modbusSlave.DirSenFac;
		rChanUe:=GVL.Chan2Ue/modbusSlave.DirSenFac;
		*)
	3://锁定标识符为False
		//
		//bChanLock:=FALSE;
END_CASE</Single>
            <Single Name="LineInfoPersistence" Type="string">d31898b0-2e29-4c5d-8ff3-31cd90e84e15_Impl_LineIds</Single>
          </Single>
        </Single>
        <Single Name="Interface" Type="{a9ed5b7e-75c5-4651-af16-d2c27e98cb94}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">PROGRAM AutoTrackingCal
VAR
	rChanUa:REAL;//自跟踪采用的跟踪接收机ua
	rChanUe:REAL;//自跟踪采用的跟踪接收机ue
	rChanAGC:REAL;//自跟踪采用的跟踪接收机AGC
	bChanLock:BOOL;//频道是否锁定
	iCountATLock:INT;//自跟踪锁定
	iState:INT;//Case选择变量
	
	rAzSum:LREAL;//方位累计量
	rElSum:LREAL;//俯仰累积量
	
	rDirSenFac:REAL:=12;
	rCurentEl:LREAL;//当前俯仰角
	rk: LREAL:=1/15.0;
	
	rChanUaLocal:REAL;//自跟踪采用的跟踪接收机ua
	rChanUeLocal:REAL;//自跟踪采用的跟踪接收机ue
END_VAR
</Single>
            <Single Name="LineInfoPersistence" Type="string">d31898b0-2e29-4c5d-8ff3-31cd90e84e15_Decl_LineIds</Single>
          </Single>
        </Single>
        <Single Name="UniqueIdGenerator" Type="string">244</Single>
        <Single Name="POULevel" Type="{8e575c5b-1d37-49c6-941b-5c0ec7874787}">Standard</Single>
        <List Name="ChildObjectGuids" Type="System.Collections.ArrayList" />
        <Single Name="AddAttributeSubsequent" Type="bool">False</Single>
      </Single>
      <Single Name="ParentSVNodeGuid" Type="System.Guid">49085721-e2f3-443d-be92-6caf07f84b13</Single>
      <Array Name="Path" Type="string">
        <Single Type="string">Device</Single>
        <Single Type="string">PLC逻辑</Single>
        <Single Type="string">Application</Single>
      </Array>
      <Single Name="Index" Type="int">-1</Single>
    </Single>
    <Single Type="{6198ad31-4b98-445c-927f-3258a0e82fe3}" Method="IArchivable">
      <Single Name="IsRoot" Type="bool">False</Single>
      <Single Name="MetaObject" Type="{81297157-7ec9-45ce-845e-84cab2b88ade}" Method="IArchivable">
        <Single Name="Guid" Type="System.Guid">e86aacd1-719d-4a98-a0f2-ae7fae70687c</Single>
        <Single Name="ParentGuid" Type="System.Guid">49085721-e2f3-443d-be92-6caf07f84b13</Single>
        <Single Name="Name" Type="string">Ti_ctrl_1</Single>
        <Dictionary Type="{2c41fa04-1834-41c1-816e-303c7aa2c05b}" Name="Properties" />
        <Single Name="TypeGuid" Type="System.Guid">6f9dac99-8de1-4efc-8465-68ac443b7d08</Single>
        <Array Name="EmbeddedTypeGuids" Type="System.Guid">
          <Single Type="System.Guid">a9ed5b7e-75c5-4651-af16-d2c27e98cb94</Single>
          <Single Type="System.Guid">3b83b776-fb25-43b8-99f2-3c507c9143fc</Single>
        </Array>
        <Single Name="Timestamp" Type="long">638912068902430899</Single>
      </Single>
      <Single Name="Object" Type="{6f9dac99-8de1-4efc-8465-68ac443b7d08}" Method="IArchivable">
        <Single Name="SpecialFunc" Type="{0db3d7bb-cde0-4416-9a7b-ce49a0124323}">None</Single>
        <Single Name="Implementation" Type="{3b83b776-fb25-43b8-99f2-3c507c9143fc}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">IF GVL.Error_code &lt;&gt; 0 THEN
	bVisError := TRUE;
ELSE
	bVisError := FALSE;
END_IF
(*
//远控轴参量赋值
Axis2Remote.iMode:=Modbus_Slave.iMode_2;
Axis2Remote.rVelCmd:=Modbus_Slave.rVelcmd_2;
Axis2Remote.rPosCmd:=Modbus_Slave.rPosCmd_2;
Axis2Remote.rP:=Modbus_Slave.rP_2;
Axis2Remote.rI:=Modbus_Slave.rI_2;
Axis2Remote.rD:=Modbus_Slave.rD_2;
Axis2Remote.rPIDThre:=Modbus_Slave.rThreshold_2;
Axis2Remote.rAcceleration:=Modbus_Slave.rAcceleration_2;
Axis2Remote.rDeceleration:=Modbus_Slave.rDeceleration_2;
Axis2Remote.rVel_Limit:=Modbus_Slave.rVelLim_2;
*)
// 倾斜轴状态写入
Axis3Status.Error := GVL.bTiStsBit3;
Axis3Status.ErrorID := GVL.eTiErrorcode;
Axis3Status.bServo_Enable := GVL.bTiStsBit0 AND GVL.bTiStsBit1 AND GVL.bTiStsBit2;
Axis3Status.bBrake := NOT (GVL.bTiStsBit0 AND GVL.bTiStsBit1 AND GVL.bTiStsBit2);
Axis3Status.Disabled := NOT (GVL.bTiStsBit0 AND GVL.bTiStsBit1 AND GVL.bTiStsBit2);
Axis3Remote.rSoft_limit_Negative:=-190;Axis3Remote.rSoft_limit_Postive:=190;
Axis3Local.rSoft_limit_Negative:=-190;Axis3Local.rSoft_limit_Postive:=190;

//速度的写入
rFctVelReal_3:=DINT_TO_REAL(diTiActVel)/524288.0*360.0;
//位置的写入，方位0对应编码器0，所以实际方位是：-1*编码器值
//rFctPosReal_3:=DINT_TO_REAL(diTiActPos)/524288.0*360.0-11.413-0.08;
rFctPosReal_3:=DINT_TO_REAL(diTiActPos)/524288.0*360.0;
//软限位控制
Axis3Limit_pos:=190;
Axis3Limit_Neg:=-190;
IF Axis3Remote.rPosCmd&gt;Axis3Limit_pos THEN
	Axis3Remote.rPosCmd:=190;
ELSIF Axis3Remote.rPosCmd&lt;Axis3Limit_Neg THEN
	 Axis3Remote.rPosCmd:=-190;  
END_IF

IF Axis3Local.rPosCmd&gt;Axis3Limit_pos THEN
	Axis2Local.rPosCmd:=190;
ELSIF Axis3Local.rPosCmd&lt;Axis3Limit_Neg THEN
	 Axis3Local.rPosCmd:=-190;  
END_IF

//停止标志符号判断
IF  ABS(rFctVelReal_3)&lt;0.035 THEN
	Stop3_Count:=Stop3_Count+1;
	IF Stop3_Count&gt;100 THEN
		Stop3_Count:=101;
		bStop_3:=TRUE;;
	END_IF
ELSE
	Stop3_Count:=0;
	bStop_3:=FALSE;
END_IF
Axis3Status.Moving := NOT bStop_3;
//PID使能赋值
IF Axis3Remote.iMode=2 OR Axis3Remote.iMode=4 THEN
	Axis3Remote.bPIDEnable:=TRUE;
ELSE
	Axis3Remote.bPIDEnable:=FALSE;
END_IF

//本远控逻辑保护
//远控切本控逻辑保护
bRTriger(CLK:=GVL.bLocalCtrl);
bFTriger(CLK:=GVL.bLocalCtrl);

IF Axis3Status.bServo_Enable AND (bRTriger.Q ) THEN//如果速度不为0且本控发生切换，则减速停止标识为True
	bRemote2LocalStop:=TRUE;
END_IF
IF bRemote2LocalStop  THEN //若减速停止标识符为True 
	
	IF  bStop_3=TRUE THEN//且电机速度不为0 开始减速 减速完成后下使能，下使能完成后复位标识符复位
		Axis3Local.iMode:=0;
		Axis3Remote.iMode:=0;
		IF Axis3Status.bServo_Enable=FALSE THEN
			bRemote2LocalStop:=FALSE;
		END_IF
	ELSE
		Axis3Remote.iMode:=7;
	END_IF
END_IF

//本控切远控
IF Axis3Status.bServo_Enable AND (bFTriger.Q ) THEN//如果速度不为0且本控发生切换，则减速停止标识为True
	bLocal2RemoteStop:=TRUE;
END_IF
IF bLocal2RemoteStop  THEN //若减速停止标识符为True 
	
	IF  bStop_3=TRUE THEN//且电机速度不为0 开始减速 减速完成后下使能，下使能完成后复位标识符复位
		Axis3Local.iMode:=0;
		Axis3Remote.iMode:=0;
		IF Axis3Status.bServo_Enable=FALSE THEN
			bLocal2RemoteStop:=FALSE;
		END_IF
	ELSE
		Axis3Remote.iMode:=7;
		Axis3Local.iMode:=7;
	END_IF
END_IF
(*
//自跟踪
IF GVL.bStartTrack THEN
	Axis2Remote.bStartAutoTrack := TRUE;
	Axis2Remote.rChanU := -AutoTrackingCal.rChanUa;
ELSE
	Axis2Remote.bStartAutoTrack := FALSE;	
	Axis2Remote.rChanU := 0;
END_IF
//拉偏
Axis2Remote.rPIDCmdPos:=RealTimePosCal.rInterAzPos+Modbus_Slave.rBias_2;
*)
//限位
IF Axis3Remote.rPIDCmdPos&lt;-190 THEN
	Axis3Remote.rPIDCmdPos:=-190;
ELSIF Axis3Remote.rPIDCmdPos&gt;190 THEN
	Axis3Remote.rPIDCmdPos:=190;
END_IF

Axis3_Ctrl(sLocal:=Axis3Local, sCtrl:=Axis3Remote, sStatus:=Axis3Status, sVisible:=Axis3Visible, rRealPos:=rFctPosReal_3, rPosLimK:=0.34);
	
</Single>
            <Single Name="LineInfoPersistence" Type="string">e86aacd1-719d-4a98-a0f2-ae7fae70687c_Impl_LineIds</Single>
          </Single>
        </Single>
        <Single Name="Interface" Type="{a9ed5b7e-75c5-4651-af16-d2c27e98cb94}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">PROGRAM Ti_ctrl_1
VAR
	Axis3_Ctrl:Ti_Ctrl_FB;
	bRemote2LocalStop:BOOL;
	bLocal2RemoteStop:BOOL;
	Error:INT;
	
	Axis3Limit_pos:REAL;//正软限位
	Axis3Limit_Neg:REAL;//负软限位
	
	bRTriger:Standard.R_TRIG;//本控上升沿
	bFTriger:Standard.F_TRIG;//远控下降沿
	Stop3_Count: INT;
	bStop_3: BOOL;
	
	//指向模式自跟踪
	rPosModeStepBias:LREAL;//指向模式自跟踪拉偏累计值
	rPosModeStep:LREAL:=0.005;//指向模式自跟踪步长，积分用
	rStepBiasMax:LREAL:=2;//指向模式拉偏最大值
	
	//程引拉偏
	rStepBias:LREAL;//步进拉偏累计值
// 	rStep:LREAL:=0.0002;//步长，与控制周期有关，1ms周期对应1秒内累积0.0002*1000=0.2°
// 	rStep:LREAL:=0.01;//步长，与控制周期有关，50ms周期对应1秒内累积0.01*20=0.2°
	rStep:LREAL:=0.004;//步长，与控制周期有关，20ms周期对应1秒内累积0.004*50=0.2°
		
	//自跟踪拉偏
	rAuToStepBias:LREAL;//步进拉偏累计值
// 	rAutoStep:LREAL:=0.005;//步长
	rAutoStep:LREAL:=0.01;//步长
	TbAutoTrigger:Standard.F_TRIG;//自跟踪关闭的下降沿
	RbAutoTrigger:Standard.R_TRIG;//自跟踪开启的上升沿

	rAutoTrackingBiasMax:LREAL:=300;//自跟踪拉偏最大值
	rLocalInitPosModeSpeed: REAL;
	rRemoteInitPosModeSpeed: REAL;
	iCountOffAuto: INT;
	
	iCasePBAutoTrack:INT:=2;//程序引导自跟踪切换 
// 	rKAuToStepBias:LREAL:=0.25;
	rKAuToStepBias:LREAL:=0.16;
	bVisError:BOOL; //报错可视化标识
END_VAR
</Single>
            <Single Name="LineInfoPersistence" Type="string">e86aacd1-719d-4a98-a0f2-ae7fae70687c_Decl_LineIds</Single>
          </Single>
        </Single>
        <Single Name="UniqueIdGenerator" Type="string">443</Single>
        <Single Name="POULevel" Type="{8e575c5b-1d37-49c6-941b-5c0ec7874787}">Standard</Single>
        <List Name="ChildObjectGuids" Type="System.Collections.ArrayList" />
        <Single Name="AddAttributeSubsequent" Type="bool">False</Single>
      </Single>
      <Single Name="ParentSVNodeGuid" Type="System.Guid">49085721-e2f3-443d-be92-6caf07f84b13</Single>
      <Array Name="Path" Type="string">
        <Single Type="string">Device</Single>
        <Single Type="string">PLC逻辑</Single>
        <Single Type="string">Application</Single>
      </Array>
      <Single Name="Index" Type="int">-1</Single>
    </Single>
    <Single Type="{6198ad31-4b98-445c-927f-3258a0e82fe3}" Method="IArchivable">
      <Single Name="IsRoot" Type="bool">False</Single>
      <Single Name="MetaObject" Type="{81297157-7ec9-45ce-845e-84cab2b88ade}" Method="IArchivable">
        <Single Name="Guid" Type="System.Guid">ebe00c16-e4b5-485c-a823-5dd11ef20e18</Single>
        <Single Name="ParentGuid" Type="System.Guid">49085721-e2f3-443d-be92-6caf07f84b13</Single>
        <Single Name="Name" Type="string">Ti_Ctrl_FB</Single>
        <Dictionary Type="{2c41fa04-1834-41c1-816e-303c7aa2c05b}" Name="Properties" />
        <Single Name="TypeGuid" Type="System.Guid">6f9dac99-8de1-4efc-8465-68ac443b7d08</Single>
        <Array Name="EmbeddedTypeGuids" Type="System.Guid">
          <Single Type="System.Guid">a9ed5b7e-75c5-4651-af16-d2c27e98cb94</Single>
          <Single Type="System.Guid">3b83b776-fb25-43b8-99f2-3c507c9143fc</Single>
        </Array>
        <Single Name="Timestamp" Type="long">638979529073293884</Single>
      </Single>
      <Single Name="Object" Type="{6f9dac99-8de1-4efc-8465-68ac443b7d08}" Method="IArchivable">
        <Single Name="SpecialFunc" Type="{0db3d7bb-cde0-4416-9a7b-ce49a0124323}">None</Single>
        <Single Name="Implementation" Type="{3b83b776-fb25-43b8-99f2-3c507c9143fc}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">// 下电时复位控制字bit8
IF sStatus.Disabled OR(NOT sStatus.Moving)THEN
	bTiCtrlBit8 := FALSE;
END_IF

//	错误复位功能
IF GVL.bError_Reset THEN
	sCtrl.iMode:=6;
	sLocal.iMode:=6;
	GVL.Error_code:=0;
END_IF
IF GVL.Error_code =0 THEN
	GVL.bError_Reset:=FALSE;
END_IF

/////////心跳报错清除/////////
IF GVL.eTiErrorcode = 16#8130 AND NOT tr THEN
	GVL.bTiCtrlBit7 := TRUE;
	tr:=TRUE;
	istate:=0;
	icount:=0;
	// 写入下电控制字
	GVL.bTiCtrlBit3 := FALSE;
	GVL.bTiCtrlBit0 := FALSE;
	GVL.bTiCtrlBit1 := FALSE;
	GVL.bTiCtrlBit2 := FALSE;
END_IF
IF tr THEN
	icount1 := icount1 + 1;
END_IF
IF icount1 &gt; 101 THEN
	icount1 := 0;
	tr := FALSE;
	GVL.bTiCtrlBit7 := FALSE;
	bfin1 := TRUE;
END_IF
IF bfin1 THEN
	icount2 := icount2 + 1;
END_IF
IF icount2 &gt; 101 THEN
	bfin1 := FALSE;
	icount2 := 0;
END_IF
/////////////////////////////

IF GVL.Error_code=0 AND GVL.eTiErrorcode = 0 AND NOT GVL.bTiCtrlBit7  AND NOT tr AND NOT bfin1 AND NOT bfin2 THEN
	IF GVL.bLocalCtrl=FALSE THEN //远控
		IF sCtrl.iMode &lt;&gt; 1 THEN
			istate:=0;
			icount:=0;
		END_IF
		CASE sCtrl.iMode OF
			MODES.powerOff: // 下电
				IF NOT sStatus.Disabled THEN
					IF sStatus.Moving THEN // 运动中，先停止运动
						GVL.diTiTargetVel := 0;
						bTiCtrlBit8 := TRUE;
					ELSE
						// 写入下电控制字
						GVL.bTiCtrlBit3 := FALSE;
						GVL.bTiCtrlBit0 := FALSE;
						GVL.bTiCtrlBit1 := FALSE;
						GVL.bTiCtrlBit2 := FALSE;
					END_IF
				END_IF
			MODES.powerOn:  // 上电
				IF sStatus.Disabled THEN
					// 目标速度清零
					GVL.diTiTargetVel := 0;
					IF GVL.siTiMode &lt;&gt; 3 THEN // 上电时模式默认为3，速度模式
						GVL.siTiMode := 3;
					END_IF
					IF siTiMode = 3 THEN
						CASE istate OF
							0:
								GVL.bTiCtrlBit1 := TRUE;
								GVL.bTiCtrlBit2 := TRUE;
								icount := icount + 1;
								IF icount = 20 THEN
									icount:=0;
									istate:=1;
								END_IF
							1:
								GVL.bTiCtrlBit0 := TRUE;
								icount := icount + 1;
								IF icount = 20 THEN
									icount:=0;
									istate:=2;
								END_IF
							2:
								GVL.bTiCtrlBit3 := TRUE;
						END_CASE
					END_IF
				ELSE
					IF sStatus.Moving THEN
						GVL.diTiTargetVel := 0;
						bTiCtrlBit8 := TRUE;
					ELSE
						bTiCtrlBit8 := FALSE;
					END_IF
				END_IF
			MODES.positionMode: // 远控指向模式
				IF NOT sStatus.Disabled THEN
					IF sCtrl.bStartAutoTrack THEN
						(*
						//自跟踪模式下，由误差电压直接驱动
						VelPID_1(rTarget:=sCtrl.rChanU + rRealPos,
								rFeedback:=rRealPos,
								rPosLimPositive:=sCtrl.rSoft_limit_Postive,
								rPosLimNegative:=sCtrl.rSoft_limit_Negative,
								rVelLim:=sCtrl.rVel_Limit,
								rKp:=sCtrl.rP_AutoTrack,//自跟踪PI系数3,0.02
								rKi:=sCtrl.rI_AutoTrack,
								rKd:=sCtrl.rD,
								bPIDEnable:=sCtrl.bPIDEnable,
								iThreshold:= -1,
								rPIDOutput=&gt;sCtrl.rPIDCmdVel);
*)							
					ELSE
						//PID计算速度指令
						VelPID_1(rTarget:=sCtrl.rPosCmd,
							rFeedback:=rRealPos,
							rVelLim:=sCtrl.Pos_Vel,
							rPosLimPositive:=sCtrl.rSoft_limit_Postive,
							rPosLimNegative:=sCtrl.rSoft_limit_Negative,
							rKp:=0.8,//程引PI系数地带：1,0.002  高带：3,0.02
							rKi:=0,
							rKd:=0,
							bPIDEnable:=sCtrl.bPIDEnable,
							iThreshold:=sCtrl.rPIDThre,
							rPIDOutput=&gt;sCtrl.rPIDCmdVel);
					END_IF
					GVL.diTiTargetVel := REAL_TO_DINT(sCtrl.rPIDCmdVel * 524288 / 360);
					GVL.diTiTargetAcc := REAL_TO_UDINT(10 * 524288 / 360);   //加速度
					GVL.diTiTargetDec := REAL_TO_UDINT(10 * 524288 / 360);   //减速度
				END_IF
			MODES.velocityMode://手控速度模式-远控模式
				IF NOT sStatus.Disabled THEN
					IF ABS(sCtrl.rVelCmd) &lt;= sCtrl.rVel_Limit THEN
						GVL.diTiTargetVel := REAL_TO_DINT(sCtrl.rVelCmd * 524288 / 360);
					ELSIF sCtrl.rVelCmd &gt; sCtrl.rVel_Limit THEN
						GVL.diTiTargetVel := REAL_TO_DINT(sCtrl.rVel_Limit * 524288 / 360);
					ELSE
						GVL.diTiTargetVel := REAL_TO_DINT(-sCtrl.rVel_Limit * 524288 / 360);
					END_IF
					GVL.diTiTargetAcc := REAL_TO_UDINT(sCtrl.rAcceleration * 524288 / 360);   //加速度
					GVL.diTiTargetDec := REAL_TO_UDINT(sCtrl.rDeceleration * 524288 / 360);   //减速度
				END_IF
			MODES.programBootMode://PID速度模式-正常模式 程引
				IF NOT sStatus.Disabled THEN
					IF sCtrl.bStartAutoTrack THEN
						//自跟踪模式下，由误差电压直接驱动
						VelPID_1(rTarget:=sCtrl.rChanU + rRealPos,
								rFeedback:=rRealPos,
								rPosLimPositive:=sCtrl.rSoft_limit_Postive,
								rPosLimNegative:=sCtrl.rSoft_limit_Negative,
								rVelLim:=sCtrl.rVel_Limit,
								rKp:=sCtrl.rP_AutoTrack,//自跟踪PI系数3,0.02
								rKi:=sCtrl.rI_AutoTrack,
								rKd:=sCtrl.rD,
								bPIDEnable:=sCtrl.bPIDEnable,
								iThreshold:= -1,
								rPIDOutput=&gt;sCtrl.rPIDCmdVel);							
					ELSE
						//PID计算速度指令
						VelPID_1(rTarget:=sCtrl.rPIDCmdPos,
							rFeedback:=rRealPos,
							rVelLim:=sCtrl.rVel_Limit,
							rPosLimPositive:=sCtrl.rSoft_limit_Postive,
							rPosLimNegative:=sCtrl.rSoft_limit_Negative,
							rKp:=sCtrl.rP,//程引PI系数地带：1,0.002  高带：3,0.02
							rKi:=sCtrl.rI,
							rKd:=sCtrl.rD,
							bPIDEnable:=sCtrl.bPIDEnable,
							iThreshold:=sCtrl.rPIDThre,
							rPIDOutput=&gt;sCtrl.rPIDCmdVel);
					END_IF
					GVL.diTiTargetVel := REAL_TO_DINT(sCtrl.rPIDCmdVel * 524288 / 360);
					GVL.diTiTargetAcc := REAL_TO_UDINT(sCtrl.rAcceleration * 524288 / 360);   //加速度
					GVL.diTiTargetDec := REAL_TO_UDINT(sCtrl.rDeceleration * 524288 / 360);   //减速度
				END_IF
			MODES.reset://重置
				IF NOT sStatus.Disabled THEN
					IF sStatus.Moving THEN
						GVL.diTiTargetVel := 0;
						bTiCtrlBit8 := TRUE;
					ELSE
						bTiCtrlBit8 := FALSE;
					END_IF
				END_IF
			MODES.halt://待机
				IF NOT sStatus.Disabled THEN
					IF sStatus.Moving THEN
						GVL.diTiTargetVel := 0;
						bTiCtrlBit8 := TRUE;
					ELSE
						bTiCtrlBit8 := FALSE;
					END_IF
				END_IF
			
		END_CASE
	ELSE // 本控
		IF sLocal.iMode &lt;&gt; 1 THEN
			istate:=0;
			icount:=0;
		END_IF
		CASE sLocal.iMode OF
			MODES.powerOff: // 下电
				IF NOT sStatus.Disabled THEN
					IF sStatus.Moving THEN // 运动中，先停止运动
						GVL.diTiTargetVel := 0;
						bTiCtrlBit8 := TRUE;
					ELSE
						// 写入下电控制字
						GVL.bTiCtrlBit3 := FALSE;
						GVL.bTiCtrlBit0 := FALSE;
						GVL.bTiCtrlBit1 := FALSE;
						GVL.bTiCtrlBit2 := FALSE;
					END_IF
				END_IF
			MODES.powerOn:  // 上电
				IF sStatus.Disabled THEN
					// 目标速度清零
					GVL.diTiTargetVel := 0;
					IF GVL.siTiMode &lt;&gt; 3 THEN // 上电时模式默认为3，速度模式
						GVL.siTiMode := 3;
					END_IF
					IF siTiMode = 3 THEN
						CASE istate OF
							0:
								GVL.bTiCtrlBit1 := TRUE;
								GVL.bTiCtrlBit2 := TRUE;
								icount := icount + 1;
								IF icount = 20 THEN
									icount:=0;
									istate:=1;
								END_IF
							1:
								GVL.bTiCtrlBit0 := TRUE;
								icount := icount + 1;
								IF icount = 20 THEN
									icount:=0;
									istate:=2;
								END_IF
							2:
								GVL.bTiCtrlBit3 := TRUE;
						END_CASE
					END_IF
				ELSE
					IF sStatus.Moving THEN
						GVL.diTiTargetVel := 0;
						bTiCtrlBit8 := TRUE;
					ELSE
						bTiCtrlBit8 := FALSE;
					END_IF
				END_IF
			MODES.velocityMode://手控速度模式-本控模式
				IF NOT sStatus.Disabled THEN
					IF ABS(sLocal.rVelCmd) &lt;= sLocal.rVel_Limit THEN
						GVL.diTiTargetVel := REAL_TO_DINT(sLocal.rVelCmd * 524288 / 360);
					ELSIF sLocal.rVelCmd &gt; sLocal.rVel_Limit THEN
						GVL.diTiTargetVel := REAL_TO_DINT(sLocal.rVel_Limit * 524288 / 360);
					ELSE
						GVL.diTiTargetVel := REAL_TO_DINT(-sLocal.rVel_Limit * 524288 / 360);
					END_IF
					GVL.diTiTargetAcc := REAL_TO_UDINT(sLocal.rAcceleration * 524288 / 360);   //加速度
					GVL.diTiTargetDec := REAL_TO_UDINT(sLocal.rDeceleration * 524288 / 360);   //减速度
				END_IF
			MODES.programBootMode://本控位置模式
				IF NOT sStatus.Disabled THEN
					IF NOT sLocal.bPIDEnable THEN
						GVL.diTiTargetVel := 0;							
					ELSE
						//PID计算速度指令
						 VelPID_2(rTarget:=sLocal.rPosCmd,
							     rFeedback:=rRealPos,
								 rPosLimPositive:=sLocal.rSoft_limit_Postive,//软限位
								 rPosLimNegative:=sLocal.rSoft_limit_Negative,
								 rKp:=sLocal.rP,
								 rKi:=sLocal.rI,
								 rKd:=sLocal.rD,
								 iThreshold:=sLocal.rPIDThre,
								 bPIDEnable:=sLocal.bPIDEnable,
								 rVelLim:=sLocal.Pos_Vel,
								 rPIDOutput=&gt;sLocal.rPIDCmdVel);//普通PID
					END_IF
					GVL.diTiTargetVel := REAL_TO_DINT(sLocal.rPIDCmdVel * 524288 / 360);
					GVL.diTiTargetAcc := REAL_TO_UDINT(sLocal.rAcceleration * 524288 / 360);   //加速度
					GVL.diTiTargetDec := REAL_TO_UDINT(sLocal.rDeceleration * 524288 / 360);   //减速度
				END_IF
			MODES.reset://重置
			// 是否需要
			MODES.halt://待机
				IF NOT sStatus.Disabled THEN
					IF sStatus.Moving THEN
						GVL.diTiTargetVel := 0;
						bTiCtrlBit8 := TRUE;
					ELSE
						bTiCtrlBit8 := FALSE;
					END_IF
				END_IF
			
		END_CASE
	END_IF
ELSIF GVL.Error_code&lt;&gt;0 AND GVL.eTiErrorcode = 0 AND NOT GVL.bTiCtrlBit7  AND NOT tr AND NOT bfin1 AND NOT bfin2 THEN
	// 出现错误，轴停止运动
	GVL.diTiTargetVel := 0;
	bTiCtrlBit8 := TRUE;
	TON_0(IN:=bTiCtrlBit8,PT:=T#1S,Q=&gt;,ET=&gt;);//判断stop0执行是否超时,若超时强制下电（手动复位）
	IF TON_0.Q THEN
		bTick:=TRUE;
	END_IF
	IF bTick AND sStatus.Moving THEN // 超时强制下电
		// 写入下电控制字
		GVL.bTiCtrlBit3 := FALSE;
		GVL.bTiCtrlBit0 := FALSE;
		GVL.bTiCtrlBit1 := FALSE;
		GVL.bTiCtrlBit2 := FALSE;
	END_IF
END_IF</Single>
            <Single Name="LineInfoPersistence" Type="string">ebe00c16-e4b5-485c-a823-5dd11ef20e18_Impl_LineIds</Single>
          </Single>
        </Single>
        <Single Name="Interface" Type="{a9ed5b7e-75c5-4651-af16-d2c27e98cb94}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">FUNCTION_BLOCK Ti_Ctrl_FB
VAR_INPUT
	sLocal:AxisCrtlStruct;
	sCtrl:AxisCrtlStruct;
	sStatus:AxisStatus;
	sVisible:AxisVisible;
	rRealPos:REAL;
	rPosLimK:REAL;
END_VAR
VAR_OUTPUT
	logicError:INT;
END_VAR
VAR
	VelPID_1:PID;
	VelPID_2:PID;
	TON_0:TON;
	bTick:BOOL;
	tr:BOOL;
	icount1:INT := 0;
	icount2:INT := 0;
	icount3:INT := 0;
	bfin1:BOOL;
	bfin2:BOOL;
	istate:INT:=0;
	icount:INT:=0;
END_VAR
</Single>
            <Single Name="LineInfoPersistence" Type="string">ebe00c16-e4b5-485c-a823-5dd11ef20e18_Decl_LineIds</Single>
          </Single>
        </Single>
        <Single Name="UniqueIdGenerator" Type="string">471</Single>
        <Single Name="POULevel" Type="{8e575c5b-1d37-49c6-941b-5c0ec7874787}">Standard</Single>
        <List Name="ChildObjectGuids" Type="System.Collections.ArrayList" />
        <Single Name="AddAttributeSubsequent" Type="bool">False</Single>
      </Single>
      <Single Name="ParentSVNodeGuid" Type="System.Guid">49085721-e2f3-443d-be92-6caf07f84b13</Single>
      <Array Name="Path" Type="string">
        <Single Type="string">Device</Single>
        <Single Type="string">PLC逻辑</Single>
        <Single Type="string">Application</Single>
      </Array>
      <Single Name="Index" Type="int">-1</Single>
    </Single>
    <Single Type="{6198ad31-4b98-445c-927f-3258a0e82fe3}" Method="IArchivable">
      <Single Name="IsRoot" Type="bool">False</Single>
      <Single Name="MetaObject" Type="{81297157-7ec9-45ce-845e-84cab2b88ade}" Method="IArchivable">
        <Single Name="Guid" Type="System.Guid">7c72a0b3-617e-4a04-be4b-ecd1af0fd60f</Single>
        <Single Name="ParentGuid" Type="System.Guid">49085721-e2f3-443d-be92-6caf07f84b13</Single>
        <Single Name="Name" Type="string">vpid</Single>
        <Dictionary Type="{2c41fa04-1834-41c1-816e-303c7aa2c05b}" Name="Properties">
          <Entry>
            <Key>
              <Single Type="System.Guid">24568a24-c491-472c-a21f-ee5d33859fab</Single>
            </Key>
            <Value>
              <Single Type="{24568a24-c491-472c-a21f-ee5d33859fab}" Method="IArchivable">
                <Single Name="MemoryReserveForOnlineChange" Type="int">0</Single>
                <Single Name="ExcludeFromBuild" Type="bool">False</Single>
                <Single Name="External" Type="bool">False</Single>
                <Single Name="EnableSystemCall" Type="bool">False</Single>
                <Single Name="CompilerDefines" Type="string"></Single>
                <Single Name="LinkAlways" Type="bool">False</Single>
                <Array Name="Undefines" Type="string" />
              </Single>
            </Value>
          </Entry>
        </Dictionary>
        <Single Name="TypeGuid" Type="System.Guid">6f9dac99-8de1-4efc-8465-68ac443b7d08</Single>
        <Array Name="EmbeddedTypeGuids" Type="System.Guid">
          <Single Type="System.Guid">a9ed5b7e-75c5-4651-af16-d2c27e98cb94</Single>
          <Single Type="System.Guid">3b83b776-fb25-43b8-99f2-3c507c9143fc</Single>
        </Array>
        <Single Name="Timestamp" Type="long">638864420738660279</Single>
      </Single>
      <Single Name="Object" Type="{6f9dac99-8de1-4efc-8465-68ac443b7d08}" Method="IArchivable">
        <Single Name="SpecialFunc" Type="{0db3d7bb-cde0-4416-9a7b-ce49a0124323}">None</Single>
        <Single Name="Implementation" Type="{3b83b776-fb25-43b8-99f2-3c507c9143fc}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">IF (bPIDEnable) THEN // 如果PID使能
    IF rTarget = rFeedback THEN
        rPIDOutDir := 0;    
    ELSE
        rErrorNow := rTarget - rFeedback; // 计算当前误差
        rProportionNew := rErrorNow;      // 比例项
		
		IF rElPos &gt; rVelThreshold THEN
			rKpTarget := rKpBase + rKpScale * (rElPos - rVelThreshold);
			rKiTarget := rKiBase + rKiScale * (rElPos - rVelThreshold);
		ELSE
			rKpTarget := rKpBase;
			rKiTarget := rKiBase;
		END_IF
//         rInterValueLast := rInterValueNow; // 将当前插值位置值赋值给上一次
// 		rInterValueNow := RealTimePosCal.ElCubicInter.sout*10000.0;
//         // 计算当前速度
//         // rSpeed := ABS(rFeedback - rLastFeedback);
//         rSpeed := ABS(rInterValueNow - rInterValueLast)/10000.0;
// 		
//         // 根据速度调整PI增益
//         IF rSpeed &gt; rVelThreshold THEN
//             rKpTarget := rKpBase + rKpScale * (rSpeed - rVelThreshold);
//             rKiTarget := rKiBase + rKiScale * (rSpeed - rVelThreshold);
//         ELSE
//             rKpTarget := rKpBase;
//             rKiTarget := rKiBase;
//         END_IF
        IF rKpTarget &gt; rKpMax THEN
			rKpTarget := rKpMax;
		END_IF
		IF rKiTarget &gt; rKiMax THEN
			rKiTarget := rKiMax;
		END_IF
		
		IF rKp&lt;=rKpTarget THEN
			rKp:=rKp+rStep;
		ELSE
			rKp:=rKp-rStep;
		END_IF
		IF rKi&lt;=rKiTarget THEN
			rKi:=rKi+(rKiScale/rKpScale)*rStep;
		ELSE
			rKi:=rKi-(rKiScale/rKpScale)*rStep;
		END_IF
	END_IF
        // 积分项
        IF rFeedback &gt; rPosLimNegitive AND rFeedback &lt; rPosLimPositive THEN // 若在软限位之内，工作时开启积分项
            IF (ABS(rTarget - rFeedback) &lt; iThrehold) THEN // 位置差小于积分阈值
                rIntegralNew := rIntegralNew + rErrorNow;  // 积分项
            ELSE
                rIntegralNew := rIntegralNew;  // 积分项
            END_IF;
        ELSE // 不在软限位范围内，则积分项为0
            rIntegralNew := 0;
        END_IF
        (*
        // 防止目标位置与当前位置偏差过大，导致比例项输出太大，引起震动
        IF rKp * rProportionNew &gt; 2 THEN
            rPIDOutput := 2;
        ELSIF rKp * rProportionNew &lt; -2 THEN
            rPIDOutput := -2;
        ELSE
            rPIDOutput := rKp * rProportionNew + rKi * rIntegralNew / 1000.0; // 由于需求积分项过小，因此积分系数在接口数据上除1000
        END_IF
        *)
		rPIDOutput := rKp * rProportionNew + rKi * rIntegralNew; // 由于需求积分项过小，因此积分系数在接口数据上除1000
        // 根据方向设置输出
        IF rPIDOutput &lt; 0 THEN

            rPIDOutDir := rPIDOutput;
        ELSE

            rPIDOutDir := rPIDOutput;
        END_IF
        
        // PID限速
        IF (ABS(rPIDOutDir) &gt; rVelLim) THEN
            IF rPIDOutDir &lt; (-rVelLim) THEN
                rPIDOutDir := -rVelLim;
            ELSIF rPIDOutDir &gt; rVelLim THEN
                rPIDOutDir := rVelLim;
            END_IF
        END_IF
        
        // 位置限位检查
        IF rFeedback &gt; rPosLimPositive AND rPIDOutDir &gt; 0  THEN
            rPIDOutDir := 0;
        END_IF
        IF rFeedback &lt; rPosLimNegitive AND rPIDOutDir &lt;= 0 THEN
            rPIDOutDir := 0;
        END_IF
        
        //rLastFeedback := rFeedback; // 将当前反馈值赋值给上一次反馈值
		//rInterValueLast := rInterValueNow; // 将当前插值位置值赋值给上一次

ELSE // 非使能清零PID各项
    rProportionNew := 0.0;
    rIntegralNew := 0.0;
    rPIDOutDir := 0.0;
    rPIDOutput := 0.0;
END_IF
</Single>
            <Single Name="LineInfoPersistence" Type="string">7c72a0b3-617e-4a04-be4b-ecd1af0fd60f_Impl_LineIds</Single>
          </Single>
        </Single>
        <Single Name="Interface" Type="{a9ed5b7e-75c5-4651-af16-d2c27e98cb94}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">FUNCTION_BLOCK vpid
VAR_INPUT
	rTarget : REAL;           // 设定值
    rFeedback : REAL;         // 反馈值
    rPosLimPositive : LREAL;  // 位置正限位
    rPosLimNegitive : LREAL;  // 位置反限位
    rKpBase : REAL;           // 基础比例增益
    rKiBase : REAL;           // 基础积分增益
    rVelThreshold : LREAL;     // 速度阈值，真实值除以控制频率
    rKpScale : REAL;          // 比例增益比例因子
    rKiScale : REAL;          // 积分增益比例因子
    iThrehold : INT;          // 积分项开启的位置阈值
    bPIDEnable : BOOL := TRUE;// PID使能
    rVelLim : LREAL;          // 速度限制
	rKpMax : REAL;
	rKiMax : REAL;
	rElPos : REAL;            // 俯仰角度
END_VAR

VAR_OUTPUT
    rPIDOutput : LREAL := 0;  // 控制量
	rPIDOutDir: LREAL;
END_VAR

VAR
    rLastFeedback : LREAL := 0.0; // 上一次反馈值
    rErrorNow : LREAL := 0.0;     // 当前误差
    rIntegralNew : LREAL := 0.0;  // 积分项
    rDelta : LREAL;               // 增量
    rProportionNew : LREAL;       // 比例项
    rSpeed : REAL;                // 当前速度
    rKp : REAL:=1;                   // 动态比例增益
    rKi : REAL:=0.02;                   // 动态积分增益
	rInterValueNow : LREAL := 0.0;        // 当前插值位置
	rInterValueLast : LREAL := 0.0;       // 上一次插值位置
	//rSlope :LREAL :=0; 			  //PI变化斜率
	rStep:LREAL:=0.002;                //PI变化率
	
	rKpTarget :REAL:=1;
	rKiTarget :REAL:=0.02;
	
	
END_VAR
</Single>
            <Single Name="LineInfoPersistence" Type="string">7c72a0b3-617e-4a04-be4b-ecd1af0fd60f_Decl_LineIds</Single>
          </Single>
