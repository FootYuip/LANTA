    <Single Type="{6198ad31-4b98-445c-927f-3258a0e82fe3}" Method="IArchivable">
      <Single Name="IsRoot" Type="bool">False</Single>
      <Single Name="MetaObject" Type="{81297157-7ec9-45ce-845e-84cab2b88ade}" Method="IArchivable">
        <Single Name="Guid" Type="System.Guid">b4c049e8-551d-466c-bbf6-cfd36e03c6f4</Single>
        <Single Name="ParentGuid" Type="System.Guid">49085721-e2f3-443d-be92-6caf07f84b13</Single>
        <Single Name="Name" Type="string">El_Ctrl_FB</Single>
        <Dictionary Type="{2c41fa04-1834-41c1-816e-303c7aa2c05b}" Name="Properties" />
        <Single Name="TypeGuid" Type="System.Guid">6f9dac99-8de1-4efc-8465-68ac443b7d08</Single>
        <Array Name="EmbeddedTypeGuids" Type="System.Guid">
          <Single Type="System.Guid">a9ed5b7e-75c5-4651-af16-d2c27e98cb94</Single>
          <Single Type="System.Guid">3b83b776-fb25-43b8-99f2-3c507c9143fc</Single>
        </Array>
        <Single Name="Timestamp" Type="long">639102995950171646</Single>
      </Single>
      <Single Name="Object" Type="{6f9dac99-8de1-4efc-8465-68ac443b7d08}" Method="IArchivable">
        <Single Name="SpecialFunc" Type="{0db3d7bb-cde0-4416-9a7b-ce49a0124323}">None</Single>
        <Single Name="Implementation" Type="{3b83b776-fb25-43b8-99f2-3c507c9143fc}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">// 下电时复位控制字bit8
IF sStatus.Disabled OR (NOT sStatus.Moving) THEN
	bElCtrlBit8 := FALSE;
END_IF

//	错误复位功能
IF GVL.bError_Reset THEN
	sCtrl.iMode:=6;
	sLocal.iMode:=6;
	GVL.Error_code:=0;
END_IF
IF GVL.Error_code =0 THEN
	GVL.bError_Reset:=FALSE;
END_IF

/////////心跳报错清除/////////
IF GVL.eElErrorcode = 16#8130 AND NOT tr THEN
	GVL.bElCtrlBit7 := TRUE;
	tr:=TRUE;
	istate:=0;
	icount:=0;
	// 写入下电控制字
	GVL.bElCtrlBit3 := FALSE;
	GVL.bElCtrlBit0 := FALSE;
	GVL.bElCtrlBit1 := FALSE;
	GVL.bElCtrlBit2 := FALSE;	
END_IF
IF tr THEN
	icount1 := icount1 + 1;
END_IF
IF icount1 &gt; 101 THEN
	icount1 := 0;
	tr := FALSE;
	GVL.bElCtrlBit7 := FALSE;
	bfin1 := TRUE;
END_IF
IF bfin1 THEN
	icount2 := icount2 + 1;
END_IF
IF icount2 &gt; 101 THEN
	bfin1 := FALSE;
	icount2 := 0;
END_IF
//////////////////////////////

IF GVL.Error_code=0 AND GVL.eElErrorcode = 0 AND NOT GVL.bElCtrlBit7  AND NOT tr AND NOT bfin1 AND NOT bfin2 THEN
	IF GVL.bLocalCtrl=FALSE THEN //远控
		IF sCtrl.iMode &lt;&gt; 1 THEN
			istate:=0;
			icount:=0;
		END_IF
		CASE sCtrl.iMode OF
			MODES.powerOff: // 下电
				IF NOT sStatus.Disabled THEN
					IF sStatus.Moving THEN // 运动中，先停止运动
						GVL.diElTargetVel := 0;
						bElCtrlBit8 := TRUE;
					ELSE
						// 写入下电控制字
						GVL.bElCtrlBit3 := FALSE;
						GVL.bElCtrlBit0 := FALSE;
						GVL.bElCtrlBit1 := FALSE;
						GVL.bElCtrlBit2 := FALSE;
					END_IF
				END_IF
				
				vpid1(rKpbase:=1, rKibase:=0.01, rKpMax:=1, rKiMax:=0.01, rVelThreshold:=10,rTarget:=sCtrl.rPIDCmdPos,rFeedback:=rRealPos,rPosLimPositive:=sCtrl.rSoft_limit_Postive,
							rPosLimNegitive:=sCtrl.rSoft_limit_Negative,
								bPIDEnable:=sCtrl.bPIDEnable,rVelLim:=sCtrl.rVel_Limit,rKpScale:=0.02,rKiScale:=0.005,rElPos:=GVL.rFctPosReal_1-90,
								iThrehold:=sCtrl.rPIDThre,rPIDOutDir=&gt;sCtrl.rPIDCmdVel);
			MODES.powerOn:  // 上电
				IF sStatus.Disabled THEN
					// 目标速度清零
					GVL.diElTargetVel := 0;
					IF GVL.siElMode &lt;&gt; 3 THEN // 上电时模式默认为3，速度模式
						GVL.siElMode := 3;
					END_IF
					IF siElMode = 3 THEN
						CASE istate OF
							0:
								GVL.bElCtrlBit1 := TRUE;
								GVL.bElCtrlBit2 := TRUE;
								icount := icount + 1;
								IF icount = 20 THEN
									icount:=0;
									istate:=1;
								END_IF
							1:
								GVL.bElCtrlBit0 := TRUE;
								icount := icount + 1;
								IF icount = 20 THEN
									icount:=0;
									istate:=2;
								END_IF
							2:
								GVL.bElCtrlBit3 := TRUE;
						END_CASE
					END_IF
				ELSE
					IF sStatus.Moving THEN
						GVL.diElTargetVel := 0;
						bElCtrlBit8 := TRUE;
					ELSE
						bElCtrlBit8 := FALSE;
					END_IF
				END_IF
			MODES.positionMode: // 远控指向模式
				IF NOT sStatus.Disabled THEN
					IF sCtrl.bStartAutoTrack THEN
						//自跟踪模式下，由误差电压直接驱动
						VelPID_1(rTarget:=sCtrl.rChanU + rRealPos,
								rFeedback:=rRealPos,
								rPosLimPositive:=sCtrl.rSoft_limit_Postive,
								rPosLimNegative:=sCtrl.rSoft_limit_Negative,
								rVelLim:=sCtrl.rVel_Limit,
								rKp:=1,//自跟踪PI系数3,0.02
								rKi:=0,
								rKd:=0,
								bPIDEnable:=sCtrl.bPIDEnable,
								iThreshold:= -1,
								rPIDOutput=&gt;sCtrl.rPIDCmdVel);							
					ELSE
						//PID计算速度指令
						VelPID_1(rTarget:=sCtrl.rPosCmd,
							rFeedback:=rRealPos,
							rVelLim:=sCtrl.Pos_Vel,
							rPosLimPositive:=sCtrl.rSoft_limit_Postive,
							rPosLimNegative:=sCtrl.rSoft_limit_Negative,
							rKp:=0.7,//程引PI系数地带：1,0.002  高带：3,0.02
							rKi:=0,
							rKd:=0,
							bPIDEnable:=sCtrl.bPIDEnable,
							iThreshold:=sCtrl.rPIDThre,
							rPIDOutput=&gt;sCtrl.rPIDCmdVel);
					END_IF
					GVL.diElTargetVel := REAL_TO_DINT(sCtrl.rPIDCmdVel * 524288 / 360);
					GVL.diElTargetAcc := REAL_TO_UDINT(9 * 524288 / 360);   //加速度
					GVL.diElTargetDec := REAL_TO_UDINT(9 * 524288 / 360);   //减速度
				END_IF
			MODES.velocityMode://手控速度模式-远控模式
				IF NOT sStatus.Disabled THEN
					IF ABS(sCtrl.rVelCmd) &lt;= sCtrl.rVel_Limit THEN
						GVL.diElTargetVel := REAL_TO_DINT(sCtrl.rVelCmd * 524288 / 360);
					ELSIF sCtrl.rVelCmd &gt; sCtrl.rVel_Limit THEN
						GVL.diElTargetVel := REAL_TO_DINT(sCtrl.rVel_Limit * 524288 / 360);
					ELSE
						GVL.diElTargetVel := REAL_TO_DINT(-sCtrl.rVel_Limit * 524288 / 360);
					END_IF
					GVL.diElTargetAcc := REAL_TO_UDINT(sCtrl.rAcceleration * 524288 / 360);   //加速度
					GVL.diElTargetDec := REAL_TO_UDINT(sCtrl.rDeceleration * 524288 / 360);   //减速度
				END_IF
			MODES.programBootMode://PID速度模式-正常模式 程引
				IF NOT sStatus.Disabled THEN
					IF sCtrl.bStartAutoTrack THEN
						(*
						//自跟踪模式下，由误差电压直接驱动
						VelPID_3(rTarget:=sCtrl.rChanU + rRealPos,
								rFeedback:=rRealPos,
								rPosLimPositive:=sCtrl.rSoft_limit_Postive,
								rPosLimNegative:=sCtrl.rSoft_limit_Negative,
								rVelLim:=sCtrl.rVel_Limit,
								rKp:=sCtrl.rP_AutoTrack,//自跟踪PI系数3,0.02
								rKi:=sCtrl.rI_AutoTrack,
								rKd:=sCtrl.rD,
								bPIDEnable:=sCtrl.bPIDEnable,
								iThreshold:= -1,
								rPIDOutput=&gt;sCtrl.rPIDCmdVel);	
								*)
						vpid1(rKpbase:=Persistentvars.rElKpBase, rKibase:=Persistentvars.rElKiBase, rKpMax:=Persistentvars.rElKpMax, rKiMax:=Persistentvars.rElKiMax, rVelThreshold:=Persistentvars.rElThre,rTarget:=sCtrl.rPIDCmdPos,rFeedback:=rRealPos,rPosLimPositive:=sCtrl.rSoft_limit_Postive,
							rPosLimNegitive:=sCtrl.rSoft_limit_Negative,
								bPIDEnable:=sCtrl.bPIDEnable,rVelLim:=sCtrl.rVel_Limit,rKpScale:=Persistentvars.rElKpscale,rKiScale:=Persistentvars.rElKiscale,rElPos:=GVL.rFctPosReal_1-90,
								iThrehold:=sCtrl.rPIDThre,rPIDOutDir=&gt;sCtrl.rPIDCmdVel);						
					ELSE
						//PID计算速度指令
						(*
						VelPID_3(rTarget:=sCtrl.rPIDCmdPos,
							rFeedback:=rRealPos,
							rVelLim:=sCtrl.rVel_Limit,
							rPosLimPositive:=sCtrl.rSoft_limit_Postive,
							rPosLimNegative:=sCtrl.rSoft_limit_Negative,
							rKp:=sCtrl.rP,//程引PI系数地带：1,0.002  高带：3,0.02
							rKi:=sCtrl.rI,
							rKd:=sCtrl.rD,
							bPIDEnable:=sCtrl.bPIDEnable,
							iThreshold:=sCtrl.rPIDThre,
							rPIDOutput=&gt;);
							*)
						vpid1(rKpbase:=Persistentvars.rElKpBase, rKibase:=Persistentvars.rElKiBase, rKpMax:=Persistentvars.rElKpMax, rKiMax:=Persistentvars.rElKiMax, rVelThreshold:=Persistentvars.rElThre,rTarget:=sCtrl.rPIDCmdPos,rFeedback:=rRealPos,rPosLimPositive:=sCtrl.rSoft_limit_Postive,
							rPosLimNegitive:=sCtrl.rSoft_limit_Negative,
								bPIDEnable:=sCtrl.bPIDEnable,rVelLim:=sCtrl.rVel_Limit,rKpScale:=Persistentvars.rElKpscale,rKiScale:=Persistentvars.rElKiscale,rElPos:=GVL.rFctPosReal_1-90,
								iThrehold:=sCtrl.rPIDThre,rPIDOutDir=&gt;sCtrl.rPIDCmdVel);
					END_IF
					GVL.diElTargetVel := REAL_TO_DINT(sCtrl.rPIDCmdVel * 524288 / 360);
					GVL.diElTargetAcc := REAL_TO_UDINT(sCtrl.rAcceleration * 524288 / 360);   //加速度
					GVL.diElTargetDec := REAL_TO_UDINT(sCtrl.rDeceleration * 524288 / 360);   //减速度
				END_IF
			MODES.reset://重置
				IF NOT sStatus.Disabled THEN
					IF sStatus.Moving THEN
						GVL.diElTargetVel := 0;
						bElCtrlBit8 := TRUE;
					ELSE
						bElCtrlBit8 := FALSE;
					END_IF
				END_IF
			MODES.halt://待机
				IF NOT sStatus.Disabled THEN
					IF sStatus.Moving THEN
						GVL.diElTargetVel := 0;
						bElCtrlBit8 := TRUE;
					ELSE
						bElCtrlBit8 := FALSE;
					END_IF
				END_IF
			
		END_CASE
	ELSE // 本控
		IF sLocal.iMode &lt;&gt; 1 THEN
			istate:=0;
			icount:=0;
		END_IF
		CASE sLocal.iMode OF
			MODES.powerOff: // 下电
				IF NOT sStatus.Disabled THEN
					IF sStatus.Moving THEN // 运动中，先停止运动
						GVL.diElTargetVel := 0;
						bElCtrlBit8 := TRUE;
					ELSE
						// 写入下电控制字
						GVL.bElCtrlBit3 := FALSE;
						GVL.bElCtrlBit0 := FALSE;
						GVL.bElCtrlBit1 := FALSE;
						GVL.bElCtrlBit2 := FALSE;
					END_IF
				END_IF
			MODES.powerOn:  // 上电
				IF sStatus.Disabled THEN
					// 目标速度清零
					GVL.diElTargetVel := 0;
					IF GVL.siElMode &lt;&gt; 3 THEN // 上电时模式默认为3，速度模式
						GVL.siElMode := 3;
					END_IF
					IF siElMode = 3 THEN
						
						
						
						CASE istate OF
							0:
								GVL.bElCtrlBit1 := TRUE;
								GVL.bElCtrlBit2 := TRUE;
								icount := icount + 1;
								IF icount = 20 THEN
									icount:=0;
									istate:=1;
								END_IF
							1:
								GVL.bElCtrlBit0 := TRUE;
								icount := icount + 1;
								IF icount = 20 THEN
									icount:=0;
									istate:=2;
								END_IF
							2:
								GVL.bElCtrlBit3 := TRUE;
						END_CASE
					END_IF
				ELSE
					IF sStatus.Moving THEN
						GVL.diElTargetVel := 0;
						bElCtrlBit8 := TRUE;
					ELSE
						bElCtrlBit8 := FALSE;
					END_IF
				END_IF
			MODES.velocityMode://手控速度模式-本控模式
				IF NOT sStatus.Disabled THEN
					IF ABS(sLocal.rVelCmd) &lt;= sLocal.rVel_Limit THEN
						GVL.diElTargetVel := REAL_TO_DINT(sLocal.rVelCmd * 524288 / 360);
					ELSIF sLocal.rVelCmd &gt; sLocal.rVel_Limit THEN
						GVL.diElTargetVel := REAL_TO_DINT(sLocal.rVel_Limit * 524288 / 360);
					ELSE
						GVL.diElTargetVel := REAL_TO_DINT(-sLocal.rVel_Limit * 524288 / 360);
					END_IF
					GVL.diElTargetAcc := REAL_TO_UDINT(sLocal.rAcceleration * 524288 / 360);   //加速度
					GVL.diElTargetDec := REAL_TO_UDINT(sLocal.rDeceleration * 524288 / 360);   //减速度
				END_IF
			MODES.programBootMode://本控位置模式
				IF NOT sStatus.Disabled THEN
					IF NOT sLocal.bPIDEnable THEN
						GVL.diElTargetVel := 0;							
					ELSE
						IF NOT slocal.bStartAutoTrack THEN
							//PID计算速度指令
							 VelPID_2(rTarget:=sLocal.rPosCmd,
									 rFeedback:=rRealPos,
									 rPosLimPositive:=sLocal.rSoft_limit_Postive,//软限位
									 rPosLimNegative:=sLocal.rSoft_limit_Negative,
									 rKp:=0.7,
									 rKi:=0,
									 rKd:=0,
									 iThreshold:=sLocal.rPIDThre,
									 bPIDEnable:=sLocal.bPIDEnable,
									 rVelLim:=sLocal.Pos_Vel,
									 rPIDOutput=&gt;sLocal.rPIDCmdVel);//普通PID
						ELSE
							 VelPID_2(rTarget:=sLocal.rChanU + rRealPos,
								rFeedback:=rRealPos,
								rPosLimPositive:=sLocal.rSoft_limit_Postive,
								rPosLimNegative:=sLocal.rSoft_limit_Negative,
								rVelLim:=sLocal.rVel_Limit,
								rKp:=1,//自跟踪PI系数3,0.02
								rKi:=0,
								rKd:=0,
								bPIDEnable:=sLocal.bPIDEnable,
								iThreshold:= -1,
								rPIDOutput=&gt;sLocal.rPIDCmdVel);
						END_IF
						
					END_IF
					GVL.diElTargetVel := REAL_TO_DINT(sLocal.rPIDCmdVel * 524288 / 360);
					GVL.diElTargetAcc := REAL_TO_UDINT(9 * 524288 / 360);   //加速度
					GVL.diElTargetDec := REAL_TO_UDINT(9 * 524288 / 360);   //减速度
				END_IF
			MODES.reset://重置
			// 是否需要
			MODES.halt://待机
				IF NOT sStatus.Disabled THEN
					IF sStatus.Moving THEN
						GVL.diElTargetVel := 0;
						bElCtrlBit8 := TRUE;
					ELSE
						bElCtrlBit8 := FALSE;
					END_IF
				END_IF
			
		END_CASE
	END_IF
ELSIF GVL.Error_code&lt;&gt;0 AND GVL.eElErrorcode = 0 AND NOT GVL.bElCtrlBit7  AND NOT tr AND NOT bfin1 AND NOT bfin2 THEN
	// 出现错误，轴停止运动
	GVL.diElTargetVel := 0;
	bElCtrlBit8 := TRUE;
	TON_0(IN:=bElCtrlBit8,PT:=T#1S,Q=&gt;,ET=&gt;);//判断stop0执行是否超时,若超时强制下电（手动复位）
	IF TON_0.Q THEN
		bTick:=TRUE;
	END_IF
	IF bTick AND sStatus.Moving THEN // 超时强制下电
		// 写入下电控制字
		GVL.bElCtrlBit3 := FALSE;
		GVL.bElCtrlBit0 := FALSE;
		GVL.bElCtrlBit1 := FALSE;
		GVL.bElCtrlBit2 := FALSE;
	END_IF
END_IF</Single>
            <Single Name="LineInfoPersistence" Type="string">b4c049e8-551d-466c-bbf6-cfd36e03c6f4_Impl_LineIds</Single>
          </Single>
        </Single>
        <Single Name="Interface" Type="{a9ed5b7e-75c5-4651-af16-d2c27e98cb94}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">FUNCTION_BLOCK El_Ctrl_FB
VAR_INPUT
	sLocal:AxisCrtlStruct;
	sCtrl:AxisCrtlStruct;
	sStatus:AxisStatus;
	sVisible:AxisVisible;
	rRealPos:REAL;
	rPosLimK:REAL;
END_VAR
VAR_OUTPUT
	logicError:INT;
END_VAR
VAR
	VelPID_1:PID;
	VelPID_2:PID;
	VelPID_3:PID;
	vpid1:vpid;
	TON_0:TON;
	bTick:BOOL;
	tr:BOOL;
	icount1:INT := 0;
	icount2:INT := 0;
	icount3:INT := 0;
	bfin1:BOOL;
	bfin2:BOOL;
	istate:INT:=0;
	icount:INT:=0;
END_VAR</Single>
            <Single Name="LineInfoPersistence" Type="string">b4c049e8-551d-466c-bbf6-cfd36e03c6f4_Decl_LineIds</Single>
          </Single>
        </Single>
        <Single Name="UniqueIdGenerator" Type="string">448</Single>
        <Single Name="POULevel" Type="{8e575c5b-1d37-49c6-941b-5c0ec7874787}">Standard</Single>
        <List Name="ChildObjectGuids" Type="System.Collections.ArrayList" />
        <Single Name="AddAttributeSubsequent" Type="bool">False</Single>
      </Single>
      <Single Name="ParentSVNodeGuid" Type="System.Guid">49085721-e2f3-443d-be92-6caf07f84b13</Single>
      <Array Name="Path" Type="string">
        <Single Type="string">Device</Single>
        <Single Type="string">PLC逻辑</Single>
        <Single Type="string">Application</Single>
      </Array>
      <Single Name="Index" Type="int">-1</Single>
    </Single>
    <Single Type="{6198ad31-4b98-445c-927f-3258a0e82fe3}" Method="IArchivable">
      <Single Name="IsRoot" Type="bool">False</Single>
      <Single Name="MetaObject" Type="{81297157-7ec9-45ce-845e-84cab2b88ade}" Method="IArchivable">
        <Single Name="Guid" Type="System.Guid">606036f3-9e29-4a9f-a89f-c2eaefee70cf</Single>
        <Single Name="ParentGuid" Type="System.Guid">49085721-e2f3-443d-be92-6caf07f84b13</Single>
        <Single Name="Name" Type="string">El_ctrl_1</Single>
        <Dictionary Type="{2c41fa04-1834-41c1-816e-303c7aa2c05b}" Name="Properties" />
        <Single Name="TypeGuid" Type="System.Guid">6f9dac99-8de1-4efc-8465-68ac443b7d08</Single>
        <Array Name="EmbeddedTypeGuids" Type="System.Guid">
          <Single Type="System.Guid">a9ed5b7e-75c5-4651-af16-d2c27e98cb94</Single>
          <Single Type="System.Guid">3b83b776-fb25-43b8-99f2-3c507c9143fc</Single>
        </Array>
        <Single Name="Timestamp" Type="long">639243863053279963</Single>
      </Single>
      <Single Name="Object" Type="{6f9dac99-8de1-4efc-8465-68ac443b7d08}" Method="IArchivable">
        <Single Name="SpecialFunc" Type="{0db3d7bb-cde0-4416-9a7b-ce49a0124323}">None</Single>
        <Single Name="Implementation" Type="{3b83b776-fb25-43b8-99f2-3c507c9143fc}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">(*
//远控轴参量赋值
Axis1Remote.iMode:=Modbus_Slave.iMode_1;
Axis1Remote.rVelCmd:=Modbus_Slave.rVelcmd_1;
Axis1Remote.rPosCmd:=Modbus_Slave.rPosCmd_1;
Axis1Remote.rP:=Modbus_Slave.rP_1;
Axis1Remote.rI:=Modbus_Slave.rI_1;
Axis1Remote.rD:=Modbus_Slave.rD_1;
Axis1Remote.rPIDThre:=Modbus_Slave.rThreshold_1;
Axis1Remote.rAcceleration:=Modbus_Slave.rAcceleration_1;
Axis1Remote.rDeceleration:=Modbus_Slave.rDeceleration_1;
Axis1Remote.rVel_Limit:=Modbus_Slave.rVelLim_1;
*)
// 方位状态写入
Axis1Status.Error := GVL.bElStsBit3;
Axis1Status.ErrorID := GVL.eElErrorcode;
Axis1Status.bServo_Enable := GVL.bElStsBit0 AND GVL.bElStsBit1 AND GVL.bElStsBit2;
Axis1Status.bBrake := NOT (GVL.bElStsBit0 AND GVL.bElStsBit1 AND GVL.bElStsBit2);
Axis1Status.Disabled := NOT (GVL.bElStsBit0 AND GVL.bElStsBit1 AND GVL.bElStsBit2);
Axis1Remote.rSoft_limit_Negative:=93;Axis1Remote.rSoft_limit_Postive:=180;
Axis1Local.rSoft_limit_Negative:=93;Axis1Local.rSoft_limit_Postive:=180;

//速度的写入
rFctVelReal_1:=DINT_TO_REAL(diElActVel)/524288.0*360.0;
//位置的写入，方位0对应编码器0，所以实际方位是：-1*编码器值
//rFctPosReal_1:=DINT_TO_REAL(diElActPos)/524288.0*360.0 + 5.339;
rFctPosReal_1:=DINT_TO_REAL(diElActPos)/524288.0*360.0 + modbus_slave.lrElOffset;
//软限位控制
Axis1Limit_pos:=180;
Axis1Limit_Neg:=93;
IF Axis1Remote.rPosCmd&gt;Axis1Limit_pos THEN
	Axis1Remote.rPosCmd:=180;
ELSIF Axis1Remote.rPosCmd&lt;Axis1Limit_Neg THEN
	 Axis1Remote.rPosCmd:=93;  
END_IF

IF Axis1Local.rPosCmd&gt;Axis1Limit_pos THEN
	Axis1Local.rPosCmd:=180;
ELSIF Axis1Local.rPosCmd&lt;Axis1Limit_Neg THEN
	 Axis1Local.rPosCmd:=93;  
END_IF

//停止标志符号判断
IF  ABS(rFctVelReal_1)&lt;0.035 THEN
	Stop1_Count:=Stop1_Count+1;
	IF Stop1_Count&gt;100 THEN
		Stop1_Count:=101;
		bStop_1:=TRUE;;
	END_IF
ELSE
	Stop1_Count:=0;
	bStop_1:=FALSE;
END_IF
Axis1Status.Moving := NOT bStop_1;
//PID使能赋值
IF Axis1Remote.iMode=2 OR Axis1Remote.iMode=4 THEN
	Axis1Remote.bPIDEnable:=TRUE;
ELSE
	Axis1Remote.bPIDEnable:=FALSE;
END_IF

//本远控逻辑保护
//远控切本控逻辑保护
bRTriger(CLK:=GVL.bLocalCtrl);
bFTriger(CLK:=GVL.bLocalCtrl);

IF Axis1Status.bServo_Enable AND (bRTriger.Q ) THEN//如果速度不为0且本控发生切换，则减速停止标识为True
	bRemote2LocalStop:=TRUE;
END_IF
IF bRemote2LocalStop  THEN //若减速停止标识符为True 
	
	IF  bStop_1=TRUE THEN//且电机速度不为0 开始减速 减速完成后下使能，下使能完成后复位标识符复位
		Axis1Local.iMode:=0;
		Axis1Remote.iMode:=0;
		IF Axis1Status.bServo_Enable=FALSE THEN
			bRemote2LocalStop:=FALSE;
		END_IF
	ELSE
		Axis1Local.iMode:=7;
		Axis1Remote.iMode:=7;
	END_IF
END_IF

//本控切远控
IF Axis1Status.bServo_Enable AND (bFTriger.Q ) THEN//如果速度不为0且本控发生切换，则减速停止标识为True
	bLocal2RemoteStop:=TRUE;
END_IF
IF bLocal2RemoteStop  THEN //若减速停止标识符为True 
	
	IF  bStop_1=TRUE THEN//且电机速度不为0 开始减速 减速完成后下使能，下使能完成后复位标识符复位
		Axis1Local.iMode:=0;
		Axis1Remote.iMode:=0;
		IF Axis1Status.bServo_Enable=FALSE THEN
			bLocal2RemoteStop:=FALSE;
		END_IF
	ELSE
		Axis1Remote.iMode:=7;
		Axis1Local.iMode:=7;
	END_IF
END_IF
(*
//自跟踪
IF GVL.bStartTrack THEN
	Axis1Remote.bStartAutoTrack := TRUE;
	Axis1Remote.rChanU := AutoTrackingCal.rChanUe;
ELSE
	Axis1Remote.bStartAutoTrack := FALSE;	
	Axis1Remote.rChanU := 0;
END_IF
*)
IF Axis1Remote.iMode=2 THEN
			IF GVL.Chan1AGC&gt;=(GVL.Chanthreshold-0.1) THEN
					agcmaxsearch_pb(bstart:=Az_ctrl_1.agcmaxsearch_tb.bSucess,rAGCNow:=GVL.Chan1AGC,btrig:=Az_ctrl_1.bstartSearchEl,
						rCurrentPos:=rFctPosReal_1,rInterPos:=Axis1Remote.rPosCmd,
				//rOutStepBias:=rStepBias,	
				rStepBiasNow:=rStepBias,bAutoTracking:=GVL.bStartTrack,bStop:=FALSE,
				rStepBias=&gt;rSearchNextStepTarget_tb,rAGCMaxBias=&gt;rMaxPosTest,bSucess=&gt;);
			ELSE
				bstartagcmaxsearch:=FALSE;
				agcmaxsearch_pb(bstart:=Az_ctrl_1.agcmaxsearch_tb.bSucess,rAGCNow:=GVL.Chan1AGC,btrig:=Az_ctrl_1.bstartSearchEl,
				rCurrentPos:=rFctPosReal_1,rInterPos:=Axis1Remote.rPosCmd,
				//rOutStepBias:=rStepBias,
				rStepBiasNow:=rStepBias,bAutoTracking:=GVL.bStartTrack,bStop:=FALSE,
				rStepBias=&gt;rSearchNextStepTarget_tb,rAGCMaxBias=&gt;rMaxPosTest,bSucess=&gt;);
			END_IF
		ELSIF Axis1Remote.iMode=4 AND rFctPosReal_1-90&gt;rElthreshold  THEN
			IF GVL.Chan1AGC&gt;=(GVL.Chanthreshold-0.1) THEN
					agcmaxsearch_pb(bstart:=Az_ctrl_1.agcmaxsearch_pb.bSucess,rAGCNow:=GVL.Chan1AGC,btrig:=Az_ctrl_1.bstartSearchEl,
						rCurrentPos:=rFctPosReal_1,rInterPos:=RealTimePosCal.rInterElPos,
				//rOutStepBias:=rStepBias,	
				rStepBiasNow:=rStepBias,bAutoTracking:=GVL.bStartTrack,bStop:=FALSE,
				rStepBias=&gt;rSearchNextStepTarget,rAGCMaxBias=&gt;rMaxPosTest,bSucess=&gt;);
			ELSE
				bstartagcmaxsearch:=FALSE;
				agcmaxsearch_pb(bstart:=Az_ctrl_1.agcmaxsearch_pb.bSucess,rAGCNow:=GVL.Chan1AGC,btrig:=Az_ctrl_1.bstartSearchEl,
				rCurrentPos:=rFctPosReal_1,rInterPos:=RealTimePosCal.rInterElPos,
				//rOutStepBias:=rStepBias,
				rStepBiasNow:=rStepBias,bAutoTracking:=GVL.bStartTrack,bStop:=FALSE,
				rStepBias=&gt;rSearchNextStepTarget,rAGCMaxBias=&gt;rMaxPosTest,bSucess=&gt;);
			END_IF
			//把rSearchNextStepTarget附加到AzCtrl.rPIDCmdPos上
		ELSIF Axis1Remote.iMode =0  OR Axis1Remote.iMode =7 THEN
			bstartagcmaxsearch:=FALSE;
			//rSearchNextStepTarget:=0;
			agcmaxsearch_pb(bstart:=Az_ctrl_1.agcmaxsearch_pb.bSucess,rAGCNow:=GVL.Chan1AGC,btrig:=Az_ctrl_1.bstartSearchEl,
			rCurrentPos:=rFctPosReal_1,rInterPos:=RealTimePosCal.rInterElPos,	
			//rOutStepBias:=rStepBias,
			rStepBiasNow:=rStepBias,bAutoTracking:=GVL.bStartTrack,bStop:=FALSE,
			rStepBias=&gt;rSearchNextStepTarget,rAGCMaxBias=&gt;rMaxPosTest,bSucess=&gt;);
		END_IF
// 程引模式下自跟踪拉偏
IF GVL.bStartTrack AND Axis1Remote.iMode=4 THEN
	Axis1Remote.bStartAutoTrack := TRUE;
	IF rAuToStepBias &gt; rAutoTrackingBiasMax THEN
		rAuToStepBias := rAutoTrackingBiasMax;
	ELSIF rAuToStepBias &lt; -rAutoTrackingBiasMax THEN
		rAuToStepBias := -rAutoTrackingBiasMax;
	ELSE
		rAuToStepBiasTemp:=0.02*AutoTrackingCal.rDirSenFac*AutoTrackingCal.rChanUe;
		rAuToStepBias:=rAuToStepBias+AutoTrackingCal.rDirSenFac*rKAuToStepBias*AutoTrackingCal.rChanUe/1000.0;
	END_IF
ELSIF NOT GVL.bStartTrack AND Axis1Remote.iMode=4 THEN
	IF 	rAuToStepBias&gt;0 THEN//关闭自跟踪后自跟踪拉偏量逐渐归0
		rAuToStepBias:=rAuToStepBias-rAutoStep;
	ELSIF rAuToStepBias&lt;0 THEN
		rAuToStepBias:=rAuToStepBias+rAutoStep;
	ELSE
		rAuToStepBias:=0;
	END_IF
	
	IF Modbus_Slave.rBias_1&gt;rStepBias THEN
		rStepBias:=rStepBias+rStep;
		IF rStepBias&gt;=Modbus_Slave.rBias_1 THEN
			rStepBias:=Modbus_Slave.rBias_1;
		END_IF
	ELSIF Modbus_Slave.rBias_1&lt;rStepBias THEN
		rStepBias:=rStepBias-rStep;
		IF rStepBias&lt;=Modbus_Slave.rBias_1 THEN
			rStepBias:=Modbus_Slave.rBias_1;
		END_IF
	END_IF
	rAuToStepBiasTemp:=0;
ELSIF GVL.bStartTrack AND Axis1Remote.iMode=2 THEN
	Axis1Remote.bStartAutoTrack := TRUE;
	Axis1Remote.rChanU := AutoTrackingCal.rChanUe;
ELSE
	Axis1Remote.bStartAutoTrack := FALSE;	
	rAuToStepBias:=0;
	rStepBias:=0;
	rAuToStepBiasTemp:=0;
END_IF

//本控自跟踪
IF GVL.bStartLocalAutoTrack AND Axis1Local.iMode = 4 THEN
	Axis1Local.bStartAutoTrack := TRUE;
	Axis1Local.rChanU := AutoTrackingCal.rChanUeLocal;
ELSE
	Axis1Local.bStartAutoTrack := FALSE;
END_IF

//拉偏
Axis1Remote.rPIDCmdPos:=RealTimePosCal.rInterElPos+rStepBias+rAuToStepBias+rSearchNextStepTarget+SECURITYCHECK.el_out+rAuToStepBiasTemp;
//限位
IF Axis1Remote.rPIDCmdPos&lt;93 THEN
	Axis1Remote.rPIDCmdPos:=93;
ELSIF Axis1Remote.rPIDCmdPos&gt;180 THEN
	Axis1Remote.rPIDCmdPos:=180;
END_IF

Axis1_Ctrl(sLocal:=Axis1Local, sCtrl:=Axis1Remote, sStatus:=Axis1Status, sVisible:=Axis1Visible, rRealPos:=rFctPosReal_1, rPosLimK:=0.34);</Single>
            <Single Name="LineInfoPersistence" Type="string">606036f3-9e29-4a9f-a89f-c2eaefee70cf_Impl_LineIds</Single>
          </Single>
        </Single>
        <Single Name="Interface" Type="{a9ed5b7e-75c5-4651-af16-d2c27e98cb94}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">PROGRAM El_ctrl_1
VAR
    Axis1_Ctrl : El_Ctrl_FB;
    bRemote2LocalStop : BOOL;
    bLocal2RemoteStop : BOOL;
    Error : INT;
    Axis1Limit_pos : REAL;
    Axis1Limit_Neg : REAL;
    bRTriger : Standard.R_TRIG;
    bFTriger : Standard.F_TRIG;
    Stop1_Count : INT;
    bStop_1 : BOOL;
    rPosModeStepBias : LREAL;
    rPosModeStep : LREAL := 0.005;
    rStepBiasMax : LREAL := 2;
    rStepBias : LREAL;
    rStep : LREAL := 0.002;
    rAuToStepBias : LREAL;
    rAuToStepBiasTemp : LREAL;
    rAutoStep : LREAL := 0.01;
    TbAutoTrigger : Standard.F_TRIG;
    RbAutoTrigger : Standard.R_TRIG;
    rAutoTrackingBiasMax : LREAL := 6;
    rLocalInitPosModeSpeed : REAL;
    rRemoteInitPosModeSpeed : REAL;
    iCountOffAuto : INT;
    iCasePBAutoTrack : INT := 2;
    rKAuToStepBias : LREAL := 0.45; // 对齐2.4
    agcmaxsearch_tb : AGCMaxSearch_PB_1;
    rSearchNextStepTarget_tb : REAL;
    agcmaxsearch_pb : AGCMaxSearch_PB_1;
    rElthreshold : REAL := 4.2;
    toN1 : Standard.Ton;
    ttime1 : TIME := T#200mS;
    bstartagcmaxsearch : BOOL;
    rSearchNextStepTarget : REAL;
    rMaxPosTest : REAL;
END_VAR</Single>
            <Single Name="LineInfoPersistence" Type="string">606036f3-9e29-4a9f-a89f-c2eaefee70cf_Decl_LineIds</Single>
          </Single>
        </Single>
        <Single Name="UniqueIdGenerator" Type="string">349</Single>
        <Single Name="POULevel" Type="{8e575c5b-1d37-49c6-941b-5c0ec7874787}">Standard</Single>
        <List Name="ChildObjectGuids" Type="System.Collections.ArrayList" />
        <Single Name="AddAttributeSubsequent" Type="bool">False</Single>
      </Single>
      <Single Name="ParentSVNodeGuid" Type="System.Guid">49085721-e2f3-443d-be92-6caf07f84b13</Single>
      <Array Name="Path" Type="string">
        <Single Type="string">Device</Single>
        <Single Type="string">PLC逻辑</Single>
        <Single Type="string">Application</Single>
      </Array>
      <Single Name="Index" Type="int">-1</Single>
    </Single>
    <Single Type="{6198ad31-4b98-445c-927f-3258a0e82fe3}" Method="IArchivable">
      <Single Name="IsRoot" Type="bool">False</Single>
      <Single Name="MetaObject" Type="{81297157-7ec9-45ce-845e-84cab2b88ade}" Method="IArchivable">
        <Single Name="Guid" Type="System.Guid">01e0f185-d49a-4d6d-9268-6e70a0d1342e</Single>
        <Single Name="ParentGuid" Type="System.Guid">49085721-e2f3-443d-be92-6caf07f84b13</Single>
        <Single Name="Name" Type="string">SecurityCheck</Single>
        <Dictionary Type="{2c41fa04-1834-41c1-816e-303c7aa2c05b}" Name="Properties" />
        <Single Name="TypeGuid" Type="System.Guid">6f9dac99-8de1-4efc-8465-68ac443b7d08</Single>
        <Array Name="EmbeddedTypeGuids" Type="System.Guid">
          <Single Type="System.Guid">a9ed5b7e-75c5-4651-af16-d2c27e98cb94</Single>
          <Single Type="System.Guid">3b83b776-fb25-43b8-99f2-3c507c9143fc</Single>
        </Array>
        <Single Name="Timestamp" Type="long">639245654368997739</Single>
      </Single>
      <Single Name="Object" Type="{6f9dac99-8de1-4efc-8465-68ac443b7d08}" Method="IArchivable">
        <Single Name="SpecialFunc" Type="{0db3d7bb-cde0-4416-9a7b-ce49a0124323}">None</Single>
        <Single Name="Implementation" Type="{3b83b776-fb25-43b8-99f2-3c507c9143fc}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">
// --- implementation (ST) ---
// =============================================================================
// 段 1: 安全逻辑用位置（与显示用 rFctPosReal 可能差符号/零点）
// =============================================================================
rAz_realpos := -1 * GVL.rFctPosReal_2;
rEl_realpos := GVL.rFctPosReal_1 - 90;

// =============================================================================
// 段 2: 三轴伺服电流监测（仅使能时读 AD，%IW×%ID/1e6）
// %IW10/%ID4=俯仰, %IW20/%ID9=方位, %IW30/%ID14=倾斜
// =============================================================================
IF Axis1Status.bServo_Enable THEN
	rELCurrent:=DINT_TO_REAL((INT_TO_DINT(%IW10)* %ID4))/1000000.0;  //俯仰轴电流监测
ELSE
	rELCurrent:=0;
END_IF

IF Axis2Status.bServo_Enable THEN
	rAzCurrent:=DINT_TO_REAL((INT_TO_DINT(%IW20)* %ID9))/1000000.0;  //方位轴电流监测
ELSE
	rAzCurrent:=0;
END_IF

IF Axis3Status.bServo_Enable THEN
	rTlCurrent:=DINT_TO_REAL((INT_TO_DINT(%IW30)* %ID14))/1000000.0;  //倾斜轴电流监测
ELSE
	rTlCurrent:=0;
END_IF

// =============================================================================
// 段 3: 跟踪误差（供 SpiralScan 判断扫描方向与完成度）
// mode2 指向: 命令位置 vs 实际位置
// mode4 程引: 插值目标+偏置 vs 实际位置（含手动/自跟踪偏置）
// =============================================================================
IF Axis2Remote.iMode = 2 THEN
	AzError:=(-1) * (Axis2Remote.rPosCmd-rFctPosReal_2);
	ElError:=Axis1Remote.rPosCmd-rFctPosReal_1;	
END_IF

IF Axis2Remote.iMode = 4 THEN
	AzError:=rFctPosReal_2-RealTimePosCal.rInterazPos-(az_ctrl_1.rStepBias+az_ctrl_1.rAuToStepBias);
	ElError:=RealTimePosCal.rInterElPos-rFctPosReal_1+ (El_ctrl_1.rStepBias+EL_ctrl_1.rAuToStepBias);
END_IF
(*
rAzErrorReal := rAzErrorReal + rAlpha * (AzError - rAzErrorReal);
rElErrorReal := rElErrorReal + rAlpha * (ElError - rElErrorReal);
*)

// =============================================================================
// 段 4: 远控故障复位（Modbus bCommReset → GVL.bError_Reset）
// =============================================================================
IF NOT GVL.bLocalCtrl THEN
	IF Modbus_Slave.bCommReset THEN
		GVL.bError_Reset:=TRUE;
	ELSE
		GVL.bError_Reset:=FALSE;
	END_IF
END_IF

// =============================================================================
// 段 5: 远控 rPosCmd 赋值（含 AGC 搜索偏置或测试扫描偏置）
// 非 bSearch: Modbus 目标 + eltest/aztest
// bSearch:   Modbus 目标 + *_ctrl_1 的 rSearchNextStepTarget_tb
// =============================================================================
IF NOT modbus_slave.bSearch THEN
	Axis1Remote.rPosCmd:=Modbus_Slave.rPosCmd_1 + eltest;
	Axis2Remote.rPosCmd:=Modbus_Slave.rPosCmd_2 - aztest;
ELSE
	Axis1Remote.rPosCmd:=Modbus_Slave.rPosCmd_1 + El_ctrl_1.rSearchNextStepTarget_tb;
	Axis2Remote.rPosCmd:=Modbus_Slave.rPosCmd_2 + Az_ctrl_1.rSearchNextStepTarget_tb;
END_IF

// =============================================================================
// 段 6: 远控三轴命令参量 — Modbus_Slave → AxisXRemote（核心汇总）
// 俯仰/方位 rPosCmd 已在段 5 赋值；此处写 mode/速度/PID/加减速等
// =============================================================================
Axis1Remote.iMode:=Modbus_Slave.iMode_1;
Axis1Remote.rVelCmd:=Modbus_Slave.rVelcmd_1;
//Axis1Remote.rPosCmd:=Modbus_Slave.rPosCmd_1;
Axis1Remote.rP:=Modbus_Slave.rP_1;
Axis1Remote.rI:=Modbus_Slave.rI_1;
Axis1Remote.rD:=Modbus_Slave.rD_1;
Axis1Remote.rPIDThre:=Modbus_Slave.rThreshold_1;
Axis1Remote.rAcceleration:=Modbus_Slave.rAcceleration_1;
Axis1Remote.rDeceleration:=Modbus_Slave.rDeceleration_1;
Axis1Remote.rVel_Limit:=Modbus_Slave.rVelLim_1;

Axis2Remote.iMode:=Modbus_Slave.iMode_2;
Axis2Remote.rVelCmd:=Modbus_Slave.rVelcmd_2;
//Axis2Remote.rPosCmd:=Modbus_Slave.rPosCmd_2;
Axis2Remote.rP:=Modbus_Slave.rP_2;
Axis2Remote.rI:=Modbus_Slave.rI_2;
Axis2Remote.rD:=Modbus_Slave.rD_2;
Axis2Remote.rPIDThre:=Modbus_Slave.rThreshold_2;
Axis2Remote.rAcceleration:=Modbus_Slave.rAcceleration_2;
Axis2Remote.rDeceleration:=Modbus_Slave.rDeceleration_2;
Axis2Remote.rVel_Limit:=Modbus_Slave.rVelLim_2;

Axis3Remote.iMode:=Modbus_Slave.iMode_3;
Axis3Remote.rVelCmd:=Modbus_Slave.rVelcmd_3;
Axis3Remote.rPosCmd:=Modbus_Slave.rPosCmd_3;
Axis3Remote.rP:=Modbus_Slave.rP_3;
Axis3Remote.rI:=Modbus_Slave.rI_3;
Axis3Remote.rD:=Modbus_Slave.rD_3;
Axis3Remote.rPIDThre:=Modbus_Slave.rThreshold_3;
Axis3Remote.rAcceleration:=Modbus_Slave.rAcceleration_3;
Axis3Remote.rDeceleration:=Modbus_Slave.rDeceleration_3;

(* 本控 HMI 赋值块已注释，本控参数由其他 POU 写入 AxisXLocal *)

// =============================================================================
// 段 7: 俯仰预限位 → Error_code 201(正)/202(负)，置位上报标志
// bPrelimit_1 由硬件 IO 映射；触发后根据当前位置方向区分正负限位
// =============================================================================
IF bPrelimit_1 THEN
	IF rFctPosReal_1&gt;0 THEN
		bPrelimit_Positive_1:=TRUE;
		Error_code:=201;
	ELSE
		bPrelimit_Negative_1:=TRUE;
		Error_code:=202;
	END_IF;
ELSE
	bPrelimit_Negative_1:=FALSE;
	bPrelimit_Positive_1:=FALSE;
	;
END_IF

// =============================================================================
// 段 8: 方位预限位（仅置标志，Error_code 203/204 已注释）
// =============================================================================
IF bPrelimit_2 THEN
	IF rFctPosReal_2&gt;0 THEN
		//Error_code:=203;
		bPrelimit_Positive_2:=TRUE;;
	ELSE
		//Error_code:=204;
		bPrelimit_Negative_2:=TRUE;;
	END_IF;
ELSE
	bPrelimit_Negative_2:=FALSE;
	bPrelimit_Positive_2:=FALSE;
	;
END_IF

// =============================================================================
// 段 9: 扫描找到中心 — 基带锁 且 Eb/N0&gt;rEbN0LockThre 且 √(Ua²+Ue²)&lt;=rErrorThre
// =============================================================================
bBaseLock := (READ_485.recBuf[1] = 1);
bErrorLock  := (SQRT(GVL.Chan1Ua * GVL.Chan1Ua + GVL.Chan1Ue * GVL.Chan1Ue) &lt;= PersistentVars.rErrorThre);
bLockSearch := (READ_485.Chan1EB_N0 &gt; PersistentVars.rEbN0LockThre) AND bBaseLock AND bErrorLock;

// =============================================================================
// 段 10: 启扫 — 双轴程引、未自跟踪、基带锁连续 2s（200×10ms）触发一次
// 扫描过程中允许短暂掉锁；找到合格点后本程引周期内不再重扫
// 退出程引则清锁存
// =============================================================================
IF Axis1Remote.iMode = 4 AND Axis2Remote.iMode = 4 THEN
	IF NOT GVL.bStartTrack AND NOT bScanRun AND NOT bScanFound THEN
		IF bBaseLock THEN
			icountBaseLock := icountBaseLock + 1;
			IF icountBaseLock &gt;= 200 THEN
				icountBaseLock := 200;
				bScanRun := TRUE;
			END_IF
		ELSE
			icountBaseLock := 0;
		END_IF
	ELSE
		icountBaseLock := 0;
	END_IF
	enable := bScanRun AND NOT GVL.bStartTrack;
ELSE
	enable := FALSE;
	bScanRun := FALSE;
	bScanDoneOnce := FALSE;
	bScanFound := FALSE;
	az_latch := 0.0;
	el_latch := 0.0;
	icountBaseLock := 0;
END_IF

// 螺旋局部参数（与直线 PersistentVars.rStep 量纲不同：此处为每格周期数）
IF rdelta &lt; 1.0E-6 THEN
	rdelta := 0.25;
END_IF
IF rStep &lt; 1.0E-6 THEN
	rStep := 12.0;
END_IF

// =============================================================================
// 段 11: 调用扫描 FB — 直线或螺旋；locked=找到中心，连续10拍（约100ms）锁存
// =============================================================================
IF NOT PersistentVars.bSearchType THEN
	fbScan(
		enable      := enable,
		delta       := PersistentVars.rAzScanRange,
		delta1      := PersistentVars.rElScanRange,
		n_steps     := PersistentVars.rStep,
		agc      := READ_485.Chan1EB_N0,
		locked     := bLockSearch,
		AzError := AzError,
		elError := elError,
		bTrackState := GVL.bStartTrack,
		azimuth     =&gt; az_out,
		elevation   =&gt; el_out,
		done        =&gt; done_out,
		bType  =&gt;bType_out
	);
ELSE
	fbScan1(
		enable      := enable,
		delta       := rdelta,
		n_steps     := rStep,
		agc      := READ_485.Chan1EB_N0,
		locked     := bLockSearch,
		AzError := AzError,
		elError := elError,
		azimuth     =&gt; az_out,
		elevation   =&gt; el_out,
		done        =&gt; done_out,
		bType  =&gt;bType_out
	);
END_IF

// 扫描结束：找到则锁存 -Error；未找到锁存 0。此后 az_out/el_out 用锁存值
IF bScanRun AND done_out THEN
	bScanRun := FALSE;
	bScanDoneOnce := TRUE;
	IF bType_out THEN
		az_latch := az_out;
		el_latch := el_out;
		bScanFound := TRUE;
	ELSE
		az_latch := 0.0;
		el_latch := 0.0;
		bScanFound := FALSE;
	END_IF
END_IF
IF GVL.bStartTrack AND bScanRun THEN
	bScanRun := FALSE;
	bScanDoneOnce := TRUE;
END_IF
IF NOT bScanRun THEN
	az_out := az_latch;
	el_out := el_latch;
END_IF

// =============================================================================
// 段 12: 自跟踪只跟 ACU HR[7].B10（上升沿开、下降沿关），扫描结束不置位
// =============================================================================
IF Axis1Remote.iMode = 4 AND Axis2Remote.iMode = 4 THEN
	RiseEdge(CLK := Modbus_Slave.bStartTrackAcu);
	FallEdge(CLK := Modbus_Slave.bStartTrackAcu);
	IF RiseEdge.Q THEN
		GVL.bStartTrack := TRUE;
	END_IF;
	IF FallEdge.Q THEN
		GVL.bStartTrack := FALSE;
	END_IF;
ELSE
	GVL.bStartTrack := Modbus_Slave.bStartTrackAcu;
	icountLostLocking := 0;
	icountLostLocking1 := 0;
	Iconutwait := 0;
END_IF

(* fbScantest 测试块已注释 *)
</Single>
