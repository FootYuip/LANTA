      <Single Name="MetaObject" Type="{81297157-7ec9-45ce-845e-84cab2b88ade}" Method="IArchivable">
        <Single Name="Guid" Type="System.Guid">b5e79cdc-cc76-4950-ba1b-cf91b66aab2b</Single>
        <Single Name="ParentGuid" Type="System.Guid">49085721-e2f3-443d-be92-6caf07f84b13</Single>
        <Single Name="Name" Type="string">PID</Single>
        <Dictionary Type="{2c41fa04-1834-41c1-816e-303c7aa2c05b}" Name="Properties" />
        <Single Name="TypeGuid" Type="System.Guid">6f9dac99-8de1-4efc-8465-68ac443b7d08</Single>
        <Array Name="EmbeddedTypeGuids" Type="System.Guid">
          <Single Type="System.Guid">a9ed5b7e-75c5-4651-af16-d2c27e98cb94</Single>
          <Single Type="System.Guid">3b83b776-fb25-43b8-99f2-3c507c9143fc</Single>
        </Array>
        <Single Name="Timestamp" Type="long">638672800065893478</Single>
      </Single>
      <Single Name="Object" Type="{6f9dac99-8de1-4efc-8465-68ac443b7d08}" Method="IArchivable">
        <Single Name="SpecialFunc" Type="{0db3d7bb-cde0-4416-9a7b-ce49a0124323}">None</Single>
        <Single Name="Implementation" Type="{3b83b776-fb25-43b8-99f2-3c507c9143fc}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">
IF (bPIDEnable&gt;0) THEN //如果PID使能
	IF rTarget=rFeedback THEN
		rPIDOutput:=0;	
	ELSE
	
		rErrorNow:=rTarget-rFeedback;//计算当前误差 en
		rProportionNew:=rErrorNow;//比例项
		//积分项
		IF rFeedback&gt;rPosLimNegative AND rFeedback&lt;rPosLimPositive THEN //若在软限位之内，工作时开启积分项
			IF (ABS(rTarget-rFeedback)&lt;iThreshold) THEN//位置差小于积分阈值
				rIntegralNew:= rIntegralNew+rErrorNow; //积分项
			ELSE
				rIntegralNew:=0;
			END_IF;
		ELSE //不在软限位范围内,则积分项为0
			rIntegralNew:=0;
		END_IF

		//PID输出
		rPIDOutPut:=rKp*rProportionNew+rKi*rIntegralNew;
		rPIDtrace:=rKp*rProportionNew+rKi*rIntegralNew;


		//PID限速
		
			IF rPIDOutput&lt;(-rVelLim) THEN
				rPIDOutput:=-rVelLim;
			ELSIF rPIDOutput&gt;rVelLim THEN
				rPIDOutput:=rVelLim;
			END_IF
		
		
		IF rFeedback&gt;rPosLimPositive AND rPIDOutput&gt;0 THEN 
			rPIDOutput:=0;
		END_IF
		IF rFeedback&lt;rPosLimNegative AND rPIDOutput&lt;0 THEN
			rPIDOutput:=0;
		END_IF
		
		rLastError:=rErrorNow;//将当前误差赋值给上一次误差
		
	END_IF
ELSE//非使能清零PID各项
	rProportionNew:=0.0;
	rIntegralNew:=0.0;
	rPIDOutput:=0.0;
END_IF









</Single>
            <Single Name="LineInfoPersistence" Type="string">b5e79cdc-cc76-4950-ba1b-cf91b66aab2b_Impl_LineIds</Single>
          </Single>
        </Single>
        <Single Name="Interface" Type="{a9ed5b7e-75c5-4651-af16-d2c27e98cb94}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">FUNCTION_BLOCK PID
VAR_INPUT
    rTarget : REAL;       (* 设定值 *)
    rFeedback : REAL;       (* 反馈值 *)
	rPosLimPositive:LREAL;//位置正限位
	rPosLimNegative:LREAL;//位置反限位
	rKp:REAL;     //比例增益
	rKi:REAL;     //积分增益
	rKd:REAL;     //微分增益
	iThreshold:INT;//积分项开启的位置阈值
	bPIDEnable:BOOL:=TRUE;//PID使能
	rVelLim:LREAL;//速度限制
END_VAR
VAR_OUTPUT
    rPIDOutput : LREAL:=0;         //带方向的输出速度
	rPIDtrace : LREAL:=0;         //带方向的输出速度
END_VAR
VAR
	//rPIDOutPut: REAL:=0.0;
	rLastError: LREAL:=0.0;(*上一次误差*)
	rErrorNow:LREAL:=0.0;(*当前误差*)
    rIntegralNew : LREAL := 0.0; (* 积分项 *)
    rDerivativeNew : LREAL := 0.0; (* 微分项 *)
	rDelta: LREAL;(*增量*)
	rProportionNew: LREAL;
	
	//iAzPIDEnable: INT;
END_VAR


</Single>
