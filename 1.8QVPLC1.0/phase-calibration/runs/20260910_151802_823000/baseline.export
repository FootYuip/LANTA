            <Single Name="TextBlobForSerialisation" Type="string">FUNCTION_BLOCK threesimple2
VAR_INPUT
	aUTC_TIME:ARRAY [1..5] OF ULINT;  //用于三次样条插值的数据
	aPosCmd :ARRAY [1..5] OF LREAL;//用于三次样条插值的数据
	
	y0:REAL;
	yn:REAL;//y0,yn表示的是S''(x0)=f''(x0)=y0，S''(xn)=f''(xn)=yn,自然边界即条件值为0
	xt:REAL;//所求目标位置
END_VAR
VAR_OUTPUT
