	Homing:BOOL;           //轴回原点
	Standstill:BOOL;       //轴待命
	DiscreteMotion:BOOL;   //轴离散运动
	ContinuousMotion:BOOL; //轴连续运动
	bServo_Enable:BOOL;		//轴使能状态
	bBrake:BOOL;			//轴抱闸状态
	Moving:BOOL;           //轴运动中
END_STRUCT
END_TYPE
