            <Single Name="TextBlobForSerialisation" Type="string">PROGRAM SecurityCheck
VAR
    bPrelimit_Positive_1 : BOOL;
    bPrelimit_Negative_1 : BOOL;
    bPrelimit_Positive_2 : BOOL;
    bPrelimit_Negative_2 : BOOL;
    bPrelimit_1 : BOOL;
    bPrelimit_2 : BOOL;
    bFinallimit_1 : BOOL;
    bFinallimit_2 : BOOL;
    AzError : REAL;
    ElError : REAL;
    rELCurrent : REAL;
    rAzCurrent : REAL;
    rTlCurrent : REAL;
    rAz_realpos : REAL;
    rEL_realpos : REAL;
    fbScan : SpiralScan;
    fbScan1 : SpiralScan_1;
    fbScantest : SpiralScan;
    enabletest : BOOL;
    aztest : REAL;
    eltest : REAL;
    enable : BOOL;
    delta : REAL;
    n_steps : REAL;
    agc_sim : REAL;
    lock_sim : BOOL;
    cycle_cnt : INT;
    sim_done : BOOL;
    az_out : REAL;
    el_out : REAL;
    done_out : BOOL;
    bLockSearch : BOOL;
    rSearchThre : REAL;
    rSearchThreTemp : REAL;
    bStartTrackTemp : BOOL;
    RiseEdge : R_TRIG;
    FallEdge : F_TRIG;
    bAcuTrackInhibit : BOOL;
    icountLostLocking : INT;
    bErrorLock : BOOL;
    icountLostLocking1 : INT;
    bType_out : BOOL;
    iconutwait : INT;
    rdelta : REAL := 0.25;         // 螺旋每格边长(°)，4*rdelta=±1°（1°波束）
    rStep : REAL := 12.0;          // 螺旋每格拍数，对齐2.4
    bFinish : BOOL;
    rAzErrorReal : REAL;
    rElErrorReal : REAL;
    rAlpha : REAL;
    icountBaseLock : INT;
    bScanRun : BOOL;
    bScanDoneOnce : BOOL;
    bScanFound : BOOL;
    az_latch : REAL;
    el_latch : REAL;
    bBaseLock : BOOL;
END_VAR</Single>
