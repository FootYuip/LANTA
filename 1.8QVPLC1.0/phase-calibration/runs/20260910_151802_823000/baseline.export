          <Single Type="System.Guid">a9ed5b7e-75c5-4651-af16-d2c27e98cb94</Single>
          <Single Type="System.Guid">3b83b776-fb25-43b8-99f2-3c507c9143fc</Single>
        </Array>
        <Single Name="Timestamp" Type="long">638747770664528309</Single>
      </Single>
      <Single Name="Object" Type="{6f9dac99-8de1-4efc-8465-68ac443b7d08}" Method="IArchivable">
        <Single Name="SpecialFunc" Type="{0db3d7bb-cde0-4416-9a7b-ce49a0124323}">None</Single>
        <Single Name="Implementation" Type="{3b83b776-fb25-43b8-99f2-3c507c9143fc}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">
rTrg(CLK:=bstart,Q=&gt;);

IF rTrg.Q THEN
	rAGCInit:=rAGCNow;
	rAGCMaxValue:=rAGCNow;
	//rBiasInit:=rCurrentPos-rInterPos;//获取启动时的拉偏量
END_IF

IF bstart THEN
	//搜索换向两次
	IF iCountDirChange=2 THEN
		rSearchNextStepTarget:=rAGCMaxBias;
		IF rStepBias&lt; rSearchNextStepTarget THEN 
			rStepBias:=rStepBias+rStep;
		ELSIF rStepBias&gt; rSearchNextStepTarget THEN
			rStepBias:=rStepBias-rStep;
		ELSE
			rStepBias:=rStepBias;
		END_IF
		
		IF ABS((rInterPos+rStepBias)-rCurrentPos)&lt;0.002 THEN //若位置达到最强位置，则输出成功 //可能只是路过这里,需要持续
			//需要判断稳定
			iCountBlockEnd:=iCountBlockEnd+1;
		ELSE
			iCountBlockEnd:=0;
		END_IF
		IF iCountBlockEnd&gt;iCountBlockEndMax THEN
			iCountBlockEnd:=iCountBlockEndMax+1;
			//用TON1秒后触发
			ton(IN:=TRUE,PT:=T#1S,Q=&gt;,ET=&gt;);
		END_IF
		IF ton.Q THEN
			bSucess:=TRUE;
		END_IF
	ELSE
		rStepBias:=rStepBias+rDirection*rStep;
		IF rDirection&lt;0 THEN
			//若是向小走
			IF rCurrentPos&lt;rInterPos THEN
				IF rAGCNow&lt;rAGCMaxValue-rSensitivity THEN
					iCountStop1:=iCountStop1+1;
					IF iCountStop1&gt;iCountStopMax THEN
						iCountStop1:=iCountStopMax+1;
						IF bSearchRight THEN
							iCountDirChange:=2;
						ELSE
							iCountDirChange:=iCountDirChange+1;
						END_IF
						rDirection:=rDirection*(-1);
					END_IF
				ELSE
					iCountStop1:=0;	
				END_IF
				
				//新加的 测试第一阶段搜索正确后不进行第二次搜索
				IF rAGCNow&gt;rAGCInit+rSensitivity THEN
					iCountSearchRight:=iCountSearchRight+1;
				ELSE
					iCountSearchRight:=0;
				END_IF
				IF iCountSearchRight&gt;200 THEN
					iCountSearchRight:=201;
					bSearchRight:=TRUE;
				END_IF
				
			END_IF
		ELSE
			//若是向正走
			IF rCurrentPos&gt;rInterPos THEN
				IF rAGCNow&lt;rAGCMaxValue-rSensitivity THEN
					iCountStop2:=iCountStop2+1;
					IF iCountStop2&gt;iCountStopMax THEN
						iCountStop2:=iCountStopMax+1;
						IF bSearchRight THEN
							iCountDirChange:=2;
						ELSE
							iCountDirChange:=iCountDirChange+1;
						END_IF
						rDirection:=rDirection*(-1);
					END_IF
				ELSE
					iCountStop2:=0;	
				END_IF
				
				//新加的
				IF rAGCNow&gt;rAGCInit+rSensitivity THEN
					iCountSearchRight:=iCountSearchRight+1;
				ELSE
					iCountSearchRight:=0;
				END_IF
				IF iCountSearchRight&gt;200 THEN
					iCountSearchRight:=201;
					bSearchRight:=TRUE;
				END_IF
				
			END_IF
		END_IF
		(*
		IF rAGCNow&lt;rAGCInit-0.05 THEN
			iCountStop1:=iCountStop1+1;
			IF iCountStop1&gt;150 THEN
				iCountDirChange:=iCountDirChange+1;
				rDirection:=rDirection*(-1);
			END_IF
		ELSE
			iCountStop1:=0;	
		END_IF
		*)
		
		 // 记录最强信号的拉偏量和值
		//IF rAGCNow &gt;= rAGCInit AND rAGCNow&gt; rAGCMaxValue THEN
		IF  rAGCNow&gt; rAGCMaxValue THEN
			rAGCMaxBias := rStepBias;
			rAGCMaxValue := rAGCNow;
		END_IF
	END_IF
ELSE
	rStepBias:=0;
	//清空变量
	iCountDirChange:=0;
	rAGCInit:=0;
	rAGCMaxValue:=0;
	rAGCMaxBias:=0;
	rDirection:=1;
	iCountStop1:=0;
	iCountStop2:=0;
	ton(IN:=FALSE,PT:=T#1S,Q=&gt;,ET=&gt;);
	//rStepBias:=0;
	rSearchNextStepTarget:=0;
	bSucess:=FALSE;
	iCountSearchRight:=0;
	bSearchRight:=FALSE;
	iCountBlockEnd:=0;
END_IF


(*
IF rStepBias&lt; rSearchNextStepTarget THEN 
	rStepBias:=rStepBias+rStep;
ELSIF rStepBias&gt; rSearchNextStepTarget THEN
	rStepBias:=rStepBias-rStep;
ELSE
	rStepBias:=rStepBias;
END_IF*)</Single>
            <Single Name="LineInfoPersistence" Type="string">4787ce3e-a3b4-48e2-bab0-db9748263bc2_Impl_LineIds</Single>
