            <Single Name="TextBlobForSerialisation" Type="string">//tLastTime:=tLastTime/1000000;
//tCurTime:=tCurTime/1000000;
//tTargetTime:=tTargetTime/1000000;
iDelTarCurTime:=ULINT_TO_LREAL(tTargetTime)-ULINT_TO_LREAL(tCurTime); //x1-x
IF (tCurTime-tLastTime)&lt;&gt;0 THEN
	iDelCurLastTime:=ULINT_TO_LREAL(tCurTime)-ULINT_TO_LREAL(tLastTime);  //x-x0
ELSE
	iDelCurLastTime:=1.0;
END_IF

IF iDelTarCurTime&lt;&gt;0 THEN
	rK:=(rCurPos-rLastPos)/(iDelCurLastTime);
ELSE
	rK:=0;
END_IF
rTargetpos:=rCurPos+rK*iDelTarCurTime;  //y1 + ((y1-y0)/(x1-x0))*(x-x1)</Single>
