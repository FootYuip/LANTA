          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">// 监测时统串口状态，时间插值
IF iSecondLast &lt;&gt; GPRMC_1.iSecond THEN
	icount := 0;
ELSE
	icount := icount + 1;
END_IF
iSecondLast := GPRMC_1.iSecond;

IF icount &gt; 2000 THEN
	icount := 0;
END_IF</Single>
            <Single Name="LineInfoPersistence" Type="string">9e411174-1a48-44ff-a9cb-6dd375c5d740_Impl_LineIds</Single>
