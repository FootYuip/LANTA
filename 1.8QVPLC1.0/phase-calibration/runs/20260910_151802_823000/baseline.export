            <Single Name="TextBlobForSerialisation" Type="string">FUNCTION_BLOCK solvex

VAR_IN_OUT
	M: ARRAY [1..3, 1..3] OF LREAL ; // 定义3x3矩阵M
    G: ARRAY [1..3] OF LREAL ; // 定义3x1数组G
END_VAR
VAR
    
   
	AdjointMatrix: ARRAY [1..3, 1..3] OF REAL; // 用于存储伴随矩阵
	Determinant: REAL; //行列式
    //M_Inverse: ARRAY [1..3, 1..3] OF REAL; //逆矩阵
    i, j, k: INT;
    Temp: REAL;

   

END_VAR

VAR_OUTPUT
	X: ARRAY [1..3] OF REAL; // 用于存储解x
END_VAR</Single>
