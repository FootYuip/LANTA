      <Single Name="MetaObject" Type="{81297157-7ec9-45ce-845e-84cab2b88ade}" Method="IArchivable">
        <Single Name="Guid" Type="System.Guid">8e7a7244-a61d-4720-a592-6679a8ac64b5</Single>
        <Single Name="ParentGuid" Type="System.Guid">49085721-e2f3-443d-be92-6caf07f84b13</Single>
        <Single Name="Name" Type="string">TimeCase</Single>
        <Dictionary Type="{2c41fa04-1834-41c1-816e-303c7aa2c05b}" Name="Properties" />
        <Single Name="TypeGuid" Type="System.Guid">6f9dac99-8de1-4efc-8465-68ac443b7d08</Single>
        <Array Name="EmbeddedTypeGuids" Type="System.Guid">
          <Single Type="System.Guid">a9ed5b7e-75c5-4651-af16-d2c27e98cb94</Single>
          <Single Type="System.Guid">3b83b776-fb25-43b8-99f2-3c507c9143fc</Single>
        </Array>
        <Single Name="Timestamp" Type="long">638857995351248968</Single>
      </Single>
      <Single Name="Object" Type="{6f9dac99-8de1-4efc-8465-68ac443b7d08}" Method="IArchivable">
        <Single Name="SpecialFunc" Type="{0db3d7bb-cde0-4416-9a7b-ce49a0124323}">None</Single>
        <Single Name="Implementation" Type="{3b83b776-fb25-43b8-99f2-3c507c9143fc}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">//计算时间误差序列
Result := SysTimeRtcHighResGet(stUTC_Timestamp);        
stSYS_Timestamp := TO_ULINT(stUTC_Timestamp);           // ULINT，获取本地时间
dtNow := TO_DT(stUTC_Timestamp / 1000); 		        // 转换为DATE_AND_TIME类型

Uptriger(CLK:=Triger);                                  //检测PPS上升沿
IF Uptriger.Q THEN                                      //上升沿触发后，GPRMC解析，DO0上升沿输出（电平24V）
	Feed:=TRUE;	
	dtGNSS := TO_DT(GVL.stGNSS_Timestap / 1000); 	    // 拿到串口时间数据			                                     
	iDiffETime:=ULINT_TO_DINT(GVL.stGNSS_Timestap-dtLastGNSS);  
	dtLastGNSS:=GVL.stGNSS_Timestap;                    //缓存上一周期时间戳（ms)  
	dDelPTime:=ULINT_TO_DINT(GVL.stGNSS_Timestap - stSYS_Timestamp);       //计算误差	              
	IF iDiffETime = 1000 THEN                           //确保时间更新步进1S
		IF dDelPTime &lt; 0 THEN                           //更新最小值
			IF dDelPTime &lt; min_DelPTime THEN
				min_DelPTime:=dDelPTime;
				DelPTime:=min_DelPTime;                 
			END_IF		
		ELSE                                            //更新最大值
			IF dDelPTime &gt; max_DelPTime THEN
				max_DelPTime:=dDelPTime;
				DelPTime:=max_DelPTime;
			END_IF
		END_IF	
	END_IF				    						
	iCount:=iCount+1;
	IF iCount &gt;= 60 THEN                                //一分钟校一次时间
		GVL.dDelTime:=DelPTime;
		max_DelPTime:=0;
		min_DelPTime:=0;	
		iCount:=0;
	END_IF
	
END_IF
TON_F(IN:=Feed, PT:=T#100MS, Q=&gt;,ET=&gt;);                 //脉宽200ms（测试时延，为了在示波器看波形）
IF TON_F.Q THEN
	Feed:=FALSE;		
END_IF</Single>
            <Single Name="LineInfoPersistence" Type="string">8e7a7244-a61d-4720-a592-6679a8ac64b5_Impl_LineIds</Single>
          </Single>
        </Single>
        <Single Name="Interface" Type="{a9ed5b7e-75c5-4651-af16-d2c27e98cb94}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">PROGRAM TimeCase
VAR
	stUTC_Timestamp :SYSTIME ;
	stSYS_Timestamp :ULINT ;
	stGNSS_Timestap :ULINT;
    Result : RTS_IEC_RESULT;
	Uptriger:Standard.R_TRIG;
	Triger AT %IX0.0:BOOL;
	Feed AT %QX0.0:BOOL;	
	TON_F: TON;
	dDelPTime: DINT;
	max_DelPTime:DINT :=0; 
	min_DelPTime: DINT :=-999999;
	iCount: INT;
	dtNow: DATE_AND_TIME;
	dtGNSS: DATE_AND_TIME;
	dtLastGNSS: ULINT;
	iDiffETime: DINT;
	DelPTime: DINT;
	
END_VAR
</Single>
