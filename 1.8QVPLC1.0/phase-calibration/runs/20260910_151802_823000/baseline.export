            <Single Name="TextBlobForSerialisation" Type="string">TYPE AxisCrtlStruct :
STRUCT
	iMode:INT;                     //方位运动模式   
	//bEnable :BOOL;                 //方位使能      
	rPosCmd :REAL;                 //方位位置命令    
	rVelCmd :REAL;                 //方位速度指令  
	rPIDCmdVel:LREAL;                //PID下发速度
	rPIDCmdPos:LREAL;				//PID目标位置
	bPIDEnable :BOOL;              //方位PID使能  
	bStartAutoTrack :BOOL;			//自跟踪使能
	rChanU:REAL;					//自跟踪采用的跟踪接收机误差电压
	
	rP:REAL:=1.0;                        //  P 
	rI:REAL:=0;                         //  I 
	rD:REAL:=0;                         //  D 
	rPIDThre:INT:=1;                   //积分阈值
	
	rP_AutoTrack:REAL:=3.0;          //自跟踪P
	rI_AutoTrack:REAL:=0.02;         //自跟踪I
	
	rAcceleration :REAL:=3;             //加速度
	rDeceleration :REAL:=3;       		//减速度
	rJogVel:LREAL:=2;					//点动速度 
	Pos_Vel:REAL:=4;					//位置模式速度
	rPos_Limit:LREAL;					//最大位置限制
	rVel_Limit:LREAL:=3;				//最大速度限制
	    
	rSoft_limit_Postive:REAL;
	rSoft_limit_Negative:REAL;			//正负软限位
	rLimitionNegative:LREAL;			//起始减速负限位
	rLimitionPositive:LREAL;			//起始减速正限位
	
END_STRUCT
END_TYPE</Single>
