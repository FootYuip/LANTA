        <Single Name="Interface" Type="{a9ed5b7e-75c5-4651-af16-d2c27e98cb94}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">FUNCTION_BLOCK AGCMaxSearch_PB_1 //双轴静止星步进跟踪使用的代码
VAR_INPUT
	bstart:BOOL;//模块开始标识
	rAGCNow:REAL;//当前AGC值
	btrig:BOOL;//触发一次
	rStepBiasNow:REAL;//当前拉偏量 //用来判断此次搜索是否有效
	bAutoTracking:BOOL;// 自跟踪标识
	bStop:BOOL;//满足ua ue很小
	
	rCurrentPos:REAL;//当前位置
	rInterPos:REAL;//插值位置
	//rOutStepBias:REAL;//外部拉偏量
END_VAR
VAR_OUTPUT
	
	rAGCMaxBias:REAL;//输出AGC最强时的拉偏量 单位为°
	bSucess :BOOL;//数出模块是否成功
	rStepBias:REAL;//步进量
END_VAR
VAR
	ton:Standard.TON;
	rTrg:Standard.R_TRIG;//初始化上升沿检测器
	rAGCInit:REAL:=0;//初始化AGC
	rPrevAGC:REAL:=0;//上一步的AGC值 单位为V
	rBiasInit:REAL;//初始化拉偏量
	
	iCountStep:INT:=0;//计步数
	toN1: Standard.Ton;//计时器 定时触发上升沿 
	
	rDirection: INT:=1;
	rSearchNextStepTarget:REAL;//搜索当前目标位置 单位为°
	rStep:REAL:=0.0003;//步进值
	rSensitivity:REAL:=0.05;//反向灵敏度
	iCountStopMax:INT:=20;//停止计数上限
	
	rLastDirection:INT;//上一次方向，判断是否换向
	iCountDirChange:INT;//换向标识
	rAGCMaxPos:REAL;//信号最强位置
	
	rAGCLastrecord: REAL;
	iStatus: INT;
	iCountStop1:INT;//第一阶段停止标识 (正向)
	iCountStop2:INT;//(反向)
	
	rAGCMaxValue: REAL;//AGC最大值
	
	//新加的
	iCountSearchRight:INT;//搜索方向正确，提前结束标识
	
	bSearchRight:BOOL;//搜索正确标识
	//模块指行完成标识
	iCountBlockEnd:INT;//用来计数确认已达到最强位置
	iCountBlockEndMax:INT:=500;//到位计数上限
END_VAR
</Single>
