            <Single Name="TextBlobForSerialisation" Type="string">FUNCTION_BLOCK LinearInter
VAR_INPUT
	tLastTime:ULINT;//上一时间
	rLastPos:REAL;//上一时间位置
	
	tCurTime:ULINT;//当前时间
	rCurPos:REAL;//当前时间位置
	
	tTargetTime:ULINT;//目标时间
END_VAR
VAR_OUTPUT
	rTargetpos:REAL;//目标时间位置
END_VAR
VAR
	iDelCurLastTime:LREAL:=1.0;//	当前与上一个时间差
	iDelTarCurTime:LREAL:=1.0;//目标与当前时间差
	rK:REAL;//方位斜率
END_VAR
</Single>
