      <Single Name="Object" Type="{6f9dac99-8de1-4efc-8465-68ac443b7d08}" Method="IArchivable">
        <Single Name="SpecialFunc" Type="{0db3d7bb-cde0-4416-9a7b-ce49a0124323}">None</Single>
        <Single Name="Implementation" Type="{3b83b776-fb25-43b8-99f2-3c507c9143fc}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">FOR nn:=1 TO 10 DO
	//XModbus[nn]:=ULINT_TO_LREAL(XModbusUL[nn])*1000000/1000.0;
	XModbus[nn]:=ULINT_TO_LREAL(XModbusUL[nn]-XModbusUL[1])+1.0;
END_FOR
	xt:=xt-ULINT_TO_LREAL(XModbusUL[1])+1.0;
IF ErrCode&gt;0 THEN
	ErrCode:=0;
END_IF


FOR mm:=2 TO 8 DO
	IF XModbus[mm] = XModbus[mm + 1] THEN
		// 找到相等的两个数，进行线性插值
		XModbus[mm + 1] := (XModbus[mm] + XModbus[mm + 2]) / 2.0;
	END_IF;
END_FOR
IF XModbus[1] = XModbus[2] THEN
	// 找到相等的两个数，进行线性插值
	XModbus[1] := XModbus[2]-(XModbus[3]-XModbus[2]);
END_IF;
IF XModbus[9] = XModbus[10] THEN
	// 找到相等的两个数，进行线性插值
	XModbus[10] := XModbus[9]+(XModbus[9]-XModbus[8]);
END_IF;

IF ErrCode &lt;&gt; 0 THEN
	iCountOutMaxRange:=0;
	iCountOutMinRange:=0;
END_IF


//在何处清空序列呢
//bSetZero:=FALSE; //默认不清空

IF  XModbus[10]=0 THEN
	//报错
	ErrCode:=107;//序列为空
ELSE
	IF XModbus[10]-XModbus[1]&gt;2000000 THEN
		sout:=YModbus[10];
	ELSE
		IF xt&lt;XModbus[1] THEN
			sout:=YModbus[1];
			//报故障 累计超时报错
			iCountOutMinRange:=iCountOutMinRange+1;
			IF iCountOutMinRange&gt;5000 THEN
				iCountOutMaxRange:=5001;
				//ErrCode:=108;//偏小超时报错
			END_IF
		ELSIF xt&gt;XModbus[10]  THEN
			sout:=YModbus[10];
			//报故障 累计超时报错
			iCountOutMaxRange:=iCountOutMaxRange+1;
			IF iCountOutMaxRange&gt;5000 THEN
				iCountOutMaxRange:=5001;
				//ErrCode:=109;//偏大超时报错
			END_IF
		ELSE //若所求目标位置在Modbus中间
			iCountOutMaxRange:=0;
			iCountOutMinRange:=0;
			//若不满五个点
			IF XModbus[6]=0 THEN
				sout:=XModbus[10];
			ELSE
				//若满五个点
				//寻找当前插值区间
				FOR j:=2 TO 10 DO
					IF xt&lt;XModbus[j] THEN
						k:=j;
						EXIT;
					END_IF
				END_FOR
				
				IF k=2 THEN
					X[1]:=XModbus[k-1];X[2]:=XModbus[k];X[3]:=XModbus[k+1];X[4]:=XModbus[k+2];X[5]:=XModbus[k+3];
					y[1]:=YModbus[k-1];Y[2]:=YModbus[k];Y[3]:=YModbus[k+1];Y[4]:=YModbus[k+2];Y[5]:=YModbus[k+3];
				ELSIF k&gt;2 AND k&lt;=8 THEN
					X[1]:=XModbus[k-2];X[2]:=XModbus[k-1];X[3]:=XModbus[k];X[4]:=XModbus[k+1];X[5]:=XModbus[k+2];
					Y[1]:=YModbus[k-2];Y[2]:=YModbus[k-1];Y[3]:=YModbus[k];Y[4]:=YModbus[k+1];Y[5]:=YModbus[k+2];
				ELSIF k=9 THEN
					X[1]:=XModbus[k-3];X[2]:=XModbus[k-2];X[3]:=XModbus[k-1];X[4]:=XModbus[k];X[5]:=XModbus[k+1];
					Y[1]:=YModbus[k-3];Y[2]:=YModbus[k-2];Y[3]:=YModbus[k-1];Y[4]:=YModbus[k];Y[5]:=YModbus[k+1];
				ELSIF k=10 THEN
					X[1]:=XModbus[k-4];X[2]:=XModbus[k-3];X[3]:=XModbus[k-2];X[4]:=XModbus[k-1];X[5]:=XModbus[k];
					Y[1]:=YModbus[k-4];Y[2]:=YModbus[k-3];Y[3]:=YModbus[k-2];Y[4]:=YModbus[k-1];Y[5]:=YModbus[k];
				END_IF
				
				
				//开始解算
				Three(X:=X,Y:=Y,y0:=y0,yn:=yn,D=&gt;D,h=&gt;h,A=&gt;A,g=&gt;g,M=&gt;M);
				FOR i:=1 TO (n-1) DO
					p1[i]:=M[i]*(X[i+1]-xt)*(X[i+1]-xt)*(X[i+1]-xt)/(6*h[i]);
					p2[i]:=M[i+1]*(xt-X[i])*(xt-X[i])*(xt-X[i])/(6*h[i]);
					p3[i]:=(A[i,1]-M[i]/6*(h[i])*(h[i]))*(X[i+1]-xt)/h[i];
					p4[i]:=(A[i+1,1]-M[i+1]/6*(h[i])*(h[i]))*(xt-X[i])/h[i];
				END_FOR
				FOR i:=1 TO (n-1) DO
					IF (xt&lt;=X[i+1])AND (xt&gt;=X[i]) THEN
						nout:=i;
						sout:=p1[nout]+p2[nout]+p3[nout]+p4[nout]; 
					ELSIF xt&gt;X[5] THEN
						nout:=4;
					ELSIF xt&lt;X[1]THEN
						nout:=1;
					END_IF
				END_FOR
				sout:=p1[nout]+p2[nout]+p3[nout]+p4[nout]; 
				(*
				IF xt&gt;X[5] THEN
					nout:=4;
					sout:=p1[nout]+p2[nout]+p3[nout]+p4[nout]; 
				ELSIF xt&lt;X[1] THEN
					nout:=1;
					sout:=p1[nout]+p2[nout]+p3[nout]+p4[nout]; 
				END_IF
				*)
				END_IF
			END_IF
			
		END_IF

//修正输入量为长度为10的数组

END_IF	
	



</Single>
            <Single Name="LineInfoPersistence" Type="string">cc69e4be-c04e-434c-b2cf-309f5108d715_Impl_LineIds</Single>
