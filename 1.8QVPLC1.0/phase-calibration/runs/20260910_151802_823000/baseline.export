            <Single Name="TextBlobForSerialisation" Type="string">FUNCTION_BLOCK SpiralScan

VAR_INPUT
    enable : BOOL;
    delta : REAL;
    delta1 : REAL;
    n_steps : REAL;
    agc : REAL;
    locked : BOOL;
    AzError : REAL;
    ELError : REAL;
    bTrackState : BOOL;
END_VAR

VAR_OUTPUT
    azimuth : REAL;
    elevation : REAL;
    done : BOOL;
    bType : BOOL;
END_VAR

VAR
    lock_count : INT;
    best_agc : REAL;
    best_az : REAL;
    best_el : REAL;
    bInit : BOOL;
    icount0 : INT;
    icount1 : INT;
    x : REAL;
    y : REAL;
    dx : REAL;
    dy : REAL;
    step_len : REAL;
    step_count : REAL;
    segment_progress : REAL;
    move_count : REAL;
    state : INT;
    az0 : REAL;
    el0 : REAL;
    az1 : REAL;
    el1 : REAL;
    segment_az_step : REAL;
    segment_el_step : REAL;
    side_repeat : REAL;
    icountInit : INT;
    iSearchMax : INT;
    iCountSearch : INT;
    rTemp : REAL;
END_VAR
</Single>
