      </Single>
      <Single Name="Object" Type="{6f9dac99-8de1-4efc-8465-68ac443b7d08}" Method="IArchivable">
        <Single Name="SpecialFunc" Type="{0db3d7bb-cde0-4416-9a7b-ce49a0124323}">None</Single>
        <Single Name="Implementation" Type="{3b83b776-fb25-43b8-99f2-3c507c9143fc}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">mPort:=2;								//串口端口号设定，GCAN-PLC-400、GCAN-PLC-510、GCAN-PLC-511，1为232，2为485
										//GCAN-PLC-324、GCAN-PLC-326，1为第一路485，2为第2路485
IF isFirst THEN
	com_init(							//串口初始化功能块
	EN_IN:=TRUE,						//串口初始化功能块使能
	xEnable:=TRUE,						//串口功能使能
	bPort:=mPort,						//串口端口号设定
	uiBaudrate:=19200,					//串口波特率设定
	bParity:=0,							//串口奇偶校验设定，0为无校验，1为奇校验，2为偶检验
	bDatabits:=8,						//数据位设定
	bStopbits:=1,						//停止位设定
	EN_OUT=&gt;m_out,						//串口初始化功能块执行完成标志位
	uiError=&gt;m_uiError);				//串口初始化功能块执行错误信息
	isfirst:=FALSE;						//执行一次初始化后关闭IF的条件使其之后进入ELSE程序段运行

ELSE
	com_read(						//串口读取功能块
	EN_in:=TRUE,					//读取功能块使能，为TRUE执行读取
	bPort:=mPort,					//串口端口号设定
	p_brxdata:=ADR(recBuf),			//读取到的串口数据引脚为指针类型，使用ADR()指向自建数组将数据存放到数组中
	uiMaxsize:=20,					//设定最大读取长度
	EN_out=&gt;m_out,					//串口读取功能块执行完成标志位******功能块执行完成不代表接收完成********
	uiRecSize=&gt;recSize,				//串口接收数据长度，单位：字节，大于0时说明接收到数据可用于判断是否接收
	uierror=&gt;m_uierror);			//串口读取功能块执行错误信息
	
	//GVL.Chan1Lock := BYTE_TO_BOOL(recBuf[1]);
	IF recBuf[1] = 1 AND GVL.Chan1AGC &gt;= GVL.Chanthreshold THEN
		GVL.Chan1Lock := TRUE;
	ELSE
		GVL.Chan1Lock := FALSE;
	END_IF
	Word2Bit1.Apart_Byte[1] := recBuf[2];
	Word2Bit1.Apart_Byte[2] := recBuf[3];
	wAGC:=Word2Bit1.Apart_Word;
	
	Word2Bit2.Apart_Byte[1] := recBuf[4];
	Word2Bit2.Apart_Byte[2] := recBuf[5];
	iUa:=Word2Bit2.Apart_INT;
	
	Word2Bit3.Apart_Byte[1] := recBuf[6];
	Word2Bit3.Apart_Byte[2] := recBuf[7];
	iUe:=Word2Bit3.Apart_INT;
	IF ABS(INT_TO_REAL(iUa) * 5 / 2048) &lt;= 5 AND ABS(INT_TO_REAL(iUe) * 5 / 2048) &lt;= 5 AND ABS((WORD_TO_REAL(wAGC) * 5 / 76)) &lt;=5 THEN
		GVL.Chan1Ua := INT_TO_REAL(iUa) * 5 / 2048;
		GVL.Chan1Ue := INT_TO_REAL(iUe) * 5 / 2048;
		GVL.Chan1AGC := 5 - (WORD_TO_REAL(wAGC) * 5 / 76);
	END_IF
	
	(*
	Dword2Bit1.Apart_Byte[4] := recBuf[8];
	Dword2Bit1.Apart_Byte[3] := recBuf[9];
	Dword2Bit1.Apart_Byte[2] := recBuf[10];
	Dword2Bit1.Apart_Byte[1] := recBuf[11];	
	
	
	Dword2Bit2.Apart_Byte[4] := recBuf[12];
	Dword2Bit2.Apart_Byte[3] := recBuf[13];
	Dword2Bit2.Apart_Byte[2] := recBuf[14];
	Dword2Bit2.Apart_Byte[1] := recBuf[15];	
	*)
	
	Dword2Bit1.Apart_Byte[3] := recBuf[8];
	Dword2Bit1.Apart_Byte[4] := recBuf[9];
	Dword2Bit1.Apart_Byte[1] := recBuf[10];
	Dword2Bit1.Apart_Byte[2] := recBuf[11];	
	
	
	Dword2Bit2.Apart_Byte[3] := recBuf[12];
	Dword2Bit2.Apart_Byte[4] := recBuf[13];
	Dword2Bit2.Apart_Byte[1] := recBuf[14];
	Dword2Bit2.Apart_Byte[2] := recBuf[15];	
	
	rQData:=DWORD_TO_REAL(Dword2Bit2.Apart_DWORD);
	rSData:=DWORD_TO_REAL(Dword2Bit1.Apart_DWORD)-rQData;
	//rSData:=INT_TO_REAL(Dword2Bit1.Apart_INT) - rQData;
	
	IF rSData&lt;&gt;0  AND rQData&lt;&gt;0  THEN
		Chan1EB_N0 := 10*LOG(ABS(rSData/rQData))+3.8;
	ELSE
		Chan1EB_N0 := 0;
	END_IF
	
	//程引、位置模式下，信噪比大于29；或上位机下发自跟踪
	IF ((GVL.Axis1Remote.iMode = 2 OR GVL.Axis1Remote.iMode = 4) AND Chan1EB_N0 &gt;= 29)AND READ_485.recBuf[1] = 1 OR Modbus_Slave.bStartTrackAcu THEN
		icount0:=0;
		bEBN0Lock := TRUE;
	END_IF
	IF ( GVL.Axis1Remote.iMode = 4 or GVL.Axis1Remote.iMode =2 ) AND recBuf[1] = 0 THEN
		icount0:=icount0+1;
	END_IF
	IF icount0 &gt; 400 OR (GVL.Axis1Remote.iMode = 0 OR GVL.Axis1Remote.iMode = 0) THEN
		icount0 := 401;
		bEBN0Lock := FALSE;
	END_IF
(* PHASE_CAL_RX_BEGIN: passive diagnostics; original decoder above is unchanged.
   Assumes each eligible read starts at original recBuf[0]. Not a frame parser.
   Admission requires separate operator protocol/alignment confirmation. *)
GVL_PhaseCal.uiReadSize:=recSize;
GVL_PhaseCal.uiSerialError:=m_uiError;
IF recSize&gt;0 THEN
    IF GVL_PhaseCal.udiReadCount&gt;=4294967294 THEN
        GVL_PhaseCal.udiReadCount:=0;
    END_IF;
    GVL_PhaseCal.udiReadCount:=GVL_PhaseCal.udiReadCount+1;
    IF recSize&lt;16 THEN
        IF GVL_PhaseCal.udiShortReadCount&gt;=4294967294 THEN
            GVL_PhaseCal.udiShortReadCount:=0;
        END_IF;
        GVL_PhaseCal.udiShortReadCount:=GVL_PhaseCal.udiShortReadCount+1;
    END_IF;
END_IF;
IF recSize&gt;=16 AND recSize&lt;=20 AND m_uiError=0 AND
   ABS(INT_TO_REAL(iUa)*5/2048)&lt;=5 AND
   ABS(INT_TO_REAL(iUe)*5/2048)&lt;=5 AND
   ABS(WORD_TO_REAL(wAGC)*5/76)&lt;=5 THEN
    IF GVL_PhaseCal.udiRxSeq&gt;=4294967294 THEN
        GVL_PhaseCal.udiRxSeq:=1;
    ELSE
        GVL_PhaseCal.udiRxSeq:=GVL_PhaseCal.udiRxSeq+1;
    END_IF;
    GVL_PhaseCal.lrRxUa:=REAL_TO_LREAL(GVL.Chan1Ua);
    GVL_PhaseCal.lrRxUe:=REAL_TO_LREAL(GVL.Chan1Ue);
    GVL_PhaseCal.lrRxEbN0:=REAL_TO_LREAL(Chan1EB_N0);
    GVL_PhaseCal.lrRxAz:=-REAL_TO_LREAL(GVL.rFctPosReal_2);
    GVL_PhaseCal.lrRxEl:=REAL_TO_LREAL(GVL.rFctPosReal_1)-90;
    GVL_PhaseCal.xRxLock:=(recBuf[1]=1);
    GVL_PhaseCal.udiRxSeq:=GVL_PhaseCal.udiRxSeq+1;
END_IF;
(* PHASE_CAL_RX_END *)
END_IF
(*
//加校验
iChan1DataLen:=recSize-1; //数据长度
	IF iChan1DataLen &gt; 0 THEN
		FOR chan1_i:=0 TO iChan1DataLen BY 1 DO
			
			IF recBuf[chan1_i] = 16#7E THEN
				chan1_j:=0;
			END_IF
			recData[chan1_j]:=recBuf[chan1_i];
			
			chan1_j:=chan1_j+1;
			IF chan1_j=8 THEN
				Word2Bit1.Apart_Byte[1] := recData[2];
				Word2Bit1.Apart_Byte[2] := recData[3];
				wAGC:=Word2Bit1.Apart_Word;
				
				Word2Bit2.Apart_Byte[1] := recData[4];
				Word2Bit2.Apart_Byte[2] := recData[5];
				iUa:=Word2Bit2.Apart_INT;
				
				Word2Bit3.Apart_Byte[1] := recData[6];
				Word2Bit3.Apart_Byte[2] := recData[7];
				iUe:=Word2Bit3.Apart_INT;
				rUaTemp := INT_TO_REAL(iUa) * 5 / 2048;
				rUeTemp := INT_TO_REAL(iUe) * 5 / 2048;
				rUagcTemp := WORD_TO_REAL(wAGC) * 5 / 76;
				
				IF ABS(rUagcTemp)&lt;=5 AND ABS(rUaTemp)&lt;=5 AND ABS(rUeTemp)&lt;=5THEN 
					GVL.Chan1Ua := rUaTemp;
					GVL.Chan1Ue := rUeTemp;
					GVL.Chan1AGC := rUagcTemp;
					IF recData[1] = 1 THEN
						GVL.Chan1Lock := TRUE;
					ELSE
						GVL.Chan1Lock := FALSE;
					END_IF
				END_IF
(* 
				IF ABS(GVL.Chan1AGC)&gt;5 THEN GVL.Chan1AGC:=5;
				END_IF
				IF ABS(GVL.Chan1Ua)&gt;5 THEN GVL.Chan1Ua:=0;
				END_IF
				IF ABS(GVL.Chan1Ue)&gt;5 THEN GVL.Chan1Ue:=0;
				END_IF
				*)
				chan1_j:=0;
			END_IF
		END_FOR
	END_IF
	
	
END_IF
*)</Single>
            <Single Name="LineInfoPersistence" Type="string">bf0b9152-755b-4529-9d6a-65e584178361_Impl_LineIds</Single>
          </Single>
        </Single>
        <Single Name="Interface" Type="{a9ed5b7e-75c5-4651-af16-d2c27e98cb94}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">PROGRAM READ_485
VAR
	com_init:gcan.FB_Com_Init;      		//gcan.FB_Com_Init为串口初始化功能块，可设定串口端口号，串口波特率等参数
	com_read:gcan.FB_Com_Read ;				//gcan.FB_Com_Read为串口接收功能块，用于通过接收串口发送给PLC的数据
	com_write:gcan.FB_Com_Write ;			//gcan.FB_Com_Write为串口发送功能块，用于发送串口数据
	m_uiError:UINT;							//用于承接功能块中报错引脚错误信息的变量
	m_out:BOOL;								//用于承接功能块中完成标志引脚数据的变量
	isFirst:BOOL:=TRUE;						//用于判断初始化只执行一次的逻辑
	mPort:BYTE;								//程序中用作设定串口端口号
	recSize:UINT;							//接收数据长度，单位：字节
	recBuf:ARRAY[0..19] OF BYTE;			//用于存放接收到的串口数据的数组
	recData:ARRAY[0..8] OF BYTE;			//用于存放整帧数据
	wAGC:WORD; // agc，电平值
	iUa:INT; // 方位误差电压，mV
	iUe:INT; // 俯仰误差电压，mV
	iChan1DataLen: UINT;
	chan1_i: INT;
	chan1_j: INT;
	Word2Bit1:Word2Bit;
	Word2Bit2:Word2Bit;
	Word2Bit3:Word2Bit;
	rUagcTemp:REAL;
	rUaTemp:REAL;
	rUeTemp:REAL;
	btest:BOOL;
	btest2:BOOL;
	
	rSData:REAL;
	rQData:REAL;
	Dword2Bit1:Dword2Bit;
	Dword2Bit2:Dword2Bit;
	Chan1EB_N0: REAL;
	bEBN0Lock:BOOL;
	icount0:INT;
END_VAR</Single>
            <Single Name="LineInfoPersistence" Type="string">bf0b9152-755b-4529-9d6a-65e584178361_Decl_LineIds</Single>
          </Single>
        </Single>
        <Single Name="UniqueIdGenerator" Type="string">583</Single>
        <Single Name="POULevel" Type="{8e575c5b-1d37-49c6-941b-5c0ec7874787}">Standard</Single>
        <List Name="ChildObjectGuids" Type="System.Collections.ArrayList" />
        <Single Name="AddAttributeSubsequent" Type="bool">False</Single>
      </Single>
      <Single Name="ParentSVNodeGuid" Type="System.Guid">49085721-e2f3-443d-be92-6caf07f84b13</Single>
      <Array Name="Path" Type="string">
        <Single Type="string">Device</Single>
        <Single Type="string">PLC逻辑</Single>
        <Single Type="string">Application</Single>
      </Array>
      <Single Name="Index" Type="int">-1</Single>
    </Single>
    <Single Type="{6198ad31-4b98-445c-927f-3258a0e82fe3}" Method="IArchivable">
      <Single Name="IsRoot" Type="bool">True</Single>
      <Single Name="MetaObject" Type="{81297157-7ec9-45ce-845e-84cab2b88ade}" Method="IArchivable">
        <Single Name="Guid" Type="System.Guid">01e0f185-d49a-4d6d-9268-6e70a0d1342e</Single>
        <Single Name="ParentGuid" Type="System.Guid">49085721-e2f3-443d-be92-6caf07f84b13</Single>
        <Single Name="Name" Type="string">SecurityCheck</Single>
        <Dictionary Type="{2c41fa04-1834-41c1-816e-303c7aa2c05b}" Name="Properties" />
        <Single Name="TypeGuid" Type="System.Guid">6f9dac99-8de1-4efc-8465-68ac443b7d08</Single>
        <Array Name="EmbeddedTypeGuids" Type="System.Guid">
          <Single Type="System.Guid">a9ed5b7e-75c5-4651-af16-d2c27e98cb94</Single>
          <Single Type="System.Guid">3b83b776-fb25-43b8-99f2-3c507c9143fc</Single>
        </Array>
        <Single Name="Timestamp" Type="long">639246506084975116</Single>
      </Single>
      <Single Name="Object" Type="{6f9dac99-8de1-4efc-8465-68ac443b7d08}" Method="IArchivable">
        <Single Name="SpecialFunc" Type="{0db3d7bb-cde0-4416-9a7b-ce49a0124323}">None</Single>
        <Single Name="Implementation" Type="{3b83b776-fb25-43b8-99f2-3c507c9143fc}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">// --- implementation (ST) ---
// =============================================================================
// 段 1: 安全逻辑用位置（与显示用 rFctPosReal 可能差符号/零点）
// =============================================================================
rAz_realpos := -1 * GVL.rFctPosReal_2;
rEl_realpos := GVL.rFctPosReal_1 - 90;

// =============================================================================
// 段 2: 三轴伺服电流监测（仅使能时读 AD，%IW×%ID/1e6）
// %IW10/%ID4=俯仰, %IW20/%ID9=方位, %IW30/%ID14=倾斜
// =============================================================================
IF Axis1Status.bServo_Enable THEN
	rELCurrent:=DINT_TO_REAL((INT_TO_DINT(%IW10)* %ID4))/1000000.0;  //俯仰轴电流监测
ELSE
	rELCurrent:=0;
END_IF

IF Axis2Status.bServo_Enable THEN
	rAzCurrent:=DINT_TO_REAL((INT_TO_DINT(%IW20)* %ID9))/1000000.0;  //方位轴电流监测
ELSE
	rAzCurrent:=0;
END_IF

IF Axis3Status.bServo_Enable THEN
	rTlCurrent:=DINT_TO_REAL((INT_TO_DINT(%IW30)* %ID14))/1000000.0;  //倾斜轴电流监测
ELSE
	rTlCurrent:=0;
END_IF

// =============================================================================
// 段 3: 跟踪误差（供 SpiralScan 判断扫描方向与完成度）
// mode2 指向: 命令位置 vs 实际位置
// mode4 程引: 插值目标+偏置 vs 实际位置（含手动/自跟踪偏置）
// =============================================================================
IF Axis2Remote.iMode = 2 THEN
	AzError:=(-1) * (Axis2Remote.rPosCmd-rFctPosReal_2);
	ElError:=Axis1Remote.rPosCmd-rFctPosReal_1;	
END_IF

IF Axis2Remote.iMode = 4 THEN
	AzError:=rFctPosReal_2-RealTimePosCal.rInterazPos-(az_ctrl_1.rStepBias+az_ctrl_1.rAuToStepBias);
	ElError:=RealTimePosCal.rInterElPos-rFctPosReal_1+ (El_ctrl_1.rStepBias+EL_ctrl_1.rAuToStepBias);
END_IF
(*
rAzErrorReal := rAzErrorReal + rAlpha * (AzError - rAzErrorReal);
rElErrorReal := rElErrorReal + rAlpha * (ElError - rElErrorReal);
*)

// =============================================================================
// 段 4: 远控故障复位（Modbus bCommReset → GVL.bError_Reset）
// =============================================================================
IF NOT GVL.bLocalCtrl THEN
	IF Modbus_Slave.bCommReset THEN
		GVL.bError_Reset:=TRUE;
	ELSE
		GVL.bError_Reset:=FALSE;
	END_IF
END_IF

// =============================================================================
// 段 5: 远控 rPosCmd 赋值（含 AGC 搜索偏置或测试扫描偏置）
// 非 bSearch: Modbus 目标 + eltest/aztest
// bSearch:   Modbus 目标 + *_ctrl_1 的 rSearchNextStepTarget_tb
// =============================================================================
IF NOT modbus_slave.bSearch THEN
	Axis1Remote.rPosCmd:=Modbus_Slave.rPosCmd_1 + eltest;
	Axis2Remote.rPosCmd:=Modbus_Slave.rPosCmd_2 - aztest;
ELSE
	Axis1Remote.rPosCmd:=Modbus_Slave.rPosCmd_1 + El_ctrl_1.rSearchNextStepTarget_tb;
	Axis2Remote.rPosCmd:=Modbus_Slave.rPosCmd_2 + Az_ctrl_1.rSearchNextStepTarget_tb;
END_IF

// =============================================================================
// 段 6: 远控三轴命令参量 — Modbus_Slave → AxisXRemote（核心汇总）
// 俯仰/方位 rPosCmd 已在段 5 赋值；此处写 mode/速度/PID/加减速等
// =============================================================================
Axis1Remote.iMode:=Modbus_Slave.iMode_1;
Axis1Remote.rVelCmd:=Modbus_Slave.rVelcmd_1;
//Axis1Remote.rPosCmd:=Modbus_Slave.rPosCmd_1;
Axis1Remote.rP:=Modbus_Slave.rP_1;
Axis1Remote.rI:=Modbus_Slave.rI_1;
Axis1Remote.rD:=Modbus_Slave.rD_1;
Axis1Remote.rPIDThre:=Modbus_Slave.rThreshold_1;
Axis1Remote.rAcceleration:=Modbus_Slave.rAcceleration_1;
Axis1Remote.rDeceleration:=Modbus_Slave.rDeceleration_1;
Axis1Remote.rVel_Limit:=Modbus_Slave.rVelLim_1;

Axis2Remote.iMode:=Modbus_Slave.iMode_2;
Axis2Remote.rVelCmd:=Modbus_Slave.rVelcmd_2;
//Axis2Remote.rPosCmd:=Modbus_Slave.rPosCmd_2;
Axis2Remote.rP:=Modbus_Slave.rP_2;
Axis2Remote.rI:=Modbus_Slave.rI_2;
Axis2Remote.rD:=Modbus_Slave.rD_2;
Axis2Remote.rPIDThre:=Modbus_Slave.rThreshold_2;
Axis2Remote.rAcceleration:=Modbus_Slave.rAcceleration_2;
Axis2Remote.rDeceleration:=Modbus_Slave.rDeceleration_2;
Axis2Remote.rVel_Limit:=Modbus_Slave.rVelLim_2;

Axis3Remote.iMode:=Modbus_Slave.iMode_3;
Axis3Remote.rVelCmd:=Modbus_Slave.rVelcmd_3;
Axis3Remote.rPosCmd:=Modbus_Slave.rPosCmd_3;
Axis3Remote.rP:=Modbus_Slave.rP_3;
Axis3Remote.rI:=Modbus_Slave.rI_3;
Axis3Remote.rD:=Modbus_Slave.rD_3;
Axis3Remote.rPIDThre:=Modbus_Slave.rThreshold_3;
Axis3Remote.rAcceleration:=Modbus_Slave.rAcceleration_3;
Axis3Remote.rDeceleration:=Modbus_Slave.rDeceleration_3;

(* 本控 HMI 赋值块已注释，本控参数由其他 POU 写入 AxisXLocal *)

// =============================================================================
// 段 7: 俯仰预限位 → Error_code 201(正)/202(负)，置位上报标志
// bPrelimit_1 由硬件 IO 映射；触发后根据当前位置方向区分正负限位
// =============================================================================
IF bPrelimit_1 THEN
	IF rFctPosReal_1&gt;0 THEN
		bPrelimit_Positive_1:=TRUE;
		Error_code:=201;
	ELSE
		bPrelimit_Negative_1:=TRUE;
		Error_code:=202;
	END_IF;
ELSE
	bPrelimit_Negative_1:=FALSE;
	bPrelimit_Positive_1:=FALSE;
	;
END_IF

// =============================================================================
// 段 8: 方位预限位（仅置标志，Error_code 203/204 已注释）
// =============================================================================
IF bPrelimit_2 THEN
	IF rFctPosReal_2&gt;0 THEN
		//Error_code:=203;
		bPrelimit_Positive_2:=TRUE;;
	ELSE
		//Error_code:=204;
		bPrelimit_Negative_2:=TRUE;;
	END_IF;
ELSE
	bPrelimit_Negative_2:=FALSE;
	bPrelimit_Positive_2:=FALSE;
	;
END_IF

// =============================================================================
// 段 9: 扫描找到中心 — 基带锁 且 Eb/N0&gt;rEbN0LockThre 且 √(Ua²+Ue²)&lt;=rErrorThre
// =============================================================================
bBaseLock := (READ_485.recBuf[1] = 1);
bErrorLock  := (SQRT(GVL.Chan1Ua * GVL.Chan1Ua + GVL.Chan1Ue * GVL.Chan1Ue) &lt;= PersistentVars.rErrorThre);
bLockSearch := (READ_485.Chan1EB_N0 &gt; PersistentVars.rEbN0LockThre) AND bBaseLock AND bErrorLock;

// =============================================================================
// 段 10: 启扫 — 双轴程引、未自跟踪、基带锁连续 2s（200×10ms）触发一次
// 扫描过程中允许短暂掉锁；找到合格点后本程引周期内不再重扫
// 退出程引则清锁存
// =============================================================================
IF Axis1Remote.iMode = 4 AND Axis2Remote.iMode = 4 THEN
	IF NOT GVL.bStartTrack AND NOT bScanRun AND NOT bScanFound THEN
		IF bBaseLock THEN
			icountBaseLock := icountBaseLock + 1;
			IF icountBaseLock &gt;= 200 THEN
				icountBaseLock := 200;
				bScanRun := TRUE;
			END_IF
		ELSE
			icountBaseLock := 0;
		END_IF
	ELSE
		icountBaseLock := 0;
	END_IF
	enable := bScanRun AND NOT GVL.bStartTrack;
ELSE
	enable := FALSE;
	bScanRun := FALSE;
	bScanDoneOnce := FALSE;
	bScanFound := FALSE;
	az_latch := 0.0;
	el_latch := 0.0;
	icountBaseLock := 0;
END_IF

// 螺旋局部参数（与直线 PersistentVars.rStep 量纲不同：此处为每格周期数）
IF rdelta &lt; 1.0E-6 THEN
	rdelta := 0.25;
END_IF
IF rStep &lt; 1.0E-6 THEN
	rStep := 12.0;
END_IF

// =============================================================================
// 段 11: 调用扫描 FB — 直线或螺旋；locked=找到中心，连续10拍（约100ms）锁存
// =============================================================================
IF NOT PersistentVars.bSearchType THEN
	fbScan(
		enable      := enable,
		delta       := PersistentVars.rAzScanRange,
		delta1      := PersistentVars.rElScanRange,
		n_steps     := PersistentVars.rStep,
		agc      := READ_485.Chan1EB_N0,
		locked     := bLockSearch,
		AzError := AzError,
		elError := elError,
		bTrackState := GVL.bStartTrack,
		azimuth     =&gt; az_out,
		elevation   =&gt; el_out,
		done        =&gt; done_out,
		bType  =&gt;bType_out
	);
ELSE
	fbScan1(
		enable      := enable,
		delta       := rdelta,
		n_steps     := rStep,
		agc      := READ_485.Chan1EB_N0,
		locked     := bLockSearch,
		AzError := AzError,
		elError := elError,
		azimuth     =&gt; az_out,
		elevation   =&gt; el_out,
		done        =&gt; done_out,
		bType  =&gt;bType_out
	);
END_IF

// 扫描结束：找到则锁存 -Error；未找到锁存 0。此后 az_out/el_out 用锁存值
IF bScanRun AND done_out THEN
	bScanRun := FALSE;
	bScanDoneOnce := TRUE;
	IF bType_out THEN
		az_latch := az_out;
		el_latch := el_out;
		bScanFound := TRUE;
	ELSE
		az_latch := 0.0;
		el_latch := 0.0;
		bScanFound := FALSE;
	END_IF
END_IF
IF GVL.bStartTrack AND bScanRun THEN
	bScanRun := FALSE;
	bScanDoneOnce := TRUE;
END_IF
IF NOT bScanRun THEN
	az_out := az_latch;
	el_out := el_latch;
END_IF

// =============================================================================
// 段 12: 自跟踪只跟 ACU HR[7].B10（上升沿开、下降沿关），扫描结束不置位
// =============================================================================
IF Axis1Remote.iMode = 4 AND Axis2Remote.iMode = 4 THEN
	RiseEdge(CLK := Modbus_Slave.bStartTrackAcu);
	FallEdge(CLK := Modbus_Slave.bStartTrackAcu);
	IF RiseEdge.Q THEN
		GVL.bStartTrack := TRUE;
	END_IF;
	IF FallEdge.Q THEN
		GVL.bStartTrack := FALSE;
	END_IF;
ELSE
	GVL.bStartTrack := Modbus_Slave.bStartTrackAcu;
	icountLostLocking := 0;
	icountLostLocking1 := 0;
	Iconutwait := 0;
END_IF

(* fbScantest 测试块已注释 *)

(* PHASE_CAL_HOOK: once per 10 ms, LAST call. *)
PRG_PhaseCalibration();</Single>
