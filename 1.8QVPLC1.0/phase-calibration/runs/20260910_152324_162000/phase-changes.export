        <Single Name="Interface" Type="{a9ed5b7e-75c5-4651-af16-d2c27e98cb94}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">FUNCTION_BLOCK FB_PhaseFit
(* Offline candidate. Feed ONE coherent, validated sample per xSample pulse.
   Coordinates: positive Az=right, positive El=up. Desired response is -I.
   eAz/eEl must already have consistent signed engineering units.
   Do not subtract 2.5 from the existing signed serial values without protocol proof. *)
VAR_INPUT
    xReset : BOOL;
    xSample : BOOL;
    xFinish : BOOL;
    lrAz : LREAL;
    lrEl : LREAL;
    lrUa : LREAL;
    lrUe : LREAL;
    lrCurrentPhaseDeg : LREAL;
    (* +1: increasing hardware phase rotates measured response CCW; -1: CW; 0: unknown *)
    iPhaseDirection : INT;
END_VAR
VAR_OUTPUT
    xFitValid : BOOL;
    xSuggestedValid : BOOL;
    uiError : UINT;
    udiSamples : UDINT;
    lrKaa, lrKae, lrKea, lrKee : LREAL;
    lrInterceptAz, lrInterceptEl : LREAL;
    lrResponseAngleDeg : LREAL;
    lrCorrectionDeg, lrSuggestedDeg : LREAL;
    lrCandidatePlusDeg, lrCandidateMinusDeg : LREAL;
    lrOrthErrorDeg : LREAL;
    lrResidualAz, lrResidualEl : LREAL;
    lrCrossAz, lrCrossEl : LREAL;
END_VAR
VAR
    sx, sy, su, sv, sxx, syy, sxy, sxu, syu, sxv, syv, suu, svv : LREAL;
    n, xx, yy, xy, xu, yu, xv, yv, uu, vv, det : LREAL;
    ga, ge, dot, a, b, phi, pi, base, sse : LREAL;
    finishOld : BOOL;
END_VAR</Single>
            <Single Name="LineInfoPersistence" Type="string">2e7aac65-9478-4ee7-97e5-2ad922cad390_Decl_LineIds</Single>
          </Single>
        </Single>
        <Single Name="UniqueIdGenerator" Type="string">149</Single>
        <Single Name="POULevel" Type="{8e575c5b-1d37-49c6-941b-5c0ec7874787}">Standard</Single>
        <List Name="ChildObjectGuids" Type="System.Collections.ArrayList" />
        <Single Name="AddAttributeSubsequent" Type="bool">False</Single>
      </Single>
      <Single Name="ParentSVNodeGuid" Type="System.Guid">49085721-e2f3-443d-be92-6caf07f84b13</Single>
      <Array Name="Path" Type="string">
        <Single Type="string">Device</Single>
        <Single Type="string">PLC逻辑</Single>
        <Single Type="string">Application</Single>
      </Array>
      <Single Name="Index" Type="int">-1</Single>
    </Single>
    <Single Type="{6198ad31-4b98-445c-927f-3258a0e82fe3}" Method="IArchivable">
      <Single Name="IsRoot" Type="bool">True</Single>
      <Single Name="MetaObject" Type="{81297157-7ec9-45ce-845e-84cab2b88ade}" Method="IArchivable">
        <Single Name="Guid" Type="System.Guid">e52b8d23-d02b-44df-b266-cee7e7a5bbad</Single>
        <Single Name="ParentGuid" Type="System.Guid">49085721-e2f3-443d-be92-6caf07f84b13</Single>
        <Single Name="Name" Type="string">FB_PhaseTriangle</Single>
        <Dictionary Type="{2c41fa04-1834-41c1-816e-303c7aa2c05b}" Name="Properties" />
        <Single Name="TypeGuid" Type="System.Guid">6f9dac99-8de1-4efc-8465-68ac443b7d08</Single>
        <Array Name="EmbeddedTypeGuids" Type="System.Guid">
          <Single Type="System.Guid">a9ed5b7e-75c5-4651-af16-d2c27e98cb94</Single>
          <Single Type="System.Guid">3b83b776-fb25-43b8-99f2-3c507c9143fc</Single>
        </Array>
        <Single Name="Timestamp" Type="long">639246506100766201</Single>
      </Single>
      <Single Name="Object" Type="{6f9dac99-8de1-4efc-8465-68ac443b7d08}" Method="IArchivable">
        <Single Name="SpecialFunc" Type="{0db3d7bb-cde0-4416-9a7b-ce49a0124323}">None</Single>
        <Single Name="Implementation" Type="{3b83b776-fb25-43b8-99f2-3c507c9143fc}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">xCollect:=FALSE;
IF xResetHeld AND NOT xPermit AND uiState=900 THEN
    uiState:=0; xBusy:=FALSE; xFault:=FALSE;
    lrAzBias:=0; lrElBias:=0;
END_IF;
IF xStart AND NOT startOld AND NOT xBusy AND uiState&lt;&gt;900 THEN
    xDone:=FALSE; xAborted:=FALSE; xFault:=FALSE;
    (* 0.1 is an unvalidated commissioning ceiling, NOT a proven linear range. *)
    IF NOT xPermit OR lrRadiusDeg&lt;=0 OR lrRadiusDeg&gt;0.1 OR
       lrLegTimeSec&lt;2 OR lrSettleSec&lt;0.1 OR lrSettleSec&gt;30 THEN
        xFault:=TRUE;
    ELSE
        side:=lrRadiusDeg/SQRT(2.0);
        leg:=lrLegTimeSec; settle:=lrSettleSec;
        elapsed:=0; lrAzBias:=0; lrElBias:=0;
        uiState:=10; xBusy:=TRUE;
    END_IF;
END_IF;
startOld:=xStart;

IF xBusy AND uiState&lt;&gt;900 THEN
    IF NOT xPermit OR lrDtSec&lt;=0 OR lrDtSec&gt;0.1 THEN
        xFault:=TRUE; uiState:=900;
    ELSE
        IF xAbort AND uiState&lt;&gt;800 THEN
            fromAz:=lrAzBias; fromEl:=lrElBias;
            toAz:=0; toEl:=0; elapsed:=0;
            xAborted:=TRUE; uiState:=800;
        END_IF;
        elapsed:=elapsed+lrDtSec;
        CASE uiState OF
            10,30,50,70:
                xCollect:=TRUE; (* caller still gates new-frame, quality, position settling *)
                IF elapsed&gt;=settle THEN
                    elapsed:=0; fromAz:=lrAzBias; fromEl:=lrElBias;
                    CASE uiState OF
                        10: toAz:=0; toEl:=side; uiState:=20;
                        30: toAz:=side; toEl:=side; uiState:=40;
                        50: toAz:=0; toEl:=0; uiState:=60;
                        70: xBusy:=FALSE; xDone:=TRUE; uiState:=0;
                    END_CASE;
                END_IF;
            20,40,60,800:
                u:=LIMIT(0.0,elapsed/leg,1.0);
                blend:=u*u*u*(10.0+u*(-15.0+6.0*u));
                lrAzBias:=fromAz+(toAz-fromAz)*blend;
                lrElBias:=fromEl+(toEl-fromEl)*blend;
                xCollect:=(uiState&lt;&gt;800) AND (u&gt;0.1) AND (u&lt;0.9);
                IF u&gt;=1 THEN
                    elapsed:=0;
                    IF uiState=800 THEN
                        xBusy:=FALSE; uiState:=0;
                    ELSE
                        uiState:=uiState+10;
                    END_IF;
                END_IF;
        END_CASE;
    END_IF;
END_IF;</Single>
            <Single Name="LineInfoPersistence" Type="string">e52b8d23-d02b-44df-b266-cee7e7a5bbad_Impl_LineIds</Single>
          </Single>
        </Single>
        <Single Name="Interface" Type="{a9ed5b7e-75c5-4651-af16-d2c27e98cb94}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">FUNCTION_BLOCK FB_PhaseTriangle
(* Pure offset generator. Does NOT write axis commands or change operating modes.
   Caller supplies elapsed seconds and motion permission; xStart is rising-edge.
   xAbort returns offsets smoothly while permission remains valid.
   Permission loss holds offsets and sets xFault: existing axis safety owns stopping.
   Release a held offset only after the caller has safely transferred command ownership. *)
VAR_INPUT
    xStart, xAbort, xPermit : BOOL;
    xResetHeld : BOOL;
    lrDtSec : LREAL;
    lrRadiusDeg : LREAL := 0.05;
    lrLegTimeSec : LREAL := 10.0;
    lrSettleSec : LREAL := 1.0;
END_VAR
VAR_OUTPUT
    xBusy, xDone, xAborted, xFault : BOOL;
    uiState : UINT;
    lrAzBias, lrElBias : LREAL;
    xCollect : BOOL;
END_VAR
VAR
    startOld : BOOL;
    elapsed, leg, settle, side, u, blend : LREAL;
    fromAz, fromEl, toAz, toEl : LREAL;
END_VAR</Single>
            <Single Name="LineInfoPersistence" Type="string">e52b8d23-d02b-44df-b266-cee7e7a5bbad_Decl_LineIds</Single>
          </Single>
        </Single>
        <Single Name="UniqueIdGenerator" Type="string">91</Single>
        <Single Name="POULevel" Type="{8e575c5b-1d37-49c6-941b-5c0ec7874787}">Standard</Single>
        <List Name="ChildObjectGuids" Type="System.Collections.ArrayList" />
        <Single Name="AddAttributeSubsequent" Type="bool">False</Single>
      </Single>
      <Single Name="ParentSVNodeGuid" Type="System.Guid">49085721-e2f3-443d-be92-6caf07f84b13</Single>
      <Array Name="Path" Type="string">
        <Single Type="string">Device</Single>
        <Single Type="string">PLC逻辑</Single>
        <Single Type="string">Application</Single>
      </Array>
      <Single Name="Index" Type="int">-1</Single>
    </Single>
    <Single Type="{6198ad31-4b98-445c-927f-3258a0e82fe3}" Method="IArchivable">
      <Single Name="IsRoot" Type="bool">True</Single>
      <Single Name="MetaObject" Type="{81297157-7ec9-45ce-845e-84cab2b88ade}" Method="IArchivable">
        <Single Name="Guid" Type="System.Guid">bf36a439-16da-45d2-8e62-cc535b7d8364</Single>
        <Single Name="ParentGuid" Type="System.Guid">49085721-e2f3-443d-be92-6caf07f84b13</Single>
        <Single Name="Name" Type="string">PRG_PhaseCalibration</Single>
        <Dictionary Type="{2c41fa04-1834-41c1-816e-303c7aa2c05b}" Name="Properties" />
        <Single Name="TypeGuid" Type="System.Guid">6f9dac99-8de1-4efc-8465-68ac443b7d08</Single>
        <Array Name="EmbeddedTypeGuids" Type="System.Guid">
          <Single Type="System.Guid">a9ed5b7e-75c5-4651-af16-d2c27e98cb94</Single>
          <Single Type="System.Guid">3b83b776-fb25-43b8-99f2-3c507c9143fc</Single>
        </Array>
        <Single Name="Timestamp" Type="long">639246506104130670</Single>
      </Single>
      <Single Name="Object" Type="{6f9dac99-8de1-4efc-8465-68ac443b7d08}" Method="IArchivable">
        <Single Name="SpecialFunc" Type="{0db3d7bb-cde0-4416-9a7b-ce49a0124323}">None</Single>
        <Single Name="Implementation" Type="{3b83b776-fb25-43b8-99f2-3c507c9143fc}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">startPulse:=GVL_PhaseCal.xStart AND NOT startOld;
startOld:=GVL_PhaseCal.xStart;
accepted:=FALSE; sample:=FALSE; newRx:=FALSE;
age:=MIN(age+0.01,999.0);
sampleTime:=MIN(sampleTime+0.01,1.0);
seq:=GVL_PhaseCal.udiRxSeq;
IF seq&lt;&gt;lastSeq AND seq MOD 2=0 THEN
    ua:=GVL_PhaseCal.lrRxUa; ue:=GVL_PhaseCal.lrRxUe;
    eb:=GVL_PhaseCal.lrRxEbN0;
    az:=GVL_PhaseCal.lrRxAz; el:=GVL_PhaseCal.lrRxEl;
    rxLock:=GVL_PhaseCal.xRxLock;
    IF seq=GVL_PhaseCal.udiRxSeq THEN
        lastSeq:=seq; age:=0; newRx:=TRUE;
    END_IF;
END_IF;

ownership:=NOT GVL.bLocalCtrl AND GVL.Axis1Remote.iMode=2 AND
    GVL.Axis2Remote.iMode=2 AND NOT GVL.bStartTrack AND
    NOT GVL.bStartLocalAutoTrack AND NOT Modbus_Slave.bStartTrackAcu AND
    NOT Modbus_Slave.bSearch AND NOT SecurityCheck.bScanRun AND
    ABS(SecurityCheck.aztest)&lt;0.00001 AND ABS(SecurityCheck.eltest)&lt;0.00001;
permit:=ownership AND GVL.Axis1Status.bServo_Enable AND
    GVL.Axis2Status.bServo_Enable AND NOT GVL.Axis1Status.Error AND
    NOT GVL.Axis2Status.Error AND NOT GVL.Axis1Status.ErrorStop AND
    NOT GVL.Axis2Status.ErrorStop AND GVL.eAzErrorcode=0 AND GVL.eElErrorcode=0 AND
    NOT SecurityCheck.bPrelimit_1 AND NOT SecurityCheck.bPrelimit_2 AND
    NOT SecurityCheck.bFinallimit_1 AND NOT SecurityCheck.bFinallimit_2;
IF path.xBusy THEN
    (* Never mask a changed ACU target by holding the old calibration center. *)
    permit:=permit AND ABS(REAL_TO_LREAL(Modbus_Slave.rPosCmd_2)-baseAz)&lt;0.00001 AND
        ABS(REAL_TO_LREAL(Modbus_Slave.rPosCmd_1)-baseEl)&lt;0.00001;
END_IF;
quality:=age&lt;0.3 AND rxLock AND ABS(ua)&lt;4.5 AND ABS(ue)&lt;4.5 AND
    GVL_PhaseCal.uiSerialError=0 AND GVL_PhaseCal.xRxAlignmentConfirmed;
GVL_PhaseCal.xReady:=permit AND quality AND eb&gt;=GVL_PhaseCal.lrMinEbN0 AND
    NOT path.xBusy AND NOT GVL_PhaseCal.xFault AND NOT GVL_PhaseCal.xAbort AND
    ABS(REAL_TO_LREAL(GVL.rFctPosReal_2)-REAL_TO_LREAL(Modbus_Slave.rPosCmd_2))&lt;0.01 AND
    ABS(REAL_TO_LREAL(GVL.rFctPosReal_1)-REAL_TO_LREAL(Modbus_Slave.rPosCmd_1))&lt;0.01 AND
    ABS(REAL_TO_LREAL(Modbus_Slave.rPosCmd_2))&lt;274.8 AND
    Modbus_Slave.rPosCmd_1&gt;93.2 AND Modbus_Slave.rPosCmd_1&lt;179.8;

IF GVL_PhaseCal.xReset AND NOT path.xBusy THEN
    GVL_PhaseCal.xFault:=FALSE; GVL_PhaseCal.uiError:=0;
END_IF;
IF startPulse AND NOT path.xBusy THEN
    GVL_PhaseCal.xDone:=FALSE;
    GVL_PhaseCal.xFitValid:=FALSE; GVL_PhaseCal.xSuggestedValid:=FALSE;
    IF NOT GVL_PhaseCal.xReady OR GVL_PhaseCal.lrCurrentPhaseDeg&lt;0 OR
       GVL_PhaseCal.lrCurrentPhaseDeg&gt;360 OR GVL_PhaseCal.lrMinEbN0&lt;0 OR
       GVL_PhaseCal.lrRadiusDeg&lt;=0 OR GVL_PhaseCal.lrRadiusDeg&gt;0.1 OR
       GVL_PhaseCal.lrLegTimeSec&lt;2 OR GVL_PhaseCal.lrLegTimeSec&gt;60 OR
       GVL_PhaseCal.lrSettleSec&lt;0.1 OR GVL_PhaseCal.lrSettleSec&gt;30 THEN
        GVL_PhaseCal.uiError:=10; GVL_PhaseCal.xFault:=TRUE;
    ELSE
        baseAz:=REAL_TO_LREAL(Modbus_Slave.rPosCmd_2);
        baseEl:=REAL_TO_LREAL(Modbus_Slave.rPosCmd_1);
        centerAz:=-baseAz; centerEl:=baseEl-90;
        phase:=GVL_PhaseCal.lrCurrentPhaseDeg;
        direction:=GVL_PhaseCal.iPhaseDirection; minEb:=GVL_PhaseCal.lrMinEbN0;
        accepted:=TRUE; sampleTime:=0;
        GVL_PhaseCal.uiError:=0; GVL_PhaseCal.xFault:=FALSE;
    END_IF;
END_IF;

abortRun:=GVL_PhaseCal.xAbort;
IF path.xBusy AND path.uiState&lt;&gt;800 AND path.uiState&lt;&gt;900 THEN
    IF NOT quality OR eb&lt;minEb THEN
        abortRun:=TRUE; GVL_PhaseCal.uiError:=20; GVL_PhaseCal.xFault:=TRUE;
    END_IF;
    IF ABS(-REAL_TO_LREAL(GVL.rFctPosReal_2)-centerAz-path.lrAzBias)&gt;0.1 OR
       ABS(REAL_TO_LREAL(GVL.rFctPosReal_1)-90-centerEl-path.lrElBias)&gt;0.1 THEN
        abortRun:=TRUE; GVL_PhaseCal.uiError:=21; GVL_PhaseCal.xFault:=TRUE;
    END_IF;
END_IF;
path(xStart:=accepted, xAbort:=abortRun, xPermit:=permit,
    xResetHeld:=GVL_PhaseCal.xReset AND NOT GVL.Axis1Status.bServo_Enable AND
        NOT GVL.Axis2Status.bServo_Enable,
    lrDtSec:=0.01, lrRadiusDeg:=GVL_PhaseCal.lrRadiusDeg,
    lrLegTimeSec:=GVL_PhaseCal.lrLegTimeSec, lrSettleSec:=GVL_PhaseCal.lrSettleSec);
IF path.xFault THEN
    GVL_PhaseCal.xFault:=TRUE; GVL_PhaseCal.uiError:=22;
END_IF;
IF path.xBusy AND permit AND path.uiState&lt;&gt;900 THEN
    (* Same signs as existing eltest/aztest target offsets. *)
    GVL.Axis1Remote.rPosCmd:=LREAL_TO_REAL(baseEl+path.lrElBias);
    GVL.Axis2Remote.rPosCmd:=LREAL_TO_REAL(baseAz-path.lrAzBias);
END_IF;
IF path.xBusy AND path.xCollect AND quality AND eb&gt;=minEb AND
   newRx AND sampleTime&gt;=0.05 AND NOT GVL_PhaseCal.xFault AND NOT path.xAborted THEN
    sample:=TRUE; sampleTime:=0;
END_IF;
finish:=path.xDone AND NOT doneOld AND NOT GVL_PhaseCal.xFault;
IF finish AND (ABS(-REAL_TO_LREAL(GVL.rFctPosReal_2)-centerAz)&gt;0.01 OR
              ABS(REAL_TO_LREAL(GVL.rFctPosReal_1)-90-centerEl)&gt;0.01) THEN
    finish:=FALSE; GVL_PhaseCal.xFault:=TRUE; GVL_PhaseCal.uiError:=31;
END_IF;
doneOld:=path.xDone;
fit(xReset:=accepted, xSample:=sample, xFinish:=finish,
    lrAz:=az-centerAz, lrEl:=el-centerEl, lrUa:=ua, lrUe:=ue,
    lrCurrentPhaseDeg:=phase, iPhaseDirection:=direction);
IF finish THEN
    GVL_PhaseCal.xDone:=TRUE;
    GVL_PhaseCal.xFitValid:=fit.xFitValid;
    GVL_PhaseCal.xSuggestedValid:=fit.xSuggestedValid;
    IF NOT fit.xFitValid THEN
        GVL_PhaseCal.xFault:=TRUE; GVL_PhaseCal.uiError:=30;
    END_IF;
END_IF;
GVL_PhaseCal.xBusy:=path.xBusy; GVL_PhaseCal.xAborted:=path.xAborted;
GVL_PhaseCal.uiState:=path.uiState; GVL_PhaseCal.uiFitError:=fit.uiError;
GVL_PhaseCal.lrAzBias:=path.lrAzBias; GVL_PhaseCal.lrElBias:=path.lrElBias;
GVL_PhaseCal.lrRxAgeSec:=age; GVL_PhaseCal.udiSamples:=fit.udiSamples;
GVL_PhaseCal.lrResponseAngleDeg:=fit.lrResponseAngleDeg;
GVL_PhaseCal.lrCorrectionDeg:=fit.lrCorrectionDeg;
GVL_PhaseCal.lrSuggestedDeg:=fit.lrSuggestedDeg;
GVL_PhaseCal.lrCandidatePlusDeg:=fit.lrCandidatePlusDeg;
GVL_PhaseCal.lrCandidateMinusDeg:=fit.lrCandidateMinusDeg;
GVL_PhaseCal.lrOrthErrorDeg:=fit.lrOrthErrorDeg;
GVL_PhaseCal.lrResidualAz:=fit.lrResidualAz; GVL_PhaseCal.lrResidualEl:=fit.lrResidualEl;
GVL_PhaseCal.lrKaa:=fit.lrKaa; GVL_PhaseCal.lrKae:=fit.lrKae;
GVL_PhaseCal.lrKea:=fit.lrKea; GVL_PhaseCal.lrKee:=fit.lrKee;</Single>
            <Single Name="LineInfoPersistence" Type="string">bf36a439-16da-45d2-8e62-cc535b7d8364_Impl_LineIds</Single>
          </Single>
        </Single>
        <Single Name="Interface" Type="{a9ed5b7e-75c5-4651-af16-d2c27e98cb94}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">PROGRAM PRG_PhaseCalibration
(* Called ONLY at the end of SecurityCheck, once per Canopen 10 ms cycle.
   Fixed position mode only. No writes to modes, enables, tracking or persistence.
   Loss of ownership gives command control back to the existing program immediately.
   This is not an emergency-stop/safety function. *)
VAR
    path : FB_PhaseTriangle;
    fit : FB_PhaseFit;
    startOld, startPulse, accepted, permit, ownership, quality : BOOL;
    sample, finish, newRx, rxLock, doneOld, abortRun : BOOL;
    seq, lastSeq : UDINT;
    age : LREAL := 999;
    sampleTime : LREAL;
    ua, ue, eb, az, el, centerAz, centerEl : LREAL;
    baseAz, baseEl, phase, minEb : LREAL;
    direction : INT;
END_VAR</Single>
            <Single Name="LineInfoPersistence" Type="string">bf36a439-16da-45d2-8e62-cc535b7d8364_Decl_LineIds</Single>
          </Single>
        </Single>
        <Single Name="UniqueIdGenerator" Type="string">141</Single>
        <Single Name="POULevel" Type="{8e575c5b-1d37-49c6-941b-5c0ec7874787}">Standard</Single>
        <List Name="ChildObjectGuids" Type="System.Collections.ArrayList" />
        <Single Name="AddAttributeSubsequent" Type="bool">False</Single>
      </Single>
      <Single Name="ParentSVNodeGuid" Type="System.Guid">49085721-e2f3-443d-be92-6caf07f84b13</Single>
      <Array Name="Path" Type="string">
        <Single Type="string">Device</Single>
        <Single Type="string">PLC逻辑</Single>
        <Single Type="string">Application</Single>
      </Array>
      <Single Name="Index" Type="int">-1</Single>
    </Single>
  </List2>
  <Null Name="ProfileName" />
</Single>  </StructuredView>
