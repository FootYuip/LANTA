    iconutwait : INT;
    rdelta : REAL := 0.25;         // 螺旋每格边长(°)，4*rdelta=±1°（1°波束）
    rStep : REAL := 12.0;          // 螺旋每格拍数，对齐2.4
    bFinish : BOOL;
